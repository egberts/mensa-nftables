# File:     base-ip-filter-postrouting-srcnat.chain
# Path:     hooks/hook-postrouting/
# Title:    Base chain for the postrouting hook (ip family, filter type) for Source NAT priority
# Family:   ip
# Table:    *
# Chain:    ip_filter_postrouting_srcnat
# Type:     filter
# Hook:     postrouting
# Priority: 105 (srcnat(100)+5, after Libvirt/Docker srcnat(50))
