# File:     base-ip6-filter-postrouting.chain
# Path:     hooks/hook-postrouting/
# Title:    Base chain for the postrouting hook (ip6 family, filter type)
# Family:   ip6
# Table:    *
# Chain:    ip6_filter_postrouting
# Type:     filter
# Hook:     postrouting
# Priority: 300
