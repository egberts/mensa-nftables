# File:     base-ip-filter-prerouting-mangle.chain
# Path:     hooks/hook-prerouting/
# Title:    Base chain for the prerouting hook (ip family, filter type) for MANGLE priority
# Family:   ip
# Table:    *
# Chain:    ip_filter_prerouting_mangle
# Type:     filter
# Hook:     prerouting
# Priority: -155 (mangle (-150) - 5, after inet-mangle(-160), same as ip6-mangle(-155))
# Policy:   accept
# Called by: types/type-filter/filter-ip.nft
# Description:
#   is used for non-inet as pseudo-ingress (ip, ip6, bridge, arp)

    chain ip_filter_prerouting_mangle {
        type filter hook prerouting priority -155;
        policy accept;

    }
