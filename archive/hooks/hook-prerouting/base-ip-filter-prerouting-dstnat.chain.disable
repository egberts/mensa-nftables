# File:     base-ip-filter-prerouting-dstnat.chain
# Path:     hooks/hook-prerouting/
# Title:    Base chain for the prerouting hook (ip family, filter type) at DSTNAT priority
# Family:   ip
# Table:    *
# Chain:    ip_filter_prerouting_dstnat
# Type:     filter
# Hook:     prerouting
# Priority: -105 (dstnat (-100) - 5, after inet-dstnat(-115), same as ip6-dstnat(-105))
# Policy:   accept
# Called by: types/type-filter/filter-ip.nft
# Description:
#

    chain ip_filter_prerouting_dstnat {
        type filter hook prerouting priority -110;
        policy accept;

    }