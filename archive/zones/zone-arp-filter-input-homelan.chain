# File:     zone-arp-filter-input-homelan.chain
# Path:     *
# Title:    Regular chain?
# Family:   arp
# Table:    *
# Chain:    arp_filter_input_homelan
# Type:     filter
# Hook:     input
# Priority: filter(0)
# Policy:   *
# Zone:     homelan
# Called by: hooks/hook-input/base-arp-filter-input.chain
# Description: Stateful inbound host firewall
#
    # Register a DeviceInterface-to-firewall dispatch registry
    map map_dispatch_arp_filter_input_interface {
        typeof iif : verdict
        elements = {
            # use goto, this is the final descendance
            $HOMELAN_INTF_DEV : goto arp_filter_input_homelan,
        }
    }

    # no layer-7 protocol-specific dispatcher needed in ARP family
    chain arp_filter_input_homelan {

        counter comment "arp/filter/input/homelan"
    }

    include "./zones/homelan/arp-filter-input-homelan.chain"  # no wildcard

    chain arp_filter_input_homelan {
        # Log and count denied traffic.
        counter log prefix "DROP arp/filter/input/homelan unknown ARP packet in homelan zone: " drop
    }
