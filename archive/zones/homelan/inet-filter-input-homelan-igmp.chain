# File:     inet-filter-input-homelan-igmp.chain
# Path:     zones/homelan/
# Title:
# Family:   inet
# Table:    *
# Chain:    inet_filter_input_homelan_igmp
# Type:     filter
# Hook:     input
# Priority: filter(0)
# Policy:   DROP
# Zone:     lan
# Called by: zones/zone-inet-filter-input-homelan.chain
# Description:
#

    # Register a protocol-to-firewall dispatch registry
    map map_dispatch_inet_filter_input_homelan_protocol {
        type inet_proto : verdict;
        elements = {
            igmp : goto inet_filter_input_homelan_igmp,
        }
    }

    chain inet_filter_input_homelan_igmp {

        counter

        ip protocol igmp counter accept comment "Accept IGMP"

        counter log prefix "DROP inet/filter/input/homelan/igmp: " drop
    }
