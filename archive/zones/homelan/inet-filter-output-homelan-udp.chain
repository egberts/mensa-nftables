# File:     inet-filter-output-homelan-udp.chain
# Path:     zones/homelan/
# Title:    Rules for ICMP packets in homelan zone with type filter and hook output
# Family:   inet
# Table:    *
# Chain:    inet_filter_output_homelan_udp
# Type:     filter
# Hook:     output
# Priority: filter(0)
# Policy:   DROP
# Zone:     homelan
# Called by: zones/zone-inet-filter-output-homelan.chain
# Description:
#

    # Register a protocol-to-firewall dispatch registry
    map map_dispatch_inet_filter_output_homelan_protocol {
        type inet_proto : verdict;
        elements = {
            udp : goto inet_filter_output_homelan_udp,
        }
    }

    chain inet_filter_output_homelan_udp {

        include "rules/zone-homelan-inet-filter-output-udp/*.rule"

        log prefix "DROP inet/filter/output/homelan/udp: " counter drop comment "Log and drop all remaining packets reaching this chain"
    }
