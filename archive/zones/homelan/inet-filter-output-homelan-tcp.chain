# File:     inet-filter-output-homelan-tcp.chain
# Path:     zones/homelan/
# Title:    Rules for ICMP packets in homelan zone with type filter and hook output
# Family:   inet
# Table:    *
# Chain:    inet_filter_output_homelan_tcp
# Type:     filter
# Hook:     output
# Priority: filter(0)
# Policy:   DROP
# Zone:     homelan
# Called by: zones/zone-inet-filter-output-homelan.chain
# Description:
#

    # Register a protocol-to-firewall dispatch registry
    map map_dispatch_inet_filter_output_homelan_protocol {
        type inet_proto : verdict;
        elements = {
            tcp : goto inet_filter_output_homelan_tcp,
        }
    }

    chain inet_filter_output_homelan_tcp {

        include "rules/zone-homelan-inet-filter-output-tcp/*.rule"

        log prefix "DROP inet/filter/output/homelan/tcp: " counter drop comment "Log and drop all remaining TCP packets reaching this chain"
    }
