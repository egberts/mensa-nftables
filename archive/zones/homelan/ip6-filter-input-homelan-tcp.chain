# File:     ip6-filter-input-homelan-tcp.chain
# Path:     zones/homelan/
# Title:    Regular chain for homelan zone ip6-family TCP packets in input hook
# Family:   ip6
# Table:    *
# Chain:    ip6_filter_input_homelan_tcp
# Type:     filter
# Hook:     input
# Priority: filter(0)
# Policy:   DROP
# Zone:     homelan
# Called by: none
# Description:
#

    # Register a protocol-to-firewall dispatch registry
    map map_dispatch_ip6_filter_input_homelan_protocol {
        type inet_proto : verdict;
        elements = {
            tcp : goto ip6_filter_input_homelan_tcp,
        }
    }

    chain ip6_filter_input_homelan_tcp {

        include "rules/zone-homelan-ip6-filter-input-tcp/*.rule"

        log prefix "DROP ip6/filter/input/homelan/tcp: " counter drop comment "Log and drop all remaining TCP packets reaching this chain"
    }
