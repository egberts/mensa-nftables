# File:     inet-filter-input-homelan-tcp.chain
# Path:     zones/homelan/
# Title:    Regular chain for homelan zone inet-family TCP packets in input hook
# Family:   inet
# Table:    *
# Chain:    inet_filter_input_homelan_tcp
# Type:     filter
# Hook:     input
# Priority: filter(0)
# Policy:   DROP
# Zone:     homelan
# Called by: zones/zone-inet-filter-input-homelan.chain
# Description:
#

    # Register a protocol-to-firewall dispatch registry
    map map_dispatch_inet_filter_input_homelan_protocol {
        type inet_proto : verdict;
        elements = {
            tcp : goto inet_filter_input_homelan_tcp,
        }
    }

    chain inet_filter_input_homelan_tcp {

        include "rules/zone-homelan-inet-filter-input-tcp/*.rule"

        log prefix "DROP inet/filter/input/homelan/tcp: " counter drop comment "Log and drop all remaining TCP packets reaching this chain"
    }
