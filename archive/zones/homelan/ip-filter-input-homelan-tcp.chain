# File:     ip-filter-input-homelan-tcp.chain
# Path:     zones/homelan/
# Title:    Regular chain for homelan zone ip-family TCP packets in input hook
# Family:   ip
# Table:    *
# Chain:    ip_filter_input_homelan_tcp
# Type:     filter
# Hook:     input
# Priority: filter(0)
# Policy:   DROP
# Zone:     homelan
# Called by: zones/zone-ip-filter-input-homelan.chain
# Description:
#

    # Register a protocol-to-firewall dispatch registry
    map map_dispatch_ip_filter_input_homelan_protocol {
        type inet_proto : verdict;
        elements = {
            tcp : goto ip_filter_input_homelan_tcp,
        }
    }

    chain ip_filter_input_homelan_tcp {

        include "rules/zone-homelan-ip-filter-input-tcp*"        directory wildcard

        log prefix "DROP ip/filter/input/homelan/tcp " counter drop
    }
