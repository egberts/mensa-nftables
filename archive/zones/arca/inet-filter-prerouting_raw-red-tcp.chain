# File:     inet-filter-prerouting_raw-red-tcp.chain
# Path:     zones/red/
# Title:    Regular chain for red zone inet-family TCP packets in prerouting hook at raw-10 priority
# Family:   inet
# Table:    *
# Chain:    inet_filter_prerouting_raw_red_tcp
# Type:     filter
# Hook:     prerouting
# Priority: raw(-300) - 10
# Policy:   accept
# Zone:     red
# Called by: zones/zone-inet-filter-prerouting_raw-red.chain
# Description:
#

    # Register a protocol-to-firewall dispatch registry
    map map_dispatch_inet_filter_prerouting_raw_red_protocol {
        type inet_proto : verdict;
        elements = {
            tcp : goto inet_filter_prerouting_raw_red_tcp,
        }
    }

    chain inet_filter_prerouting_raw_red_tcp {

        include "rules/zone-red-inet-filter-prerouting_raw-tcp/*.rule"

        log prefix "DROP inet/filter/prerouting_raw/red/tcp: " counter drop comment "Log and drop all remaining TCP packets reaching this chain"
}

