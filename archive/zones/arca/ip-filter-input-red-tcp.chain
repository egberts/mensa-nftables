# File:     ip-filter-input-red-tcp.chain
# Path:     zones/red/
# Title:    Regular chain for red zone ip-family TCP packets in input hook
# Family:   ip
# Table:    *
# Chain:    ip_filter_input_red_tcp
# Type:     filter
# Hook:     input
# Priority: filter(0)
# Policy:   DROP
# Zone:     red
# Called by: zones/zone-ip-filter-input-red.chain
# Description:
#

    # Register a protocol-to-firewall dispatch registry
    map map_dispatch_ip_filter_input_red_protocol {
        type inet_proto : verdict;
        elements = {
            tcp : goto ip_filter_input_red_tcp,
        }
    }

    chain ip_filter_input_red_tcp {

        include "rules/zone-red-ip-filter-input-tcp*"        directory wildcard

        log prefix "DROP ip/filter/input/red/tcp " counter drop
    }
