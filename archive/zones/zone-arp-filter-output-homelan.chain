# File:     zone-arp-filter-output-homelan.chain
# Path:     *
# Title:    Regular chain?
# Family:   arp
# Table:    *
# Chain:    arp_filter_output_homelan
# Type:     filter
# Hook:     output
# Priority: filter(0)+10
# Policy:   *
# Zone:     homelan
# Called by: hooks/hook-output/base-arp-filter-output.chain
# Description: Stateful inbound host firewall
#

    # Register a DeviceInterface-to-firewall dispatch registry
    map map_dispatch_arp_filter_output_interface {
        typeof oif : verdict
        elements = {
            # use goto, this is the final descendance
            $HOMELAN_INTF_DEV : goto arp_filter_output_homelan,
        }
    }

    # no layer-7 protocol-specific dispatcher needed in ARP family
    chain arp_filter_output_homelan {

        counter comment "arp/filter/output/homelan"
    }

    include "./zones/homelan/arp-filter-output-homelan.chain"  # no wildcard

    chain arp_filter_output_homelan {

        # Log and count denied traffic.
        counter log prefix "DROP arp/filter/output/homelan unknown ARP in homelan zone: " drop
    }
