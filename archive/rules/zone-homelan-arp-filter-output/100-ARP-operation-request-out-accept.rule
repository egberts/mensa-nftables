#
# File: 100-ARP-operation-request-out-accept.rule
# Policy: Allow local ARP client operation request to remote ARP server
# Called by: zones/red/arp-filter-output-red.chain
#

arp operation 1 arp ptype 0x0800 arp saddr ip { $WAN_INTF_ADDR, $GATEWAY_ROUTE_DEFAULT } counter accept comment "local-to-remote ARP opcode request"

