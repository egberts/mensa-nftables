#
# File: 100-ARP-operation-req-out-accept.rule
# Policy: Allow local ARP client operation request to remote ARP server
# Called by: zones/loopback/arp-filter-output-loopback.chain

arp operation 1 arp ptype 0x0800 arp daddr ip { $WAN_INTF_ADDR, $GATEWAY_ROUTE_DEFAULT } counter accept comment "local-to-remote ARP request"

