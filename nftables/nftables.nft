#!/usr/sbin/nft -f   
## ignored if included directly by 'nft -f'
# File: nftables.nft
# Title: Rules for all packets in all zones with all types and all hooks
# Description:
#   A multi-config file approach for a complete default deny firewall using
#   nftables.  Covers all:
#     * zone names
#     * base chain types and 
#     * all base chain hooks.
#

# site-specific settings, contains 'nft defines'
include "/etc/nftables/nft-common.nft"

# chain types
add table inet filter
add table netdev filter  # for ingress chain types
include "./filter/arp/*.nft"
include "./filter/bridge/*.nft"
include "./filter/ip/*.nft"
include "./filter/inet/*.nft"
include "./filter/ip6/*.nft"
include "./filter/netdev/*.nft"

# Libvirt support
include "./nft-libvirt.nft"
