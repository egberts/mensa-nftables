#!/usr/bin/env nft -f
#
# File:        bridge-filter-forward.nft
# Path:        /etc/nftables/bridge
# Description:
#
# Family: bridge
# Table: bridge_filter
# Chain: bridge_filter_forward
# Type:  filter
# Hook:  forward
# Priority: filter(-200)
# Policy: DROP
#

table bridge bridge_filter {
    chain bridge_filter_forward {
        type filter hook forward priority filter; policy drop

        counter

        log prefix "DROP bridge-filter-forward: " limit rate 5/second
    }
}