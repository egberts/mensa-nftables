#!/usr/bin/env nft -f
#
# File:        bridge-filter-input.nft
# Path:        /etc/nftables/bridge
# Description:
#
# Family: bridge
# Table: bridge_filter
# Chain: bridge_filter_input
# Type:  filter
# Hook:  input
# Priority: filter(-200)
# Policy: DROP
#

table bridge bridge_filter {
    chain bridge_filter_input {
        type filter hook input priority filter; policy drop

        counter

        log prefix "DROP bridge-filter-input: " limit rate 5/second
    }
}