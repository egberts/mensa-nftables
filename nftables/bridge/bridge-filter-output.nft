#!/usr/bin/env nft -f
#
# File:        bridge-filter-output.nft
# Path:        /etc/nftables/bridge
# Description:
#
# Family: bridge
# Table: bridge_filter
# Chain: bridge_filter_output
# Type:  filter
# Hook:  output
# Priority: filter(-200)
# Policy: DROP
#

table bridge bridge_filter {
    chain bridge_filter_output {
        type filter hook output priority filter; policy drop

        counter

        log prefix "DROP bridge-filter-output: " limit rate 5/second
    }
}