#!/usr/bin/env nft -f
#
# File:        ip6-nat-postrouting.nft
# Path:        /etc/nftables/ip6
# Description:
#
# Family: ip6
# Table: ip6_nat
# Chain: ip6_nat_postrouting
# Type:  nat
# Hook:  postrouting
# Priority: srcnat(100)
# Policy: DROP
#

table ip6 ip6_nat {
    chain ip6_nat_postrouting {

        type nat hook postrouting priority srcnat;
        policy drop

        counter
        log prefix "DROP ip6-nat-postrouting " limit rate 5/second
    }
}