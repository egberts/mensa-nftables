#!/usr/bin/env nft -f
#
# File:        ip6-filter-postrouting.nft
# Path:        /etc/nftables/ip6
# Description:
#
# Family: ip6
# Table: ip6_filter
# Chain: ip6_filter_postrouting
# Type:  filter
# Hook:  postrouting
# Priority: filter(0)
# Policy: DROP
#

table ip6 ip6_filter {
    chain ip6_filter_postrouting {

        type filter hook postrouting priority filter;
        policy accept

        counter
        log prefix "DROP ip6-filter-postrouting " limit rate 5/second
    }
}