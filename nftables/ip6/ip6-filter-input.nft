#!/usr/bin/env nft -f
#
# File:        ip6-filter-input.nft
# Path:        /etc/nftables/ip6
# Description:
#
# Family: ip6
# Table: ip6_filter
# Chain: ip6_filter_input
# Type:  filter
# Hook:  input
# Priority: filter(0)
# Policy: DROP
#

table ip6 ip6_filter {
    chain ip6_filter_input {

        type filter hook input priority filter;
        policy accept

        counter
        log prefix "DROP ip6-filter-input " limit rate 5/second
    }
}
