#!/usr/bin/env nft -f
#
# File:        inet-filter-output.nft
# Path:        /etc/nftables/inet
# Description:
#
# Family: inet
# Table: inet_filter
# Chain: inet_filter_output
# Type:  filter
# Hook:  output
# Priority: filter(0)
# Policy: DROP
#

table inet inet_filter {
    chain inet_filter_output {

        type filter hook output priority filter;
        policy accept

        counter
        log prefix "DROP inet-filter-output " limit rate 5/second
    }
}