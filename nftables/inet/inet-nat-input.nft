#!/usr/bin/env nft -f
#
# File:        inet-nat-input.nft
# Path:        /etc/nftables/inet
# Description:
#
# Family: inet
# Table: inet_nat
# Chain: inet_nat_input
# Type:  nat
# Hook:  input
# Priority: srcnat(100)
# Policy: DROP
#

table inet inet_nat {
    chain inet_nat_input {

        type nat hook input priority srcnat;
        policy drop

        counter
        log prefix "DROP inet-nat-input " limit rate 5/second
    }
}