#!/usr/bin/env nft -f
#
# File:        inet-filter-input.nft
# Path:        /etc/nftables/inet
# Description:
#
# Family: inet
# Table: inet_filter
# Chain: inet_filter_input
# Type:  filter
# Hook:  input
# Priority: filter(0)
# Policy: DROP
#

table inet inet_filter {
    chain inet_filter_input {

        type filter hook input priority filter;
        policy accept

        counter
        log prefix "DROP inet-filter-input " limit rate 5/second
    }
}
