# File:     arp-filter-input-red.chain
# Path:     zones/red/
# Title:    Regular chain for red zone arp-family TCP packets in input hook
# Family:   arp
# Table:    *
# Chain:    arp_filter_input_red_tcp
# Type:     filter
# Hook:     input
# Priority: filter(0)
# Policy:   DROP
# Zone:     red
# Called by: zones/zone-arp-filter-input-red.chain
# Description:
#

    # no layer-7 protocol-specific dispatcher needed in ARP family  g
    chain arp_filter_input_ZONE {

        counter comment "arp/filter/input/ZONE"


        include "zones/ZONE/rules/arp-filter-input/*.rule"

        # Log and count denied traffic.
        counter log prefix "DROP arp/filter/input/ZONE unknown packet in ZONE zone: "
    }

