# File:     base-arp-filter-input.base_chain
# Path:     hooks/hook-input/
# Title:    Base chain for the input hook (arp family, filter type)
# Family:   arp
# Table:    *
# Chain:    arp_filter_input
# Type:     filter
# Hook:     input
# Priority: -10 (over Libvirt/Docker filter(0) and ip/ip6 filter-1)
# Policy:   DROP
# Called by: types/filter-arp.table
# Description:
#
# Since 'device' attribute isn't available in base_chain
# arp family, we declare the base chain here.
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

    # Pre-declare table before map/vmap
    chain arp_filter_input {
        type filter hook input priority -10; policy drop;
        counter comment "inbound arp/filter/input"
    }

    # creates a registry for zone-based dispatcher (will touch arp_filter_input)
    #include "bindings/zones/zones-arp-filter-input*.table_block"

    # Declare an interface-to-chain dispatcher for input hook, arp family, filter chain-type. (will touch arp_filter_input)
    include "bindings/devices/devices-arp-filter-input*.table_block"


    chain arp_filter_input {
        counter comment "inbound arp/filter/input"
        # TODO Add 'limit 5/s' here
        log prefix "DROP arp/filter/input unknown ZONE: " drop
    }
