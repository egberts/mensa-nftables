# File:     base-inet-route-input.chain
# Path:     2-hooks/hook-input/
# Title:    Base chain for the input hook (inet family, route type)
# Family:   inet
# Table:    *
# Chain:    inet_route_input
# Type:     route
# Hook:     input
# Priority: -10 (filter(0) - 10, before ip-input(-5) and ip6-input(-5))
# Policy:   accept
# Called by: 1-types/route-inet.table
# Description:
#

    # Declare an interface-to-chain dispatcher for input hook
    map map_dispatch_inet_route_input_interface {
        typeof iif : verdict
    }
    chain inet_route_input {
        type route hook input priority -10; policy accept;

        # dispatch map built by including/excluding chain-inet-route-*.nft files
        iif vmap @map_dispatch_inet_route_input_interface
    }

    # registers with 'map_dispatch_inet_route_input_interface' dispatch mapper)
    include "./zones/zone-inet-route-input-*.chain";

    # Post-interface input process
    chain inet_route_input {
        counter log prefix "DROP inet/route/input: " drop comment "unidentified interface route input"
    }
