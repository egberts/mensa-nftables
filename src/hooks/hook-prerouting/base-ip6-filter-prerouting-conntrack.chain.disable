# File:     base-ip6-filter-prerouting-conntrack.chain
# Path:     hooks/hook-prerouting/
# Title:    Base chain for the prerouting hook (ip6 family, filter type) at ConnTrack priority
# Family:   ip6
# Table:    *
# Chain:    ip6_filter_prerouting_conntrack
# Type:     filter
# Hook:     prerouting
# Priority: -205 (conntrack (-200) - 5) (after inet(-210), same as ip(-205))
# Policy:   accept
# Called by: types/filter-ip6.table
# Description:
#

    chain ip6_filter_prerouting_conntrack {
        type filter hook prerouting priority -205;
        policy accept;

    }
