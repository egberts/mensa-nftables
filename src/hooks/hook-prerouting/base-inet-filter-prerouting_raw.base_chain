# File:     base-inet-filter-prerouting-raw.base_chain
# Path:     hooks/hook-prerouting/
# Title:    Base chain for the prerouting hook (inet family, filter type)
# Family:   inet
# Type:     filter
# Hook:     prerouting
# Priority: -310 (raw(-300) - 10)
# Policy:   accept
# Table:    *
# Chain:    inet_filter_prerouting
# Called by: types/filter-inet.table
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

    # Pre-declare table before map/vmap
    chain inet_filter_prerouting_raw {
        type filter hook prerouting priority -310; policy accept;

        counter comment "inbound inet/filter/prerouting"
    }

    # creates a registry for zone-based dispatcher (will touch inet_filter_prerouting)
    #include "bindings/zones/zones-inet-filter-prerouting*.table_block"

    # Declare an interface-to-chain dispatcher for prerouting hook, inet family, filter chain-type. (will touch inet_filter_prerouting)
    include "bindings/devices/devices-inet-filter-prerouting-raw*.table_block"

    chain inet_filter_prerouting_raw {

        counter comment "inbound inet/filter/prerouting"
    }

