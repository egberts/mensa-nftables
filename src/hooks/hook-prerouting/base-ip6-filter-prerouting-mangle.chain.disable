# File:     base-ip6-filter-prerouting-mangle.chain
# Path:     hooks/hook-prerouting/
# Title:    Base chain for the prerouting hook (ip6 family, filter type) at MANGLE priority
# Family:   ip6
# Table:    *
# Chain:    ip6_filter_prerouting_mangle
# Type:     filter
# Hook:     prerouting
# Priority: -155 (mangle (-150) - 5, after inet-mangle(-160), same as ip-mangle(-155))
# Policy:   accept
# Called by: types/filter-ip6.table
# Description:
#   is used for non-inet as pseudo-ingress (ip, ip6, bridge, arp)

    chain ip6_filter_prerouting_mangle {
        type filter hook prerouting priority -155;
        policy accept;

    }
