# File:     base-ip-filter-prerouting-dstnat.base_chain
# Path:     hooks/hook-prerouting/
# Title:    Base chain for the prerouting hook (ip family, filter type)
# Family:   ip
# Type:     filter
# Hook:     prerouting
# Priority: -110 (dstnat (-100) - 10, before ip-dstnat(-105) and ip6-dstnat(-105))
# Policy:   accept
# Table:    *
# Chain:    ip_filter_prerouting
# Called by: types/filter-ip.table
# Description:
#
#    Destination NAT / port-forwarding / redirect.
#      - dnat to <addr>[:port] • redirect to :<port>
#      - Matches on iif/iifname, tcp dport, udp dport,
#            ip saddr/daddr, ip6 saddr/daddr, 
#            ct state new, etc.
#      - Priority is almost always dstnat (−100).
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

    # Pre-declare table before map/vmap
    chain ip_filter_prerouting_dstnat {
        type filter hook prerouting priority -110; policy accept;

        counter comment "inbound ip/filter/prerouting_dstnat"
    }

    # creates a registry for zone-based dispatcher (will touch ip_filter_prerouting)
    #include "bindings/zones/zones-ip-filter-prerouting*.table_block"

    # Declare an interface-to-chain dispatcher for prerouting hook, ip family, filter chain-type. (will touch ip_filter_prerouting)
    include "bindings/devices/devices-ip-filter-prerouting-dstnat*.table_block"

    chain ip_filter_prerouting_dstnat {

        counter comment "inbound ip/filter/prerouting_dstnat"
    }

