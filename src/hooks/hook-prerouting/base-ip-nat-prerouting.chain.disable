# File:     base-ip-nat-prerouting.chain
# Path:     2-hooks/hook-prerouting/
# Title:    Base chain for the prerouting hook (ip family, nat type)
# Family:   ip
# Table:    *
# Chain:    ip_nat_prerouting_*
# Type:     nat
# Hook:     prerouting
# Priority: various
# Policy:   accept
# Called by: 1-types/nat-ip.table
# Description:
#

    chain ip_nat_prerouting_dstnat {
        type nat hook prerouting priority -100;
        policy accept;

    }

    chain ip_nat_prerouting_mangle {
        type nat hook prerouting priority -150;
        policy accept;

    }

    # cannot use priority less than -300
