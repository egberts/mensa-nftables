# File:     base-ip6-route-output.chain
# Path:     2-hooks/hook-output/
# Title:    Base chain for the output hook (ip6 family, route type)
# Family:   ip6
# Table:    *
# Chain:    ip6_route_output
# Type:     route
# Hook:     output
# Priority: 5 (filter(0)+5, over Libvirt/Docker filter(0))
# Policy:   ACCEPT
# Called by: 1-types/route-ip6.table
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

    # Declare an interface-to-chain dispatcher for output hook
    map map_dispatch_ip6_route_output_interface {
        typeof oif : verdict
    }
    chain ip6_route_output {
        type route hook output priority 5; policy accept;

        counter

        # dispatch map built by including/excluding chain-ip6-route-*.nft files
        oif vmap @map_dispatch_ip6_route_output_interface
    }

    # registers with 'map_dispatch_ip6_route_output_interface' dispatch mapper)
    include "./zones/zone-ip6-route-output-*.chain";

    # Post-interface output process
    chain ip6_route_output {
        counter
    }
