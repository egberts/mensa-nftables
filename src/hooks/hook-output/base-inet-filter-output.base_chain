# File:     base-inet-filter-output.base_chain
# Path:     hooks/hook-output/
# Title:    Base chain for the output hook (inet family, filter type)
# Family:   inet
# Table:    inet_filter
# Chain:    inet_filter_output
# Type:     filter
# Hook:     output
# Priority: 10 (filter(0)+10)
# Policy:   DROP
# Called by: types/filter-inet.table
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

    # Pre-declare table before map/vmap
    chain inet_filter_output {
        type filter hook output priority 110; policy drop;
        counter comment "inbound inet/filter/output"
    }

    # creates a registry for zone-based dispatcher (will touch inet_filter_output)
    #include "bindings/zones/zones-inet-filter-output*.table_block"

    # Declare an interface-to-chain dispatcher for output hook, inet family, filter chain-type. (will touch inet_filter_output)
    include "bindings/devices/devices-inet-filter-output*.table_block"


    chain inet_filter_output {
        counter comment "inbound inet/filter/output"
        # TODO Add 'limit 5/s' here
        log prefix "DROP inet/filter/output unknown ZONE: " drop
    }
