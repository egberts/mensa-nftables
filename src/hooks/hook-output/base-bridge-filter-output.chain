# File:     base-bridge-filter-output.chain
# Path:     2-hooks/hook-output/
# Title:    Base chain for the output hook (bridge family, filter type)
# Family:   bridge
# Table:    *
# Chain:    bridge_filter_output
# Type:     filter
# Hook:     output
# Priority: 110 (out(100) + 10)
# Policy:   DROP
# Called by: 1-types/filter-bridge.table
# Description:
#

    # Declare an interface-to-chain dispatcher for output hook
    map map_dispatch_bridge_filter_output_interface {
        typeof oif : verdict
    }
    chain bridge_filter_output {
        type filter hook output priority 110; policy drop;

        # dispatch map built by including/excluding chain-bridge-filter-*.nft files
        oif vmap @map_dispatch_bridge_filter_output_interface
    }

    include "./zones/zone-bridge-filter-output-*.chain";

    # Post-interface output process
    chain bridge_filter_output {
        counter log prefix "DROP bridge/filter/output: " drop comment "unidentified interface filter output"
    }
