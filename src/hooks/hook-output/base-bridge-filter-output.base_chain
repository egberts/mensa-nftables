# File:     base-bridge-filter-output.base_chain
# Path:     hooks/hook-output/
# Title:    Base chain for the output hook (bridge family, filter type)
# Family:   bridge
# Table:    *
# Chain:    bridge_filter_output
# Type:     filter
# Hook:     output
# Priority: 110 (output(100)+10)
# Policy:   DROP
# Called by: types/filter-bridge.table
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

    # Pre-declare table before map/vmap
    chain bridge_filter_output {
        type filter hook output priority 110; policy drop;
        counter comment "inbound bridge/filter/output"
    }

    # creates a registry for zone-based dispatcher (will touch bridge_filter_output)
    #include "bindings/zones/zones-bridge-filter-output*.table_block"

    # Declare an interface-to-chain dispatcher for output hook, bridge family, filter chain-type. (will touch bridge_filter_output)
    include "bindings/devices/devices-bridge-filter-output*.table_block"


    chain bridge_filter_output {
        counter comment "inbound bridge/filter/output"
        # TODO Add 'limit 5/s' here
        log prefix "DROP bridge/filter/output unknown ZONE: " drop
    }
