# File:     base-inet-route-output.base_chain
# Path:     hooks/hook-output/
# Title:    Base chain for the output hook (inet family, route type)
# Family:   inet
# Type:     route
# Hook:     output
# Priority: +10 (over Libvirt/Docker filter(0) and ip/ip6 filter-1)
# Policy:   accept
# Table:    *
# Chain:    inet_route_output
# Called by: types/filter-inet.table
# Description:
#
# Since 'device' attribute isn't available in base_chain
# inet family, we declare the base chain here.
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#
    # Pre-declare table before map/vmap
    chain inet_route_output {
        type route hook output priority 10; policy accept;
        counter comment "outbound inet/route/output"
    }

    # creates a registry for zone-based dispatcher (will touch inet_route_output)
    #include "bindings/zones/zones-inet-route-output*.table_block"

    # Declare an interface-to-chain dispatcher for output hook, inet family, route chain-type. (will touch inet_route_output)
    include "bindings/devices/devices-inet-route-output*.table_block"


    chain inet_route_output {
        counter comment "outbound inet/route/output"
        # TODO Add 'limit 5/s' here
        log prefix "DROP inet/route/output unknown ZONE: " drop
    }
