# File:     base-inet-nat-output.base_chain
# Path:     hooks/hook-output/
# Title:    Base chain for the output hook (inet family, nat type)
# Family:   inet
# Table:    inet_nat
# Chain:    inet_nat_output
# Type:     nat
# Hook:     output
# Priority: 10 (filter(0)+10)
# Policy:   DROP
# Called by: types/nat-inet.table
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

    # Pre-declare table before map/vmap
    chain inet_nat_output {
        type nat hook output priority 10; policy drop;
        counter comment "inbound inet/nat/output"
    }

    # creates a registry for zone-based dispatcher (will touch inet_nat_output)
    #include "bindings/zones/zones-inet-nat-output*.table_block"

    # Declare an interface-to-chain dispatcher for output hook, inet family, nat chain-type. (will touch inet_nat_output)
    include "bindings/devices/devices-inet-nat-output*.table_block"


    chain inet_nat_output {
        counter comment "inbound inet/nat/output"
        # TODO Add 'limit 5/s' here
        log prefix "DROP inet/nat/output unknown ZONE: " drop
    }
