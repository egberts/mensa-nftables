# File:     base-ip-route-output.base_chain
# Path:     hooks/hook-output/
# Title:    Base chain for the output hook (ip family, route type)
# Family:   ip
# Type:     route
# Hook:     output
# Priority: -10 (over Libvirt/Docker filter(0) and ip/ip6 filter-1)
# Policy:   accept
# Table:    ip_route
# Chain:    ip_route_output
# Called by: types/filter-ip.table
# Description:
#
# Since 'device' attribute isn't available in base_chain
# ip family, we declare the base chain here.
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

    # Pre-declare table before map/vmap
    chain ip_route_output {
        type route hook output priority -10; policy accept;
        counter comment "outbound ip/route/output"
    }

    # creates a registry for zone-based dispatcher (will touch ip_route_output)
    #include "bindings/zones/zones-ip-route-output*.table_block"

    # Declare an interface-to-chain dispatcher for output hook, ip family, route chain-type. (will touch ip_route_output)
    include "bindings/devices/devices-ip-route-output*.table_block"


    chain ip_route_output {
        counter comment "outbound ip/route/output"
    }
