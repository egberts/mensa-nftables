# File:     base-ip6-route-postrouting.chain
# Path:     hooks/hook-postrouting/
# Title:    Base chain for the postrouting hook (ip family, route type)
# Family:   ip6
# Table:    *
# Chain:    ip6_route_postrouting_security
# Type:     route
# Hook:     postrouting
# Priority: various
# Policy: accept
# Called by: types/route-ip6.table
# Description:
#

    chain ip6_route_postrouting {
        type nat hook postrouting priority -100;
        policy accept;

    }
