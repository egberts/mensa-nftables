# File:     base-bridge-filter-postrouting.base_chain
# Path:     hooks/hook-postrouting/
# Title:    Base chain for the postrouting hook (bridge family, filter type)
# Family:   bridge
# Table:    *
# Chain:    bridge_filter_postrouting
# Type:     filter
# Hook:     postrouting
# Priority: +310 (srcnat(+300) - 10)
# Policy:   DROP
# Called by: types/filter-bridge.table
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

    # Pre-declare table before map/vmap
    chain bridge_filter_postrouting {
        type filter hook postrouting priority 310; policy drop;
        counter comment "inbound bridge/filter/postrouting"
    }

    # creates a registry for zone-based dispatcher (will touch bridge_filter_postrouting)
    #include "bindings/zones/zones-bridge-filter-postrouting*.table_block"

    # Declare an interface-to-chain dispatcher for postrouting hook, bridge family, filter chain-type. (will touch bridge_filter_postrouting)
    include "bindings/devices/devices-bridge-filter-postrouting*.table_block"


    chain bridge_filter_postrouting {
        counter comment "inbound bridge/filter/postrouting"
        # TODO Add 'limit 5/s' here
        log prefix "DROP bridge/filter/postrouting unknown ZONE: " drop
    }
