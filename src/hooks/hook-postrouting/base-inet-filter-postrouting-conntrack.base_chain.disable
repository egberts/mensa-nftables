# File:     base-inet-filter-postrouting-conntrack.chain
# Path:     hooks/hook-postrouting/
# Title:    Base chain for the postrouting hook (inet family, filter type) for ConnTrack
# Family:   inet
# Table:    *
# Chain:    inet_filter_postrouting_conntrack
# Type:     filter
# Hook:     postrouting
# Priority: 300
# Policy:   accept
# Called by: types/filter-inet.table
# Description:
#

    chain inet_filter_postrouting_conntrack {
        type filter hook postrouting priority 300;
        policy accept;

    }
