# File:     base-inet-filter-forward.chain
# Path:     hooks/hook-forward/
# Title:    Scan all zones for inet-filter-forward chains
# Family:   inet
# Type:     filter
# Hook:     forward
# Table:    *
# Chain:    inet_filter_forward
# Priority: -3 (filter(0)-3, before ip-forward(-1))
# Policy:   DROP
# Called by: types/filter-inet.table
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

    # Declare an interface-to-chain dispatcher for forward hook
    map map_dispatch_inet_filter_forward_interface {
        typeof iif : verdict
    }
    chain inet_filter_forward {
        type filter hook forward priority -3; policy drop;

        # Reject invalid connection states.
        ct state invalid counter drop
    }

    # Selectively load our protocol regular chains
    # registers with 'map_dispatch_inet_filter_forward' dispatch mapper)
    include "./inet-filter-forward-*.chain";

    chain inet_filter_forward {
        # A cool lookup to jump into a protocol-specific regular chain
        # dispatch map built by including/excluding chain-inet-filter-*.nft files
        iif vmap @map_dispatch_inet_filter_forward_interface

        counter log prefix "DROP inet/filter/forward: " drop comment "unidentified interface filter forward"
    }
