# File:     base-ip6-filter-forward.chain
# Path:     hooks/hook-forward/
# Title:    Base chain for the forward hook (ip6 family, filter type)
# Family:   ip6
# Table:    *
# Chain:    ip6_filter_forward
# Type:     filter
# Hook:     forward
# Priority: -10 (filter(0)-10, before Libvirt/Docker forward/filter(0))
# Policy:   DROP
# Called by: types/filter-ip6.table
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

    # Declare an interface-to-chain dispatcher for forward hook
    map map_dispatch_ip6_filter_forward_interface {
        typeof iif : verdict
    }
    chain ip6_filter_forward {
        type filter hook forward priority -10; policy drop;
        counter
    }

    # Selectively load our protocol regular chains
    # registers with 'map_dispatch_ip6_filter_forward' dispatch mapper)
    include "zones/*/zone-ip6-filter-forward.chain";

    chain ip6_filter_forward {
        # A cool lookup to jump into a protocol-specific regular chain
        # dispatch map built by including/excluding chain-ip6-filter-*.nft files
        iif vmap @map_dispatch_ip6_filter_forward_interface

        counter log prefix "DROP ip6/filter/forward: " drop comment "unidentified interface filter forward"
    }

