# File:     base-bridge-filter-forward.chain
# Path:     hooks/hook-forward/
# Title:    Scan all zones for bridge-filter-forward chains
# Family:   bridge
# Table:    *
# Chain:    bridge_filter_forward
# Type:     filter
# Hook:     forward
# Priority: -10 (filter(0) - 10, before ip-forward(-5) and ip6-forward(-5))
# Policy:   DROP
# Called by: types/filter-bridge.table
# Description:
#

    # Declare an interface-to-chain dispatcher for forward hook
    map map_dispatch_bridge_filter_forward_interface {
        typeof iif : verdict
    }
    chain bridge_filter_forward {
        type filter hook forward priority -10; policy drop;

        iif vmap @map_dispatch_bridge_filter_forward_interface
    }

    # Selectively load our forward protocol regular chains
    # registers with 'map_dispatch_bridge_filter_forward_interface' dispatch mapper)
    include "zones/*/bridge-filter-forward.chain"  # wildcard is in zone name

    # Post-interface forward process
    chain bridge_filter_forward {
        counter log prefix "DROP bridge/filter/forward: " drop comment "unidentified interface filter forward"
    }
