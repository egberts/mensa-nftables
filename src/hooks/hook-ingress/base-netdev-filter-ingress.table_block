# File:     base-netdev-filter-ingress.table_block
# Path:     hooks/hook-ingress/
# Title:    ALL ingress hooks for netdev family and filter chain-type
# Family:   netdev
# Table:    filter_netdev
# Chain:    *
# Type:     filter
# Hook:     ingress
# Priority: *
# Policy:   *
# Called by: types/filter-ingress.table
# Description:
#     Scanning across all zones, picking up ingress/egress chain candidates
#
# The device name must identify an existing network interface.
#
# Requires Linux kernel 5.16 or later for netdev egress.
#
# No table here yet, (still have 'ingress' and 'egress' to go)
# No base chain here yet, that's zone-specific (by chain 'device' interface)
#

    # no declarative base chain here, chain devices are used in 'ingress' and done later

    # zone-in-device is done via 'devices/DEVICE/' subdirectories under this 3-bindings/zones/ZONE/
    include "3-bindings/devices/*/binding-device-netdev-filter-ingress.base_chain"  # wildcard is in device name

    # zones-in-zone are done via 'zones/ZONE/' subdirectories again under this 3-bindings/zones/ZONE/
    # include "3-bindings/zones/*/binding-zone-netdev-filter-ingress.chain"  # wildcard is in zone name

    # elsewhere,
    # devices-in-zone are done via 'zones/ZONE/' subdirectories under 3-bindings/devices/DEVICE/
