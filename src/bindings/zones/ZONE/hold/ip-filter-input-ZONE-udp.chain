# File:     ip-filter-input-red-udp.chain
# Path:     zones/red/
# Title:
# Family:   ip
# Table:    *
# Chain:    ip_filter_input_red_udp
# Type:     filter
# Hook:     input
# Priority: filter(0)
# Policy:   DROP
# Zone:     red
# Called by: zones/zone-ip-filter-input-red.chain
# Description:
#

    # Register a protocol-to-firewall dispatch registry
    map map_dispatch_ip_filter_input_red_protocol {
        type inet_proto : verdict;
        elements = {
            udp : goto ip_filter_input_red_udp,
        }
    }

    chain ip_filter_input_red_udp {

        include "rules/zone-red-ip-filter-input-udp/*.rule"

        log prefix "DROP ip/filter/input/red/tcp " counter drop
    }
