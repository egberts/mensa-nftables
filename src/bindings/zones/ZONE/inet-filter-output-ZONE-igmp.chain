# File:     inet-filter-output-red-igmp.chain
# Path:     zones/red/
# Title:
# Family:   inet
# Table:    *
# Chain:    inet_filter_output_red_igmp
# Type:     filter
# Hook:     output
# Priority: filter(0)
# Policy:   DROP
# Zone:     lan
# Called by: zones/zone-inet-filter-output-red.chain
# Description:
#

    # Register a protocol-to-firewall dispatch registry
    map map_dispatch_inet_filter_output_red_protocol {
        type inet_proto : verdict;
        elements = {
            igmp : goto inet_filter_output_red_igmp,
        }
    }

    chain inet_filter_output_red_igmp {

        counter

        ip protocol igmp counter accept comment "Accept IGMP"

        counter log prefix "DROP inet/filter/output/red/igmp: " drop
    }
