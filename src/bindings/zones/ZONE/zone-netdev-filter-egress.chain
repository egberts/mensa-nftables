# File:     netdev-filter-egress-ZONE.chain
# Path:     zones/ZONE/
# Title:    egress hook, base chain for netdev-family and filter chain-type
# Family:   netdev
# Table:    netdev_filter
# Chain:    netdev_filter_egress_ZONE
# Type:     filter
# Hook:     egress
# Priority: +310 (filter(0)+300)
# Policy:   accept
# Zone:     ZONE
# Called by: hooks/hooks-egress/base-netdev-filter-egress.chain
# Description:
#

    # No registry, using 'device'-based base chain
    chain netdev_filter_egress_ZONE {
        type filter hook egress device $ZONE_INTF_DEV priority 310; policy accept

        counter comment "netdev/filter/egress BEGIN"

        include "zones/ZONE/rules/netdev-filter-egress/*.rule"

        counter comment "netdev/filter/egress END"
        return
    }

