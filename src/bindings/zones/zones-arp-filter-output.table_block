
#
#
#

    # creates a registry for a zone-specific dispatcher only for arp/filter/output
    # empty map-less dispatcher table, crude first-come, first-serve vector list by registrants

    include "bindings/zones/*/arp-filter-output.table_block"

    chain arp_filter_output_DEVICE {
        # ALL-ZONE rules
        # ruleset for ALL devices related to arp/filter/output
        include "bindings/zones/rules/arp-filter-output/*.rule"
        jump arp_filter_output_DEVICE_ZONE
    }


    # no need to create a separate regular chain, fold it into the arp_filter_output base chain
