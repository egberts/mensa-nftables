# File:     zone-netdev-filter-egress-ZONE.chain
# Path:     *
# Title:    Regular chain?
# Family:   netdev
# Table:    *
# Chain:    netdev_filter_egress_ZONE
# Type:     filter
# Hook:     egress
# Priority: +310 (filter(0)+300)
# Policy:   *
# Zone:     ZONE
# Called by: hooks/hook-egress/base-netdev-filter-egress.chain
# Description: Stateful inbound host firewall
#

    # no layer-7 protocol-specific dispatcher needed in ARP family
    chain netdev_filter_egress_ZONE {

        counter comment "netdev/filter/egress/ZONE"
    }

    include "./zones/ZONE/netdev-filter-egress-ZONE.chain"  # no wildcard

    chain netdev_filter_egress_ZONE {
        # Log and count denied traffic.
        counter log prefix "DROP netdev/filter/egress/ZONE unknown packet in ZONE zone: " drop
    }
