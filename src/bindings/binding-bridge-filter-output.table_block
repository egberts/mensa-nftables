#
# File:     binding-bridge-filter-output.table_block
# Path:     bindings/
# Title:    Binding of output hook of bridge family, filter chain-type, to both by-zone and by-device
# Family:   bridge
# Type:     filter
# Hook:     output
# Priority: *
# Policy:   *
# Zone:     *
# Table:    filter_bridge
# Chain:    bridge_filter_output
# Called by: hooks/hook-output/base-bridge-filter-output.base_chain
# Description:
#

# filter_bridge table
#    bridge_filter_output base chain

    include "bindings/devices/devices-bridge-filter-output*.table_block"

    # Declare an interface-to-chain dispatcher for output hook, bridge family, filter chain-type.
    map map_dispatch_bridge_filter_output_interface {
        typeof iif : verdict
    }

    chain bridge_filter_output {

   #     include "bindings/zones/*/zone-bridge-filter-output.chain_block"
        include "bindings/devices/*/device-bridge-filter-output.chain_block"
    }

