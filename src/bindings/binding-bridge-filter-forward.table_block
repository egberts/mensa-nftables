# filter_bridge table
#    bridge_filter_forward base chain

    error "I got here for ARP retest"

    include "bindings/devices/devices-bridge-filter-forward*.table_block"

    # Declare an interface-to-chain dispatcher for forward hook, bridge family, filter chain-type.
    map map_dispatch_bridge_filter_forward_interface {
        typeof iif : verdict
    }

    chain bridge_filter_forward {

   #     include "bindings/zones/*/zone-bridge-filter-forward.chain_block"
        include "bindings/devices/*/device-bridge-filter-forward.chain_block"
    }

