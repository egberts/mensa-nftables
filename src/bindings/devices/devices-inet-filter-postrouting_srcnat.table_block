#
# File:     devices-inet-filter-postrouting_srcnat.table_block
# Path:     bindings/devices/
# Title:    Register all devices having inet/filter/postrouting
# Family:   inet
# Type:     filter
# Hook:     postrouting
# Priority: +110 (srcnat(100) + 10)
# Policy:   accept
# Table:    inet_filter
# Chain:    inet_filter_postrouting_srcnat
# Called by: hooks/hook-postrouting/base-inet-filter-postrouting_srcnat.base_chain
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

    # Pre-declare an interface-to-chain dispatcher for postrouting hook, inet family, filter chain-type.
    map map_dispatch_inet_filter_postrouting_srcnat_devices {
        typeof iif : verdict
    }

    # Insert the jump lookup
    chain inet_filter_postrouting_srcnat {
        counter comment "device inbound inet/filter/postrouting_srcnat"
        iif vmap @map_dispatch_inet_filter_postrouting_srcnat_devices
        counter comment "device inbound inet/filter/postrouting_srcnat, post dispatch"
    }

    # Register all inet_filter_postrouting_srcnat devices
    include "bindings/devices/*/binding-device-inet-filter-postrouting_srcnat.table_block"

