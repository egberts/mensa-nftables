#
# File:     devices-bridge-filter-postrouting_filter.table_block
# Path:     bindings/devices/
# Title:    Register all devices having bridge/filter/postrouting
# Family:   bridge
# Type:     filter
# Hook:     postrouting
# Priority: +10 (filter(0) + 10)
# Policy:   DROP
# Table:    bridge_filter
# Chain:    bridge_filter_postrouting_filter
# Called by: hooks/hook-postrouting/base-bridge-filter-postrouting.base_chain
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

    # Pre-declare an interface-to-chain dispatcher for postrouting hook, bridge family, filter chain-type.
    map map_dispatch_bridge_filter_postrouting_filter_devices {
        typeof iif : verdict
    }

    # Insert the jump lookup
    chain bridge_filter_postrouting_filter {
        counter comment "device inbound bridge/filter/postrouting_filter"
        iif vmap @map_dispatch_bridge_filter_postrouting_filter_devices
        counter comment "device inbound bridge/filter/postrouting_filter, post dispatch"
    }

    # Register all bridge_filter_postrouting_filter devices
    include "bindings/devices/*/binding-device-bridge-filter-postrouting_filter.table_block"

