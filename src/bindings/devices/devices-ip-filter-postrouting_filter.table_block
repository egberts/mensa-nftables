#
# File:     devices-ip-filter-postrouting_filter.table_block
# Path:     bindings/devices/
# Title:    Register all devices having ip/filter/postrouting
# Family:   ip
# Type:     filter
# Hook:     postrouting
# Priority: +10 (filter(0) + 10)
# Policy:   accept
# Table:    ip_filter
# Chain:    ip_filter_postrouting_filter
# Called by: hooks/hook-postrouting/base-ip-filter-postrouting_filter.base_chain
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

    # Pre-declare an interface-to-chain dispatcher for postrouting hook, ip family, filter chain-type.
    map map_dispatch_ip_filter_postrouting_filter_devices {
        typeof oif : verdict
    }
    # Insert the jump lookup
    chain ip_filter_postrouting_filter {

        counter comment "device outbound ip/filter/postrouting_filter"
        oif vmap @map_dispatch_ip_filter_postrouting_filter_devices
        counter comment "device outbound ip/filter/postrouting_filter, post dispatch"
    }

    # Register all ip_filter_postrouting_filter devices
    include "bindings/devices/*/binding-device-ip-filter-postrouting_filter.table_block"

