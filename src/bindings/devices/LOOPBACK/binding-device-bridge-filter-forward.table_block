# File:     bindings-device-bridge-filter-forward.table_block
# Path:     bindings/devices/DEVICE/
# Title:    Create regular chain and register with dispatcher of devices for bridge/filter/forward base chain
# Family:   bridge
# Table:    filter_bridge
# Chain:    filter_bridge_forward
# Type:     filter
# Hook:     forward
# Device:   DEVICE
# Priority: *
# Policy:   *
# Called by: binding/devices/DEVICE/device-bridge-filter-forward.chain_block
# Description:
#

    # Add/register a Device Interface-to-firewall dispatch registry
    map map_dispatch_bridge_filter_forward_LOOPBACKs {
        typeof iif : verdict
        elements = {
            # use goto, this is the final descendance
            $LOOPBACK_INTF_DEV : goto bridge_filter_forward_LOOPBACK,
        }
    }

    chain bridge_filter_forward_LOOPBACK {
        counter comment "BEGIN inbound DEVICE bridge/filter/forward"

        # DEVICE: Include rules strictly for all sub-zones/sub-devices having bridge/filter/forward regular chain
        include "bindings/devices/DEVICE/rules/bridge-filter-forward/*.rule"
    }
    # Split the chain so that other chains can be created (ie., dispatcher regular chain)


    # DEVICE/ZONE: Include all zones having this device bridge/filter/forward regular chain
    include "bindings/devices/DEVICE/zones/subzones-bridge-filter-forward.table_block"

    # ZONE: Include all zones having this device bridge/filter/forward regular chain
    # include "bindings/zones/zones-bridge-filter-forward.table_block"

    # (TODO: can we symbolically link to the parent zones/ZONE here, instead of include a duplicate ZONE?)

    # No need for DEVICE/DEVICE/ZONE; simply do a subdevice as DEVICE/ZONE

    chain bridge_filter_forward_LOOPBACK {
        counter comment "End inbound DEVICE bridge/filter/forward"
    }

