# File:     bindings-device-ip-filter-prerouting_dstnat.table_block
# Path:     bindings/devices/DEVICE/
# Title:    Create regular chain and register with dispatcher of devices for ip/filter/prerouting base chain
# Family:   ip
# Type:     filter
# Hook:     prerouting
# Device:   DEVICE
# Priority: -110 (dstnat(-100) - 10)
# Policy:   *
# Table:    filter_ip
# Chain:    filter_ip_prerouting_dstnat
# Called by: binding/devices/DEVICE/device-ip-filter-prerouting_dstnat.chain_block
# Description:
#

    # Add/register a Device Interface-to-firewall dispatch registry
    map map_dispatch_ip_filter_prerouting_dstnat_LOOPBACKs {
        typeof iif : verdict
        elements = {
            # use goto, this is the final descendance
            $LOOPBACK_INTF_DEV : goto ip_filter_prerouting_dstnat_LOOPBACK,
        }
    }

    chain ip_filter_prerouting_dstnat_LOOPBACK {
        counter comment "BEGIN inbound DEVICE ip/filter/prerouting_dstnat"

        # DEVICE: Include rules strictly for all sub-zones/sub-devices having ip/filter/prerouting regular chain
        include "bindings/devices/DEVICE/rules/ip-filter-prerouting_dstnat/*.rule"
    }
    # Split the chain so that other chains can be created (ie., dispatcher regular chain)


    # DEVICE/ZONE: Include all zones having this device ip/filter/prerouting regular chain
    include "bindings/devices/DEVICE/zones/subzones-ip-filter-prerouting_dstnat.table_block"

    # ZONE: Include all zones having this device ip/filter/prerouting regular chain
    # include "bindings/zones/zones-ip-filter-prerouting_dstnat.table_block"

    # (TODO: can we symbolically link to the parent zones/ZONE here, instead of include a duplicate ZONE?)

    # No need for DEVICE/DEVICE/ZONE; simply do a subdevice as DEVICE/ZONE

    chain ip_filter_prerouting_dstnat_LOOPBACK {
        counter comment "End inbound DEVICE ip/filter/prerouting_dstnat"
    }

