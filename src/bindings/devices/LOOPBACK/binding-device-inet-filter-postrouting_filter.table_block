#
# File:     bindings-device-inet-filter-postrouting_filter.table_block
# Path:     bindings/devices/DEVICE/
# Title:    Regular chain with dispatcher for inet/filter/postrouting for filter(0) priority
# Family:   inet
# Type:     filter
# Hook:     postrouting
# Device:   DEVICE
# Priority: +10 (filter(0)+10)
# Policy:   accept
# Table:    filter_inet
# Chain:    filter_inet_postrouting_filter
# Called by: binding/devices/DEVICE/device-inet-filter-postrouting_filter.chain_block
# Description:
#

    # Add/register a Device Interface-to-firewall dispatch registry
    map map_dispatch_inet_filter_postrouting_filter_LOOPBACKs {
        typeof oif : verdict
        elements = {
            # use goto, this is the final descendance
            $LOOPBACK_INTF_DEV : goto inet_filter_postrouting_filter_LOOPBACK,
        }
    }

    chain inet_filter_postrouting_filter_LOOPBACK {
        counter comment "BEGIN outbound DEVICE inet/filter/postrouting_filter"

        # DEVICE: Include rules strictly for all sub-zones/sub-devices having inet/filter/postrouting regular chain
        include "bindings/devices/DEVICE/rules/inet-filter-postrouting_filter*/*.rule"
    }
    # Split the chain so that other chains can be created (ie., dispatcher regular chain)


    # DEVICE/ZONE: Include all zones having this device inet/filter/postrouting regular chain
    include "bindings/devices/DEVICE/zones/subzones-inet-filter-postrouting_filter.table_block"

    # ZONE: Include all zones having this device inet/filter/postrouting regular chain
    # include "bindings/zones/zones-inet-filter-postrouting_filter.table_block"

    # (TODO: can we symbolically link to the parent zones/ZONE here, instead of include a duplicate ZONE?)

    # No need for DEVICE/DEVICE/ZONE; simply do a subdevice as DEVICE/ZONE

    chain inet_filter_postrouting_filter_LOOPBACK {
        counter comment "End outbound DEVICE inet/filter/postrouting_filter"
    }

