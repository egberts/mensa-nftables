# File:     bindings-device-inet-nat-input.table_block
# Path:     bindings/devices/DEVICE/
# Title:    Create regular chain and register with dispatcher of devices for inet/nat/input base chain
# Family:   inet
# Type:     nat
# Hook:     input
# Device:   DEVICE
# Priority: -10 (filter(0)-10)
# Policy:   accept
# Table:    nat_inet
# Chain:    nat_inet_input
# Called by: binding/devices/DEVICE/device-inet-nat-input.chain_block
# Description:
#

    # Add/register a Device Interface-to-firewall dispatch registry
    map map_dispatch_inet_nat_input_LOOPBACKs {
        typeof iif : verdict
        elements = {
            # use goto, this is the final descendance
            $LOOPBACK_INTF_DEV : goto inet_nat_input_LOOPBACK,
        }
    }

    chain inet_nat_input_LOOPBACK {
        counter comment "BEGIN inbound DEVICE inet/nat/input"

        # DEVICE: Include rules strictly for all sub-zones/sub-devices having inet/nat/input regular chain
        include "bindings/devices/DEVICE/rules/inet-nat-input/*.rule"
    }
    # Split the chain so that other chains can be created (ie., dispatcher regular chain)


    # DEVICE/ZONE: Include all zones having this device inet/nat/input regular chain
    include "bindings/devices/DEVICE/zones/subzones-inet-nat-input.table_block"

    # ZONE: Include all zones having this device inet/nat/input regular chain
    # include "bindings/zones/zones-inet-nat-input.table_block"

    # (TODO: can we symbolically link to the parent zones/ZONE here, instead of include a duplicate ZONE?)

    # No need for DEVICE/DEVICE/ZONE; simply do a subdevice as DEVICE/ZONE

    chain inet_nat_input_LOOPBACK {
        counter comment "End inbound DEVICE inet/nat/input"
    }

