#
# File:     bindings-device-ip-filter-postrouting_srcnat.table_block
# Path:     bindings/devices/DEVICE/
# Title:    Regular chain with dispatcher for ip/filter/postrouting for srcnat(100) priority
# Family:   ip
# Type:     filter
# Hook:     postrouting
# Device:   DEVICE
# Priority: +110 (srcnat(100)+10)
# Policy:   accept
# Table:    filter_ip
# Chain:    filter_ip_postrouting_srcnat
# Called by: binding/devices/DEVICE/device-ip-filter-postrouting_srcnat.chain_block
# Description:
#

    # Add/register a Device Interface-to-firewall dispatch registry
    map map_dispatch_ip_filter_postrouting_srcnat_LOOPBACKs {
        typeof oif : verdict
        elements = {
            # use goto, this is the final descendance
            $LOOPBACK_INTF_DEV : goto ip_filter_postrouting_srcnat_LOOPBACK,
        }
    }

    chain ip_filter_postrouting_srcnat_LOOPBACK {
        counter comment "BEGIN outbound DEVICE ip/filter/postrouting_srcnat"

        # DEVICE: Include rules strictly for all sub-zones/sub-devices having ip/filter/postrouting regular chain
        include "bindings/devices/DEVICE/rules/ip-filter-postrouting_srcnat*/*.rule"
    }
    # Split the chain so that other chains can be created (ie., dispatcher regular chain)


    # DEVICE/ZONE: Include all zones having this device ip/filter/postrouting regular chain
    include "bindings/devices/DEVICE/zones/subzones-ip-filter-postrouting_srcnat.table_block"

    # ZONE: Include all zones having this device ip/filter/postrouting regular chain
    # include "bindings/zones/zones-ip-filter-postrouting_srcnat.table_block"

    # (TODO: can we symbolically link to the parent zones/ZONE here, instead of include a duplicate ZONE?)

    # No need for DEVICE/DEVICE/ZONE; simply do a subdevice as DEVICE/ZONE

    chain ip_filter_postrouting_srcnat_LOOPBACK {
        counter comment "End outbound DEVICE ip/filter/postrouting_srcnat"
    }

