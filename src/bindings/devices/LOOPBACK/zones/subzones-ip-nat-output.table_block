#
# File: subzones-ip-nat-output.table_block
# Path: bindings/devices/DEVICE/zones/
# Title: Include all subzones associated with this device for ip/nat/output
# Family: ip
# Type: nat
# Hook: output
# Device: DEVICE
# Priority: +10 (filter(0)+10)
# Policy: accept
# Table: nat_ip
# Chain: ip_nat_output_LOOPBACK
# Called by: bindings/devices/DEVICE/binding-device-ip-nat-output.table_block
#

    # going to need a registry table just for DEVICE-ZONE
    chain dispatcher_ip_nat_output_lo_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/DEVICE/zones/*/zone-ip-nat-output.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain ip_nat_output_LOOPBACK {
        jump dispatcher_ip_nat_output_lo_ZONE
    }
