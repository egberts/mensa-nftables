#
# File: subzones-ip6-filter-input.table_block
# Path: bindings/devices/DEVICE/zones/
# Title: Include all subzones associated with this device for ip6/filter/input
# Family: ip6
# Type: filter
# Hook: input
# Device: DEVICE
# Priority: -10 (filter(0)-10)
# Table: filter_ip6
# Chain: ip6_filter_input_LOOPBACK
# Called by: bindings/devices/DEVICE/binding-device-ip6-filter-input.table_block
#

    # going to need a registry table just for DEVICE-ZONE
    chain dispatcher_ip6_filter_input_lo_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/DEVICE/zones/*/zone-ip6-filter-input.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain ip6_filter_input_LOOPBACK {

        jump dispatcher_ip6_filter_input_lo_ZONE
    }

