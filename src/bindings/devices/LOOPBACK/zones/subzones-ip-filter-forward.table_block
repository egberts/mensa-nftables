#
# File: subzones-ip-filter-forward.table_block
# Path: bindings/devices/DEVICE/zones/
# Title: Include all subzones associated with this device for ip/filter/forward
# Family: ip
# Type: filter
# Hook: forward
# Device: DEVICE
# Priority: -10 (filter(0)-10)
# Table: filter_ip
# Chain: ip_filter_forward_LOOPBACK
# Called by: bindings/devices/DEVICE/binding-device-ip-filter-forward.table_block
#

    # going to need a registry table just for DEVICE-ZONE
    chain dispatcher_ip_filter_forward_lo_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/DEVICE/zones/*/zone-ip-filter-forward.chain_block"
    }

    # poor-mans dispatcher, sequential hooking
    chain ip_filter_forward_LOOPBACK {

        jump dispatcher_ip_filter_forward_lo_ZONE
    }

