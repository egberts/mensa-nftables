#
# File: subzones-inet-filter-postrouting_security.table_block
# Path: bindings/devices/DEVICE/zones/
# Title: Include all subzones associated with this device for inet/filter/postrouting
# Family: inet
# Type: filter
# Hook: postrouting
# Device: DEVICE
# Priority: +110 (srcnat(100)+10)
# Table: filter_inet
# Chain: inet_filter_postrouting_security_LOOPBACK
# Called by: bindings/devices/DEVICE/binding-device-inet-filter-postrouting_security.table_block
#

    # going to need a registry table just for DEVICE-ZONE
    chain dispatcher_inet_filter_postrouting_security_lo_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/DEVICE/zones/*/zone-inet-filter-postrouting_security.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain inet_filter_postrouting_security_LOOPBACK {
        jump dispatcher_inet_filter_postrouting_security_lo_ZONE
    }
