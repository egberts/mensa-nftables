#
# File: subzones-ip-filter-prerouting_dstnat.table_block
# Path: bindings/devices/DEVICE/zones/
# Title: Include all subzones associated with this device for ip/filter/prerouting
# Family: ip
# Type: filter
# Hook: prerouting
# Device: DEVICE
# Priority: -110 (dstnat(-100)-10)
# Table: filter_ip
# Chain: ip_filter_prerouting_dstnat_LOOPBACK
# Called by: bindings/devices/DEVICE/binding-device-ip-filter-prerouting_dstnat.table_block
#

    # going to need a registry table just for DEVICE-ZONE
    chain dispatcher_ip_filter_prerouting_dstnat_lo_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/DEVICE/zones/*/zone-ip-filter-prerouting_dstnat.chain_block"
    }

    # poor-mans dispatcher, sequential hooking
    chain ip_filter_prerouting_dstnat_LOOPBACK {

        jump dispatcher_ip_filter_prerouting_dstnat_lo_ZONE
    }

