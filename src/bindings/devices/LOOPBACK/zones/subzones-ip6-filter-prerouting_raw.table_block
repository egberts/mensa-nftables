#
# File: subzones-ip6-filter-prerouting_raw.table_block
# Path: bindings/devices/DEVICE/zones/
# Title: Include all subzones associated with this device for ip6/filter/prerouting
# Family: ip6
# Type: filter
# Hook: prerouting
# Device: DEVICE
# Priority: -310 (raw(-300)-10)
# Table: filter_ip6
# Chain: ip6_filter_prerouting_raw_LOOPBACK
# Called by: bindings/devices/DEVICE/binding-device-ip6-filter-prerouting_raw.table_block
#

    # going to need a registry table just for DEVICE-ZONE
    chain dispatcher_ip6_filter_prerouting_raw_lo_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/DEVICE/zones/*/zone-ip6-filter-prerouting_raw.chain_block"
    }

    # poor-mans dispatcher, sequential hooking
    chain ip6_filter_prerouting_raw_LOOPBACK {

        jump dispatcher_ip6_filter_prerouting_raw_lo_ZONE
    }

