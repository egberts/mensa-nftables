#
# File: subzones-arp-filter-input.table_block
# Path: bindings/devices/DEVICE/zones/
# Title: Include all subzones associated with this device for arp/filter/input
# Family: arp
# Table: filter_arp
# Chain: arp_filter_input_LOOPBACK
# Type: filter
# Hook: input
# Device: DEVICE
# Priority: -10
# Called by: bindings/devices/DEVICE/binding-device-bridge-filter-input.table_block
#

    # going to need a registry table just for DEVICE-ZONE
    chain dispatcher_arp_filter_input_lo_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/DEVICE/zones/*/zone-arp-filter-input.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain arp_filter_input_LOOPBACK {
        jump dispatcher_arp_filter_input_lo_ZONE
    }
