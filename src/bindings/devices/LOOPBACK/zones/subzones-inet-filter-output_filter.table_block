#
# File: subzones-inet-filter-output_filter.table_block
# Path: bindings/devices/DEVICE/zones/
# Title: Include all subzones associated with this device for inet/filter/output
# Family: inet
# Type: filter
# Hook: output
# Device: DEVICE
# Priority: +10 (filter(0)+10)
# Table: filter_inet
# Chain: inet_filter_output_filter_LOOPBACK
# Called by: bindings/devices/DEVICE/binding-device-inet-filter-output_filter.table_block
#

    # going to need a registry table just for DEVICE-ZONE
    chain dispatcher_inet_filter_output_filter_lo_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/DEVICE/zones/*/zone-inet-filter-output_filter.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain inet_filter_output_filter_LOOPBACK {
        jump dispatcher_inet_filter_output_filter_lo_ZONE
    }
