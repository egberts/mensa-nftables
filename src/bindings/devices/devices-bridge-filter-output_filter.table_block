#
# File:     devices-bridge-filter-output_filter.table_block
# Path:     bindings/devices/
# Title:    Register all devices having bridge/filter/output for filter(0) priority
# Family:   bridge
# Type:     filter
# Hook:     output
# Priority: +10 (filter(0) + 10)
# Policy:   DROP
# Table:    bridge_filter
# Chain:    bridge_filter_output_filter
# Called by: hooks/hook-output/base-bridge-filter-output_filter.base_chain
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

    # Pre-declare an interface-to-chain dispatcher for output hook, bridge family, filter chain-type.
    map map_dispatch_bridge_filter_output_filter_devices {
        typeof iif : verdict
    }

    # Insert the jump lookup
    chain bridge_filter_output_filter {
        counter comment "device inbound bridge/filter/output_filter"
        iif vmap @map_dispatch_bridge_filter_output_filter_devices
        counter comment "device inbound bridge/filter/output_filter, post dispatch"
    }

    # Register all bridge_filter_output_filter devices
    include "bindings/devices/*/binding-device-bridge-filter-output_filter.table_block"

