#
# File:     devices-inet-route-output.table_block
# Path:     bindings/devices/
# Title:    Register all devices having inet/route/output
# Family:   inet
# Type:     route
# Hook:     output
# Priority: +10 (filter(0) + 10)
# Policy:   accept
# Table:    inet_route
# Chain:    inet_route_output
# Called by: hooks/hook-output/base-inet-route-output.base_chain
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#
    # Pre-declare an interface-to-chain dispatcher for output hook, inet family, route chain-type.
    map map_dispatch_inet_route_output_devices {
        typeof iif : verdict
    }

    # Insert the jump lookup
    chain inet_route_output {
        counter comment "device inbound inet/route/output"
        iif vmap @map_dispatch_inet_route_output_devices
        counter comment "device inbound inet/route/output, post dispatch"
    }

    # Register all inet_route_output devices
    include "bindings/devices/*/binding-device-inet-route-output.table_block"

