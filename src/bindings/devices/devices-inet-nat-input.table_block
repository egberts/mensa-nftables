#
# File:     devices-inet-nat-input.table_block
# Path:     bindings/devices/
# Title:    Register all devices having inet/nat/input
# Family:   inet
# Type:     nat
# Hook:     input
# Priority: +10 (filter(0) + 10)
# Policy:   accept
# Table:    inet_nat
# Chain:    inet_nat_input
# Called by: hooks/hook-input/base-inet-nat-input.base_chain
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#
    # Pre-declare an interface-to-chain dispatcher for input hook, inet family, nat chain-type.
    map map_dispatch_inet_nat_input_devices {
        typeof iif : verdict
    }

    # Insert the jump lookup
    chain inet_nat_input {
        counter comment "device inbound inet/nat/input"
        iif vmap @map_dispatch_inet_nat_input_devices
        counter comment "device inbound inet/nat/input, post dispatch"
    }

    # Register all inet_nat_input devices
    include "bindings/devices/*/binding-device-inet-nat-input.table_block"

