#
# File:     devices-ip6-filter-ingress.table_block
# Path:     bindings/devices/
# Title:    Register all devices having ip6/filter/ingress
# Family:   ip6
# Table:    ip6_filter
# Chain:    ip6_filter_ingress
# Type:     filter
# Hook:     ingress
# Priority: -10 (over Libvirt/Docker filter(0) and ip/ip6 filter-1)
# Policy:   DROP
# Called by: hooks/hook-ingress/base-ip6-filter-ingress.base_chain
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

    # Pre-declare an interface-to-chain dispatcher for ingress hook, ip6 family, filter chain-type.
    map map_dispatch_ip6_filter_ingress_devices {
        typeof iif : verdict
    }

    # Insert the jump lookup
    chain ip6_filter_ingress {
        counter comment "device inbound ip6/filter/ingress"
        iif vmap @map_dispatch_ip6_filter_ingress_devices
        counter comment "device inbound ip6/filter/ingress, post dispatch"
    }

    # Register all ip6_filter_ingress devices
    include "bindings/devices/*/binding-device-ip6-filter-ingress.table_block"

