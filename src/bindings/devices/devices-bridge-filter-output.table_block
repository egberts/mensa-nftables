#
# File:     devices-bridge-filter-output.table_block
# Path:     bindings/devices/
# Title:    Register all devices having bridge/filter/output
# Family:   bridge
# Table:    bridge_filter
# Chain:    bridge_filter_output
# Type:     filter
# Hook:     output
# Priority: +110 (out(100) + 10)
# Policy:   DROP
# Called by: hooks/hook-output/base-bridge-filter-output.base_chain
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

    # Pre-declare an interface-to-chain dispatcher for output hook, bridge family, filter chain-type.
    map map_dispatch_bridge_filter_output_devices {
        typeof iif : verdict
    }

    # Insert the jump lookup
    chain bridge_filter_output {
        counter comment "device inbound bridge/filter/output"
        iif vmap @map_dispatch_bridge_filter_output_devices
        counter comment "device inbound bridge/filter/output, post dispatch"
    }

    # Register all bridge_filter_output devices
    include "bindings/devices/*/binding-device-bridge-filter-output.table_block"

