#
# File:     devices-bridge-filter-prerouting_filter.table_block
# Path:     bindings/devices/
# Title:    Register all devices having bridge/filter/prerouting
# Family:   bridge
# Table:    bridge_filter
# Chain:    bridge_filter_prerouting_filter
# Type:     filter
# Hook:     prerouting
# Priority: -10 (filter(0) - 10)
# Policy:   DROP
# Called by: hooks/hook-prerouting/base-bridge-filter-prerouting.base_chain
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

    # Pre-declare an interface-to-chain dispatcher for prerouting hook, bridge family, filter chain-type.
    map map_dispatch_bridge_filter_prerouting_filter_devices {
        typeof iif : verdict
    }

    # Insert the jump lookup
    chain bridge_filter_prerouting_filter {
        counter comment "device inbound bridge/filter/prerouting_filter"
        iif vmap @map_dispatch_bridge_filter_prerouting_filter_devices
        counter comment "device inbound bridge/filter/prerouting_filter, post dispatch"
    }

    # Register all bridge_filter_prerouting_filter devices
    include "bindings/devices/*/binding-device-bridge-filter-prerouting_filter.table_block"

