#
# File:     devices-inet-filter-ingress.table_block
# Path:     bindings/devices/
# Title:    Register all devices having inet/filter/ingress
# Family:   inet
# Table:    inet_filter
# Chain:    inet_filter_ingress
# Type:     filter
# Hook:     ingress
# Priority: -10 (over Libvirt/Docker filter(0) and ip/ip6 filter-1)
# Policy:   DROP
# Called by: hooks/hook-ingress/base-inet-filter-ingress.base_chain
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

    # Pre-declare an interface-to-chain dispatcher for ingress hook, inet family, filter chain-type.
    map map_dispatch_inet_filter_ingress_devices {
        typeof iif : verdict
    }

    # Insert the jump lookup
    chain inet_filter_ingress {
        counter comment "device inbound inet/filter/ingress"
        iif vmap @map_dispatch_inet_filter_ingress_devices
        counter comment "device inbound inet/filter/ingress, post dispatch"
    }

    # Register all inet_filter_ingress devices
    include "bindings/devices/*/binding-device-inet-filter-ingress.table_block"

