#
# File:     devices-inet-filter-output_filter.table_block
# Path:     bindings/devices/
# Title:    Register all devices having inet/filter/output for filter(0) priority
# Family:   inet
# Type:     filter
# Hook:     output
# Priority: +10 (filter(0) + 10)
# Policy:   DROP
# Table:    inet_filter
# Chain:    inet_filter_output_filter
# Called by: hooks/hook-output/base-inet-filter-output_filter.base_chain
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

    # Pre-declare an interface-to-chain dispatcher for output hook, inet family, filter chain-type.
    # very useful when declaring multiple devices
    map map_dispatch_inet_filter_output_filter_devices {
        typeof oif : verdict
    }
    # Insert the jump lookup
    chain inet_filter_output_filter {

        counter comment "device outbound inet/filter/output_filter"
        oif vmap @map_dispatch_inet_filter_output_filter_devices
        counter comment "device outbound inet/filter/output_filter, post dispatch"
    }

    # Register all inet_filter_output_filter devices
    include "bindings/devices/*/binding-device-inet-filter-output_filter.table_block"

