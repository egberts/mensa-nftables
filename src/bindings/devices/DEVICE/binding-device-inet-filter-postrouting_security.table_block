#
# File:     bindings-device-inet-filter-postrouting_security.table_block
# Path:     bindings/devices/DEVICE/
# Title:    Regular chain with dispatcher for inet/filter/postrouting for security(50) priority
# Family:   inet
# Type:     filter
# Hook:     postrouting
# Device:   DEVICE
# Priority: +60 (security(50)+10)
# Policy:   accept
# Table:    filter_inet
# Chain:    filter_inet_postrouting_security
# Called by: binding/devices/DEVICE/device-inet-filter-postrouting_security.chain_block
# Description:
#

    # Add/register a Device Interface-to-firewall dispatch registry
    map map_dispatch_inet_filter_postrouting_security_devices {
        typeof oif : verdict
        elements = {
            # use goto, this is the final descendance
            $DEVICE_INTF_DEV : goto inet_filter_postrouting_security_DEVICE,
        }
    }

    chain inet_filter_postrouting_security_DEVICE {
        counter comment "BEGIN outbound DEVICE inet/filter/postrouting_security"

        # DEVICE: Include rules strictly for all sub-zones/sub-devices having inet/filter/postrouting regular chain
        include "bindings/devices/DEVICE/rules/inet-filter-postrouting_security*/*.rule"
    }
    # Split the chain so that other chains can be created (ie., dispatcher regular chain)


    # DEVICE/ZONE: Include all zones having this device inet/filter/postrouting regular chain
    include "bindings/devices/DEVICE/zones/subzones-inet-filter-postrouting_security.table_block"

    # ZONE: Include all zones having this device inet/filter/postrouting regular chain
    # include "bindings/zones/zones-inet-filter-postrouting_security.table_block"

    # (TODO: can we symbolically link to the parent zones/ZONE here, instead of include a duplicate ZONE?)

    # No need for DEVICE/DEVICE/ZONE; simply do a subdevice as DEVICE/ZONE

    chain inet_filter_postrouting_security_DEVICE {
        counter comment "End outbound DEVICE inet/filter/postrouting_security"
    }

