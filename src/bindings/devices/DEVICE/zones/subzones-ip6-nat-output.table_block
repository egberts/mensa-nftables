#
# File: subzones-ip6-nat-output.table_block
# Path: bindings/devices/DEVICE/zones/
# Title: Include all subzones associated with this device for ip6/nat/output
# Family: ip6
# Type: nat
# Hook: output
# Device: DEVICE
# Priority: +10 (filter(0)+10)
# Policy: accept
# Table: nat_ip6
# Chain: ip6_nat_output_DEVICE
# Called by: bindings/devices/DEVICE/binding-device-ip6-nat-output.table_block
#

    # going to need a registry table just for DEVICE-ZONE
    chain dispatcher_ip6_nat_output_DEVICE_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/DEVICE/zones/*/zone-ip6-nat-output.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain ip6_nat_output_DEVICE {
        jump dispatcher_ip6_nat_output_DEVICE_ZONE
    }
