#
# File: subzones-ip-filter-output_raw.table_block
# Path: bindings/devices/DEVICE/zones/
# Title: Include all subzones associated with this device for ip/filter/output
# Family: ip
# Type: filter
# Hook: output
# Device: DEVICE
# Priority: +310 ((+300)+10)
# Table: filter_ip
# Chain: ip_filter_output_raw_DEVICE
# Called by: bindings/devices/DEVICE/binding-device-ip-filter-output_raw.table_block
#

    # going to need a registry table just for DEVICE-ZONE
    chain dispatcher_ip_filter_output_raw_DEVICE_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/DEVICE/zones/*/zone-ip-filter-output_raw.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain ip_filter_output_raw_DEVICE {
        jump dispatcher_ip_filter_output_raw_DEVICE_ZONE
    }
