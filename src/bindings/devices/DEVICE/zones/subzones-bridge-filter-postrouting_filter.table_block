#
# File: subzones-bridge-filter-postrouting_filter.table_block
# Path: bindings/devices/DEVICE/zones/
# Title: Include all subzones associated with this device for bridge/filter/postrouting
# Family: bridge
# Type: filter
# Hook: postrouting
# Device: DEVICE
# Priority: +310 (srcnat(300)+10)
# Table: filter_bridge
# Chain: bridge_filter_postrouting_filter_DEVICE
# Called by: bindings/devices/DEVICE/binding-device-bridge-filter-postrouting_filter.table_block
#

    # going to need a registry table just for DEVICE-ZONE
    chain dispatcher_bridge_filter_postrouting_filter_DEVICE_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/DEVICE/zones/*/zone-bridge-filter-postrouting_filter.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain bridge_filter_postrouting_filter_DEVICE {
        jump dispatcher_bridge_filter_postrouting_filter_DEVICE_ZONE
    }
