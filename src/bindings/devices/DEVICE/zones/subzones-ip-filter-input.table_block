#
# File: subzones-ip-filter-input.table_block
# Path: bindings/devices/DEVICE/zones/
# Title: Include all subzones associated with this device for ip/filter/input
# Family: ip
# Type: filter
# Hook: input
# Device: DEVICE
# Priority: -10 (filter(0)-10)
# Table: filter_ip
# Chain: ip_filter_input_DEVICE
# Called by: bindings/devices/DEVICE/binding-device-ip-filter-input.table_block
#

    # going to need a registry table just for DEVICE-ZONE
    chain dispatcher_ip_filter_input_DEVICE_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/DEVICE/zones/*/zone-ip-filter-input.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain ip_filter_input_DEVICE {

        jump dispatcher_ip_filter_input_DEVICE_ZONE
    }

