#
# File: subzones-inet-filter-prerouting_raw.table_block
# Path: bindings/devices/DEVICE/zones/
# Title: Include all subzones associated with this device for inet/filter/prerouting
# Family: inet
# Type: filter
# Hook: prerouting
# Device: DEVICE
# Priority: -310 (raw(-300)-10)
# Table: filter_inet
# Chain: inet_filter_prerouting_raw_DEVICE
# Called by: bindings/devices/DEVICE/binding-device-inet-filter-prerouting_raw.table_block
#

    # going to need a registry table just for DEVICE-ZONE
    chain dispatcher_inet_filter_prerouting_raw_DEVICE_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/DEVICE/zones/*/zone-inet-filter-prerouting_raw.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain inet_filter_prerouting_raw_DEVICE {
        jump dispatcher_inet_filter_prerouting_raw_DEVICE_ZONE
    }
