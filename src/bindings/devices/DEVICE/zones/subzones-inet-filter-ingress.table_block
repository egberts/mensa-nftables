#
# File: subzones-inet-filter-ingress.table_block
# Path: bindings/devices/DEVICE/zones/
# Title: Include all subzones associated with this device for inet/filter/ingress
# Family: inet
# Type: filter
# Hook: ingress
# Device: DEVICE
# Priority: -10
# Policy: accept
# Table: filter_inet
# Chain: inet_filter_ingress_DEVICE
# Called by: bindings/devices/DEVICE/binding-device-bridge-filter-ingress.table_block
#

    # going to need a registry table just for DEVICE-ZONE
    chain dispatcher_inet_filter_ingress_DEVICE_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/DEVICE/zones/*/zone-inet-filter-ingress.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain inet_filter_ingress_DEVICE {
        jump dispatcher_inet_filter_ingress_DEVICE_ZONE
    }
