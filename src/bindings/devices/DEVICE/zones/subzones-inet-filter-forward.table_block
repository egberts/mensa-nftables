#
# File: subzones-inet-filter-forward.table_block
# Path: bindings/devices/DEVICE/zones/
# Title: Include all subzones associated with this device for inet/filter/forward
# Family: inet
# Type: filter
# Hook: forward
# Device: DEVICE
# Priority: -10 (filter(0)-10)
# Table: filter_inet
# Chain: inet_filter_forward_DEVICE
# Called by: bindings/devices/DEVICE/binding-device-inet-filter-forward.table_block
#

    # going to need a registry table just for DEVICE-ZONE
    chain dispatcher_inet_filter_forward_DEVICE_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/DEVICE/zones/*/zone-inet-filter-forward.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain inet_filter_forward_DEVICE {
        jump dispatcher_inet_filter_forward_DEVICE_ZONE
    }
