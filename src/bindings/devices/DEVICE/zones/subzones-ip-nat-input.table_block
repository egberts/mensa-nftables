#
# File: subzones-ip-nat-input.table_block
# Path: bindings/devices/DEVICE/zones/
# Title: Include all subzones associated with this device for ip/nat/input
# Family: ip
# Type: nat
# Hook: input
# Device: DEVICE
# Priority: -10 (nat(0)-10)
# Table: nat_ip
# Chain: ip_nat_input_DEVICE
# Called by: bindings/devices/DEVICE/binding-device-ip-nat-input.table_block
#

    # going to need a registry table just for DEVICE-ZONE
    chain dispatcher_ip_nat_input_DEVICE_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/DEVICE/zones/*/zone-ip-nat-input.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain ip_nat_input_DEVICE {
        jump dispatcher_ip_nat_input_DEVICE_ZONE
    }
