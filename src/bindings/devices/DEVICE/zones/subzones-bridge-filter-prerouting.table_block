#
# File: subzones-bridge-filter-prerouting.table_block
# Path: bindings/devices/DEVICE/zones/
# Title: Include all subzones associated with this device for bridge/filter/prerouting
# Family: bridge
# Type: filter
# Hook: prerouting
# Device: DEVICE
# Priority: -310 (dstnat(300)-10)
# Table: filter_bridge
# Chain: bridge_filter_prerouting_DEVICE
# Called by: bindings/devices/DEVICE/binding-device-bridge-filter-prerouting.table_block
#

    # going to need a registry table just for DEVICE-ZONE
    chain dispatcher_bridge_filter_prerouting_DEVICE_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/DEVICE/zones/*/zone-bridge-filter-prerouting.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain bridge_filter_prerouting_DEVICE {
        jump dispatcher_bridge_filter_prerouting_DEVICE_ZONE
    }
