#
# File: subzones-bridge-filter-output.table_block
# Path: bindings/devices/DEVICE/zones/
# Title: Include all subzones associated with this device for bridge/filter/output
# Family: bridge
# Table: filter_bridge
# Chain: bridge_filter_output_DEVICE
# Type: filter
# Hook: output
# Device: DEVICE
# Priority: +110 (out(100)+10)
# Called by: bindings/devices/DEVICE/binding-device-bridge-filter-output.table_block
#

    # going to need a registry table just for DEVICE-ZONE
    chain dispatcher_bridge_filter_output_DEVICE_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/DEVICE/zones/*/zone-bridge-filter-output.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain bridge_filter_output_DEVICE {
        jump dispatcher_bridge_filter_output_DEVICE_ZONE
    }
