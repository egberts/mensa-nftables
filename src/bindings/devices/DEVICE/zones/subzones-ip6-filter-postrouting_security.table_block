#
# File: subzones-ip6-filter-postrouting_security.table_block
# Path: bindings/devices/DEVICE/zones/
# Title: Include all subzones associated with this device for ip6/filter/postrouting
# Family: ip6
# Type: filter
# Hook: postrouting
# Device: DEVICE
# Priority: +110 (srcnat(100)+10)
# Table: filter_ip6
# Chain: ip6_filter_postrouting_security_DEVICE
# Called by: bindings/devices/DEVICE/binding-device-ip6-filter-postrouting_security.table_block
#

    # going to need a registry table just for DEVICE-ZONE
    chain dispatcher_ip6_filter_postrouting_security_DEVICE_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/DEVICE/zones/*/zone-ip6-filter-postrouting_security.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain ip6_filter_postrouting_security_DEVICE {
        jump dispatcher_ip6_filter_postrouting_security_DEVICE_ZONE
    }
