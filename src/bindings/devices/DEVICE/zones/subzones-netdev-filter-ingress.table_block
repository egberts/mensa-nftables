#
# File: subzones-netdev-filter-ingress.table_block
# Path: bindings/devices/DEVICE/zones/
# Title: Include all subzones associated with this device for netdev/filter/ingress
# Family: netdev
# Type: filter
# Hook: ingress
# Device: DEVICE
# Priority: -10
# Policy: accept
# Table: filter_netdev
# Chain: netdev_filter_ingress_DEVICE
# Called by: bindings/devices/DEVICE/binding-device-bridge-filter-ingress.table_block
#

    # going to need a registry table just for DEVICE-ZONE
    chain dispatcher_netdev_filter_ingress_DEVICE_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/DEVICE/zones/*/zone-netdev-filter-ingress.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain netdev_filter_ingress_DEVICE {
        jump dispatcher_netdev_filter_ingress_DEVICE_ZONE
    }
