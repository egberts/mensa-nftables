#
# File:     bindings-device-inet-filter-postrouting_mangle.table_block
# Path:     bindings/devices/DEVICE/
# Title:    Regular chain with dispatcher for inet/filter/postrouting for mangle(-150) priority
# Family:   inet
# Type:     filter
# Hook:     postrouting
# Device:   DEVICE
# Priority: -160 (mangle(-150)-10)
# Policy:   accept
# Table:    filter_inet
# Chain:    filter_inet_postrouting_mangle
# Called by: binding/devices/DEVICE/device-inet-filter-postrouting_mangle.chain_block
# Description:
#

    # Add/register a Device Interface-to-firewall dispatch registry
    map map_dispatch_inet_filter_postrouting_mangle_devices {
        typeof iif : verdict
        elements = {
            # use goto, this is the final descendance
            $DEVICE_INTF_DEV : goto inet_filter_postrouting_mangle_DEVICE,
        }
    }

    chain inet_filter_postrouting_mangle_DEVICE {
        counter comment "BEGIN inbound DEVICE inet/filter/postrouting_mangle"

        # DEVICE: Include rules strictly for all sub-zones/sub-devices having inet/filter/postrouting regular chain
        include "bindings/devices/DEVICE/rules/inet-filter-postrouting_mangle*/*.rule"
    }
    # Split the chain so that other chains can be created (ie., dispatcher regular chain)


    # DEVICE/ZONE: Include all zones having this device inet/filter/postrouting regular chain
    include "bindings/devices/DEVICE/zones/subzones-inet-filter-postrouting_mangle.table_block"

    # ZONE: Include all zones having this device inet/filter/postrouting regular chain
    # include "bindings/zones/zones-inet-filter-postrouting_mangle.table_block"

    # (TODO: can we symbolically link to the parent zones/ZONE here, instead of include a duplicate ZONE?)

    # No need for DEVICE/DEVICE/ZONE; simply do a subdevice as DEVICE/ZONE

    chain inet_filter_postrouting_mangle_DEVICE {
        counter comment "End inbound DEVICE inet/filter/postrouting_mangle"
    }

