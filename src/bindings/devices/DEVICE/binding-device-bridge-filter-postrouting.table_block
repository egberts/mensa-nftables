# File:     bindings-device-bridge-filter-postrouting.table_block
# Path:     bindings/devices/DEVICE/
# Title:    Create regular chain and register with dispatcher of devices for bridge/filter/postrouting base chain
# Family:   bridge
# Type:     filter
# Hook:     postrouting
# Device:   DEVICE
# Priority: *
# Policy:   *
# Table:    filter_bridge
# Chain:    filter_bridge_postrouting
# Called by: binding/devices/DEVICE/device-bridge-filter-postrouting.chain_block
# Description:
#

    # Add/register a Device Interface-to-firewall dispatch registry
    map map_dispatch_bridge_filter_postrouting_devices {
        typeof iif : verdict
        elements = {
            # use goto, this is the final descendance
            $DEVICE_INTF_DEV : goto bridge_filter_postrouting_DEVICE,
        }
    }

    chain bridge_filter_postrouting_DEVICE {
        counter comment "BEGIN inbound DEVICE bridge/filter/postrouting"

        # DEVICE: Include rules strictly for all sub-zones/sub-devices having bridge/filter/postrouting regular chain
        include "bindings/devices/DEVICE/rules/bridge-filter-postrouting/*.rule"
    }
    # Split the chain so that other chains can be created (ie., dispatcher regular chain)


    # DEVICE/ZONE: Include all zones having this device bridge/filter/postrouting regular chain
    include "bindings/devices/DEVICE/zones/subzones-bridge-filter-postrouting.table_block"

    # ZONE: Include all zones having this device bridge/filter/postrouting regular chain
    # include "bindings/zones/zones-bridge-filter-postrouting.table_block"

    # (TODO: can we symbolically link to the parent zones/ZONE here, instead of include a duplicate ZONE?)

    # No need for DEVICE/DEVICE/ZONE; simply do a subdevice as DEVICE/ZONE

    chain bridge_filter_postrouting_DEVICE {
        counter comment "End inbound DEVICE bridge/filter/postrouting"
    }

