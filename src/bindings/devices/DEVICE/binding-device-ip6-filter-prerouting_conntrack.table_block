# File:     bindings-device-ip6-filter-prerouting_conntrack.table_block
# Path:     bindings/devices/DEVICE/
# Title:    Create regular chain and register with dispatcher of devices for ip6/filter/prerouting base chain
# Family:   ip6
# Type:     filter
# Hook:     prerouting
# Device:   DEVICE
# Priority: -210 ((-200) - 10)
# Policy:   *
# Table:    filter_ip6
# Chain:    filter_ip6_prerouting_conntrack
# Called by: binding/devices/DEVICE/device-ip6-filter-prerouting_conntrack.chain_block
# Description:
#

    # Add/register a Device Interface-to-firewall dispatch registry
    map map_dispatch_ip6_filter_prerouting_conntrack_devices {
        typeof iif : verdict
        elements = {
            # use goto, this is the final descendance
            $DEVICE_INTF_DEV : goto ip6_filter_prerouting_conntrack_DEVICE,
        }
    }

    chain ip6_filter_prerouting_conntrack_DEVICE {
        counter comment "BEGIN inbound DEVICE ip6/filter/prerouting_conntrack"

        # DEVICE: Include rules strictly for all sub-zones/sub-devices having ip6/filter/prerouting regular chain
        include "bindings/devices/DEVICE/rules/ip6-filter-prerouting_conntrack/*.rule"
    }
    # Split the chain so that other chains can be created (ie., dispatcher regular chain)


    # DEVICE/ZONE: Include all zones having this device ip6/filter/prerouting regular chain
    include "bindings/devices/DEVICE/zones/subzones-ip6-filter-prerouting_conntrack.table_block"

    # ZONE: Include all zones having this device ip6/filter/prerouting regular chain
    # include "bindings/zones/zones-ip6-filter-prerouting_conntrack.table_block"

    # (TODO: can we symbolically link to the parent zones/ZONE here, instead of include a duplicate ZONE?)

    # No need for DEVICE/DEVICE/ZONE; simply do a subdevice as DEVICE/ZONE

    chain ip6_filter_prerouting_conntrack_DEVICE {
        counter comment "End inbound DEVICE ip6/filter/prerouting_conntrack"
    }

