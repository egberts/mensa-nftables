# File:     bindings-device-bridge-filter-postrouting_filter.table_block
# Path:     bindings/devices/DEVICE/
# Title:    Regular chain with dispatcher for bridge/filter/postrouting for filter(-200) priority
# Family:   bridge
# Type:     filter
# Hook:     postrouting
# Device:   DEVICE
# Priority: -210 (filter(-200)-10)
# Policy:   *
# Table:    filter_bridge
# Chain:    filter_bridge_postrouting_filter
# Called by: binding/devices/DEVICE/device-bridge-filter-postrouting_filter.chain_block
# Description:
#

    # Add/register a Device Interface-to-firewall dispatch registry
    map map_dispatch_bridge_filter_postrouting_filter_devices {
        typeof oif : verdict
        elements = {
            # use goto, this is the final descendance
            $DEVICE_INTF_DEV : goto bridge_filter_postrouting_filter_DEVICE,
        }
    }

    chain bridge_filter_postrouting_filter_DEVICE {
        counter comment "BEGIN outbound DEVICE bridge/filter/postrouting_filter"

        # DEVICE: Include rules strictly for all sub-zones/sub-devices having bridge/filter/postrouting regular chain
        include "bindings/devices/DEVICE/rules/bridge-filter-postrouting_filter*/*.rule"
    }
    # Split the chain so that other chains can be created (ie., dispatcher regular chain)


    # DEVICE/ZONE: Include all zones having this device bridge/filter/postrouting regular chain
    include "bindings/devices/DEVICE/zones/subzones-bridge-filter-postrouting_filter.table_block"

    # ZONE: Include all zones having this device bridge/filter/postrouting regular chain
    # include "bindings/zones/zones-bridge-filter-postrouting_filter.table_block"

    # (TODO: can we symbolically link to the parent zones/ZONE here, instead of include a duplicate ZONE?)

    # No need for DEVICE/DEVICE/ZONE; simply do a subdevice as DEVICE/ZONE

    chain bridge_filter_postrouting_filter_DEVICE {
        counter comment "End outbound DEVICE bridge/filter/postrouting_filter"
    }

