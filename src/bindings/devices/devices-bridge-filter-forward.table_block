#
# File:     devices-bridge-filter-forward.table_block
# Path:     bindings/devices/
# Title:    Register all devices having bridge/filter/forward
# Family:   bridge
# Table:    bridge_filter
# Chain:    bridge_filter_forward
# Type:     filter
# Hook:     forward
# Priority: -10 (filter(0) - 10)
# Policy:   DROP
# Called by: hooks/hook-forward/base-bridge-filter-forward.base_chain
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

    # Pre-declare an interface-to-chain dispatcher for forward hook, bridge family, filter chain-type.
    map map_dispatch_bridge_filter_forward_devices {
        typeof iif : verdict
    }

    # Insert the jump lookup
    chain bridge_filter_forward {
        counter comment "device inbound bridge/filter/forward"
        iif vmap @map_dispatch_bridge_filter_forward_devices
        counter comment "device inbound bridge/filter/forward, post dispatch"
    }

    # Register all bridge_filter_forward devices
    include "bindings/devices/*/binding-device-bridge-filter-forward.table_block"

