#
# File:     devices-ip-filter-prerouting_raw.table_block
# Path:     bindings/devices/
# Title:    Register all devices having ip/filter/prerouting
# Family:   ip
# Type:     filter
# Hook:     prerouting
# Priority: -310 (raw(-300) - 10)
# Policy:   accept
# Table:    ip_filter
# Chain:    ip_filter_prerouting_raw
# Called by: hooks/hook-prerouting/base-ip-filter-prerouting_raw.base_chain
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

    # Pre-declare an interface-to-chain dispatcher for prerouting hook, ip family, filter chain-type.
    map map_dispatch_ip_filter_prerouting_raw_devices {
        typeof iif : verdict
    }

    # Insert the jump lookup
    chain ip_filter_prerouting_raw {
        counter comment "device inbound ip/filter/prerouting_raw"
        iif vmap @map_dispatch_ip_filter_prerouting_raw_devices
        counter comment "device inbound ip/filter/prerouting_raw, post dispatch"
    }

    # Register all ip_filter_prerouting_raw devices
    include "bindings/devices/*/binding-device-ip-filter-prerouting_raw.table_block"

