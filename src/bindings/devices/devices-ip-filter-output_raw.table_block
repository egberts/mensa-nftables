#
# File:     devices-ip-filter-output_raw.table_block
# Path:     bindings/devices/
# Title:    Register all devices having ip/filter/output
# Family:   ip
# Type:     filter
# Hook:     output
# Priority: -310 (raw(-300)-10)
# Policy:   DROP
# Table:    ip_filter
# Chain:    ip_filter_output_raw
# Called by: hooks/hook-output/base-ip-filter-output_raw.base_chain
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

    # Pre-declare an interface-to-chain dispatcher for output hook, ip family, filter chain-type.
    map map_dispatch_ip_filter_output_raw_devices {
        typeof iif : verdict
    }

    # Insert the jump lookup
    chain ip_filter_output_raw {
        counter comment "device inbound ip/filter/output_raw"
        iif vmap @map_dispatch_ip_filter_output_raw_devices
        counter comment "device inbound ip/filter/output_raw, post dispatch"
    }

    # Register all ip_filter_output_raw devices
    include "bindings/devices/*/binding-device-ip-filter-output_raw.table_block"

