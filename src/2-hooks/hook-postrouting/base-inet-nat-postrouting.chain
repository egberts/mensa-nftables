# File:     base-inet-nat-postrouting.chain
# Path:     2-hooks/hook-postrouting/
# Title:    Base chain for the postrouting hook (inet family, nat type)
# Family:   inet
# Table:    *
# Chain:    inet_nat_postrouting_security
# Type:     nat
# Hook:     postrouting
# Priority: various
# Policy: accept
# Called by: 1-types/nat-inet.table
# Description:
#
# VERSION: Stateful NAT available in Linux 5.2+
#

    # cannot use priority less than -300

    chain inet_nat_postrouting_mangle {
        type nat hook postrouting priority -150;
        policy accept;

    }

    chain inet_nat_postrouting_srcnat {
        type nat hook postrouting priority -100;
        policy accept;

        oifname $WAN_INTF_DEV masquerade
    }
