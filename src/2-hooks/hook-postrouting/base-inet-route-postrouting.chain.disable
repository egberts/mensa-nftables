# File:     base-inet-route-postrouting.chain
# Path:     2-hooks/hook-postrouting/
# Title:    Base chain for the postrouting hook (inet family, route type)
# Family:   inet
# Table:    *
# Chain:    inet_route_postrouting
# Type:     route
# Hook:     postrouting
# Priority: 300
# Policy: accept
# Called by: 1-types/route-inet.table
# Description:
#

    chain inet_route_postrouting {
        type nat hook postrouting priority 300;
        policy accept;

    }

