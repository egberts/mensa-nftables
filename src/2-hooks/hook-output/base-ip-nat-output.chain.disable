# File:     base-ip-nat-output.chain
# Path:     2-hooks/hook-output/
# Title:    Base chain for the output hook (ip family, nat type)
# Family:   ip
# Table:    *
# Chain:    ip_nat_output
# Type:     nat
# Hook:     output
# Priority: 5 (filter(0)+5, over Libvirt/Docker filter(0))
# Policy:   ACCEPT
# Called by: 1-types/nat-ip.table
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

    # Declare an interface-to-chain dispatcher for output hook
    map map_dispatch_ip_nat_output_interface {
        typeof oif : verdict
    }
    chain ip_nat_output {
        type nat hook output priority 5; policy accept;

        counter

        # dispatch map built by including/excluding chain-ip-nat-*.nft files
        oif vmap @map_dispatch_ip_nat_output_interface
    }

    # registers with 'map_dispatch_ip_nat_output_interface' dispatch mapper)
    include "./zones/zone-ip-nat-output-*.chain";

    # Post-interface output process
    chain ip_nat_output {
        counter
    }
