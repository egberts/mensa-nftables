# File:     base-ip-filter-prerouting-conntrack.chain
# Path:     2-hooks/hook-prerouting/
# Title:    Base chain for the prerouting hook (ip family, filter type) at ConnTrack priority
# Family:   ip
# Table:    *
# Chain:    ip_filter_prerouting_conntrack
# Type:     filter
# Hook:     prerouting
# Priority: -205 (conntrack (-200) - 5) (after inet(-210), same as ip(-205))
# Policy:   accept
# Called by: 1-types/filter-ip.table
# Description:
#

    chain ip_filter_prerouting_conntrack {
        type filter hook prerouting priority -205;
        policy accept;

    }
