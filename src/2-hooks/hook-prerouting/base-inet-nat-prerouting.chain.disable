# File:     base-inet-nat-prerouting.chain
# Path:     2-hooks/hook-prerouting/
# Title:    Base chain for the prerouting hook (inet family, nat type)
# Family:   inet
# Table:    *
# Chain:    inet_nat_prerouting_*
# Type:     nat
# Hook:     prerouting
# Priority: various
# Policy:   accept
# Called by: 1-types/nat-inet.table
# Description:
#

    chain inet_nat_prerouting_dstnat {
        type nat hook prerouting priority -100;
        policy accept;

    }

    chain inet_nat_prerouting_mangle {
        type nat hook prerouting priority -150;
        policy accept;

    }

    # cannot use priority <-300
