# File:     base-inet-filter-ingress.nft
# Path:     hooks/hook-ingress/
# Title:    ALL ingress hooks for inet family and filter chain-type
# Family:   inet
# Table:    *
# Chain:    *
# Type:     filter
# Hook:     ingress
# Priority: *
# Policy:   *
# Called by: types/filter-ingress.nft
# Description:
#     Scanning across all zones, picking up ingress chain candidates
#
#
# No base chain here, that's zone-specific (by chain 'device' interface)
#

    include "zones/*/zone-inet-filter-ingress.chain"  # wildcard is in zone name

