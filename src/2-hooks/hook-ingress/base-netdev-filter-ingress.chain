# File:     base-netdev-filter-ingress.nft
# Path:     2-hooks/hook-ingress/
# Title:    ALL ingress hooks for netdev family and filter chain-type
# Family:   netdev
# Table:    filter_netdev
# Chain:    filter_netdev_ingress
# Type:     filter
# Hook:     ingress
# Priority: *
# Policy:   *
# Called by: 1-types/filter-ingress.table
# Description:
#     Scanning across all zones, picking up ingress/egress chain candidates
#
# The device name must identify an existing network interface.
#
# 'netdev' is no longer automatically necessary just because
# early ingress filtering is available in 'inet' family.
# 'netdev' remains useful for interface-specific processing, egress
# processing and non-IP Ethernet traffic.
#
# Requires Linux kernel 5.16 or later for netdev egress.
#
# No table here yet, (still have 'ingress' and 'egress' to go)
# No base chain here yet, that's zone-specific (by chain 'device' interface)
#

    # no declarative base chain here, chain devices are used in 'ingress' and done later
    include "3-bindings/devices/*/binding-device-netdev-filter-ingress.chain"  # wildcard is in device name

    include "3-bindings/zones/*/binding-zone-netdev-filter-ingress.chain"  # wildcard is in zone name

