#!/usr/sbin/nft -f

flush ruleset

table inet filter {

    # Initial empty map declaration
    map map_dispatch_inet_filter_input_red_protocol {
        type inet_proto : verdict
    }

    # Append ICMP
    map map_dispatch_inet_filter_input_red_protocol {
        type inet_proto : verdict
        elements = {
            icmp : goto inet_filter_input_red_icmp
        }
    }

    # Append TCP
    map map_dispatch_inet_filter_input_red_protocol {
        type inet_proto : verdict
        elements = {
            tcp : goto inet_filter_input_red_tcp
        }
    }

    chain input {
        type filter hook input priority filter;
        policy drop;

        meta l4proto vmap @map_dispatch_inet_filter_input_red_protocol
    }

    chain inet_filter_input_red_icmp {
        counter accept
    }

    chain inet_filter_input_red_tcp {
        counter accept
    }
}

