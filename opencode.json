{
  "$schema": "https://opencode.ai/config.json",

  "permissions": [
    // Allow access outside the project, but only to specified system directories
    {
      "action": "external_directory",
      "resource": "/etc",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/etc/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/usr",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/usr/*",
      "effect": "allow"
    },

    // Allow reading /etc
    {
      "action": "read",
      "resource": "/etc",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "/etc/*",
      "effect": "allow"
    },

    // Allow reading /usr
    {
      "action": "read",
      "resource": "/usr",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "/usr/*",
      "effect": "allow"
    },

    // Explicitly prohibit modifications
    {
      "action": "edit",
      "resource": "/etc",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "/etc/*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "/usr",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "/usr/*",
      "effect": "deny"
    }
  ]
}
