# File:     zone-arp-filter-input-loopback.chain
# Path:     *
# Title:    Regular chain?
# Family:   arp
# Table:    *
# Chain:    arp_filter_input_loopback
# Type:     filter
# Hook:     input
# Priority: filter(0)
# Policy:   *
# Zone:     loopback
# Called by: hooks/hook-input/base-arp-filter-input.chain
# Description: Stateful inbound host firewall
#
    # Register a DeviceInterface-to-firewall dispatch registry
    map map_dispatch_arp_filter_input_interface {
        typeof iif : verdict
        elements = {
            # use goto, this is the final descendance
            $LOOPBACK_INTF_DEV : goto arp_filter_input_loopback,
        }
    }

    # no layer-7 protocol-specific dispatcher needed in ARP family
    chain arp_filter_input_loopback {

        counter comment "arp/filter/input/loopback"
    }

    include "./zones/loopback/arp-filter-input-loopback.chain"  # no wildcard

    chain arp_filter_input_loopback {
        # Log and count denied traffic.
        counter log prefix "DROP arp/filter/input/loopback unknown ARP packet in loopback zone: " drop
    }
