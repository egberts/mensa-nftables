# File:     zone-inet-filter-input-closednet.chain
# Path:     *
# Family:   inet
# Table:    *
# Chain:    inet_filter_input_closednet
# Type:     filter
# Hook:     input
# Priority: filter(0)
# Policy:   DROP
# Zone:     closednet
# Description:
#
#

    # Our fancy callback registry into the firewall
    # makes it easy to delete this file and not impact nft infrastructure
    map map_dispatch_inet_filter_input_interface {
        typeof iif : verdict
        elements = {
            $CLOSEDNET_INTF_DEV : jump inet_filter_input_closednet,
        }
    }

    chain inet_filter_input_closednet {
        counter log prefix "RETURN: inet/filter/input/closednet: " return
    }
