# File:     zone-inet-filter-output-loopback.chain
# Path:     *
# Family:   inet
# Table:    *
# Chain:    inet_filter_output_loopback
# Type:     filter
# Hook:     output
# Priority: filter(0)
# Policy:   DROP
# Zone:     loopback
# Description:
#
#

    # Register a DeviceInterface-to-firewall dispatch registry
    map map_dispatch_inet_filter_output_interface {
        typeof oif : verdict
        elements = {
            # use goto, this is the final descendance
            $LOOPBACK_INTF_DEV : goto inet_filter_output_loopback,
        }
    }

    # no layer-7 protocol-specific dispatcher needed in ARP family
    chain inet_filter_output_loopback {

        counter comment "inet/filter/output/loopback"
    }

    include "./zones/loopback/inet-filter-output-loopback.chain"  # no wildcard

    chain inet_filter_output_loopback {

       # Log and count denied traffic.
        counter log prefix "DROP inet/filter/output/loopback unknown ARP in loopback zone: " drop
    }
