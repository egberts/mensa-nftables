# File:     zone-arp-filter-input-red.chain
# Path:     *
# Title:    Regular chain?
# Family:   arp
# Table:    *
# Chain:    arp_filter_input_red
# Type:     filter
# Hook:     input
# Priority: filter(0)
# Policy:   *
# Zone:     red
# Called by: ./hooks/hook-input/base-arp-filter-input.chain
# Description: Stateful inbound host firewall
#
    # Register a DeviceInterface-to-firewall dispatch registry
    map map_dispatch_arp_filter_input_interface {
        typeof iif : verdict
        elements = {
            # use goto, this is the final descendance
            $WAN_INTF_DEV : goto arp_filter_input_red,
        }
    }

    # no layer-7 protocol-specific dispatcher needed in ARP family
    chain arp_filter_input_red {

        counter comment "arp/filter/input/red"

    }
    include "./zones/red/arp-filter-input-red.chain"  # no wildcard

    chain arp_filter_input_red {
        # Log and count denied traffic.
        counter log prefix "DROP arp/filter/input/red unknown ARP packet in red zone: " drop
    }
