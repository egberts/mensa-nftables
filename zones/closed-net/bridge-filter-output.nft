#!/usr/bin/env nft -f
#
# File:        bridge-filter-output.nft
# Path:        /etc/nftables/bridge
# Family:      bridge
# Table:       bridge_filter
# Chain:       bridge_filter_output
# Type:        filter
# Hook:        output
# Priority:    filter (0)
# Policy:      DROP
# Description: Filters Ethernet frames generated by the local host.
#
# Hook:
#   Processes Ethernet frames generated by the local host and
#   transmitted through a bridge device.
#
# Priority:
#   Filter (0) places the chain at the conventional filtering priority.
#
# Scope:
#   Applies to locally generated Ethernet traffic leaving through
#   a bridge, including ARP, IPv4, IPv6, and other Ethernet protocols.
#

table bridge bridge_filter {

    chain bridge_filter_output {

        type filter hook output priority filter; policy drop

        counter

        limit rate 5/second log prefix "DROP bridge-filter-output: "
    }
}