#!/usr/bin/env nft -f
#
# File:        arp-filter-output.nft
# Path:        /etc/nftables/arp
# Family:      arp
# Table:       arp_filter
# Chain:       arp_filter_output
# Type:        filter
# Hook:        output
# Priority:    filter (0)
# Policy:      DROP
# Called by: none
# Description: Filters locally generated ARP packets before transmission.
#
# Hook:
#   Processes ARP packets generated by the local host before they are
#   transmitted through a network interface.
#
# Priority:
#   Filter (0) places the chain at the conventional filtering priority.
#
# ARP Hardware Types (htype):
#
#   Value  Hardware Type
#   -----  -------------------------------
#       0  NET/ROM
#       1  Ethernet
#       2  Experimental Ethernet
#       3  AX.25
#       4  PROnet token ring
#       5  Chaosnet
#       6  IEEE 802.2
#       7  ARCnet
#       8  AppleTalk
#      15  Frame Relay DLCI
#      19  ATM
#      23  Metricom STRIP
#      24  IEEE 1394
#      27  EUI-64
#      32  InfiniBand
#     256  SLIP
#     257  CSLIP
#     258  SLIP6
#     259  CSLIP6
#     260  Reserved KISS
#     264  Adaptive serial line
#     270  ROSE
#     271  X.25
#     272  Hardware X.25
#     280  CAN
#     290  MCTP
#     512  PPP
#     513  Cisco HDLC
#     516  LAPB
#     517  DDCMP
#     518  Raw HDLC
#     519  Raw IP
#     768  IP-in-IP tunnel
#     769  IPv6-in-IPv6 tunnel
#     770  Frame Relay Access Device
#     771  SKIP
#     772  Loopback
#     773  LocalTalk
#     774  FDDI
#     775  AP1000 BIF
#     776  SIT (IPv6-in-IPv4)
#     777  IP over DDP
#     778  GRE over IPv4
#     779  PIM register
#     780  HIPPI
#     781  Nexus Ash
#     782  Econet
#     783  IrDA
#     784  Fibre Channel point-to-point
#     785  Fibre Channel arbitrated loop
#     786  Fibre Channel public loop
#     787  Fibre Channel fabric
#     800  IEEE 802.5 token ring
#     801  IEEE 802.11 wireless
#     802  IEEE 802.11 Prism2
#     803  IEEE 802.11 radiotap
#     804  IEEE 802.15.4
#     805  IEEE 802.15.4 monitor
#     820  PhoNet
#     821  PhoNet pipe
#     822  CAIF
#     823  GRE over IPv6
#   65534  No link-layer header
#   65535  Void / unknown
#
# Note:
#   htype values are Linux ARPHRD_* identifiers. nftables expects
#   numeric values in arp htype expressions.
#

table arp filter {

    chain output {

        type filter hook output priority filter; policy drop;

        # Reject group/multicast sender MAC addresses.
        arp saddr ether & 01:00:00:00:00:00 != 00:00:00:00:00:00 counter drop

        # Reject zero sender MAC addresses.
        arp saddr ether 00:00:00:00:00:00 counter drop

        # Permit Ethernet/IPv4 ARP on authorized interfaces.
        oif { "eno2", "wlo1" } arp htype 1 arp ptype ip arp hlen 6 arp plen 4 arp operation { request, reply } counter accept

        # Audit and drop everything else.
        limit rate 5/minute log prefix "DROP arp-filter-output: "
        counter drop
    }
}
