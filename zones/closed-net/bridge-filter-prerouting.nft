#!/usr/bin/env nft -f
#
# File:        bridge-filter-prerouting.nft
# Path:        /etc/nftables/bridge
# Family:      bridge
# Table:       bridge_filter
# Chain:       bridge_filter_prerouting
# Type:        filter
# Hook:        prerouting
# Priority:    filter (0)
# Policy:      DROP
# Description: Filters incoming Ethernet frames before bridge forwarding decisions.
#
# Hook:
#   Processes Ethernet frames as they enter a bridge port, before
#   the bridge determines whether they are destined for local
#   delivery or forwarding to another bridge port.
#
# Priority:
#   Filter (0) places the chain at the conventional filtering priority.
#
# Scope:
#   Applies to incoming bridged Ethernet traffic, including ARP,
#   IPv4, IPv6, and other Ethernet protocols.
#
# WARNING:
# One policy caveat: DROP on prerouting or postrouting affects more
# than transit traffic. Those hooks also see frames that may subsequently
# be delivered locally or transmitted from the local host, respectively.
# The input, output, and forward hooks provide the more specific traffic-path
# filtering points.
#
# Rule of Thumb: Use prerouting and postrouting almost exclusively
# for NAT (Network Address Translation) and packet mangling, but
# leave packet filtering and dropping to input, output, and forward.
#

table bridge bridge_filter {
    chain bridge_filter_prerouting {
        type filter hook prerouting priority filter; policy drop

        counter

        limit rate 5/second log prefix "DROP bridge-filter-prerouting: "
    }
}