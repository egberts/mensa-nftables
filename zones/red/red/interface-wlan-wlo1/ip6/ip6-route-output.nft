#!/usr/bin/env nft -f
#
# File:        ip6-route-output.nft
# Path:        /etc/nftables/ip6
# Family:      ip6
# Table:       ip6_route
# Chain:       ip6_route_output
# Type:        route
# Hook:        output
# Priority:    mangle (-150)
# Policy:      ACCEPT
# Description: IPv6 routing policy for locally generated traffic
#
# The output hook sees IPv6 packets generated by local processes.
#
# Unlike filter/output, a route-type output chain is specifically
# intended for modifying packet fields that may affect routing.
# Changes to relevant packet fields cause the routing decision
# to be reconsidered.
#
# Priority mangle (numeric -150) is the conventional choice.
#
# Control                         Routing purpose
# Packet marking                  Associates packets with policy-routing rules
# DSCP modification               Classifies traffic for routing policy
# Traffic segregation             Separates traffic into routing classes
# VPN routing                     Directs selected traffic through VPN gateways
# Multi-WAN routing                Selects alternate routing paths
#
# This chain operates on locally generated IPv6 traffic.
# Use ip6/route/output for packet modifications that require
# a subsequent routing decision.
#
# IMPORTANT:
# A packet mark alone does not configure policy routing.
# Corresponding ip -6 rule and ip -6 route entries are required.
#
# This is not a packet-filtering chain. Use ip6/filter/output
# to enforce outbound access policy.
#
# Examples of uses for ip6 / route / output include:
# - Policy-based routing:
#     Set packet marks used by IPv6 policy-routing rules.
# - VPN split tunneling:
#     Direct selected locally generated traffic through a VPN table.
# - Multi-WAN routing:
#     Select alternate routing tables for designated traffic.
# - Traffic segregation:
#     Assign routing marks to different traffic classes.
# - DSCP-based routing:
#     Modify DSCP values used by routing policy.
#
# Routing policy must be configured separately using ip -6 rule
# and ip -6 route.
#

table ip6 ip6_route {

    chain ip6_route_output {

        type route hook output priority mangle; policy accept;

        # Mark traffic for policy-based routing.
        # ip6 daddr 2001:db8:100::/48 meta mark set 0x10

        # Mark traffic designated for VPN routing.
        # ip6 daddr 2001:db8:200::/48 meta mark set 0x20

        # Mark traffic for an alternate WAN routing table.
        # ip6 daddr 2001:db8:300::/48 meta mark set 0x30

        # Modify DSCP for designated traffic.
        # ip6 daddr 2001:db8:400::/48 ip6 dscp set cs1

        counter comment "ip6-route-output"
    }
}