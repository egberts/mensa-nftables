#!/usr/bin/env nft -f
#
# File:        ip6-filter-postrouting.nft
# Path:        /etc/nftables/ip6
# Family:      ip6
# Table:       ip6_filter
# Chain:       ip6_filter_postrouting
# Type:        filter
# Hook:        postrouting
# Priority:    filter (0)
# Policy:      DROP
# Description: Stateful IPv6 egress packet firewall
#
# The postrouting hook sees outgoing IPv6 packets after the
# routing decision, immediately before transmission.
#
# Priority filter (numeric 0) is the conventional choice.
#
# Control                         Security purpose
# Invalid state rejection         Rejects invalid connection-tracking traffic
# Established/related             Permits tracked return and related traffic
# ICMPv6 error handling            Supports IPv6 network diagnostics and PMTU
# Neighbor Discovery              Supports IPv6 address resolution
# Router Advertisements           Supports IPv6 router operation
# DHCPv6 requests                 Permits DHCPv6 client requests
# Logging and counters             Provides an audit trail
#
# This chain enforces IPv6 egress traffic after routing.
# Use ip6/filter/output for locally generated traffic before routing
# and ip6/filter/forward for traffic routed through the host.
#
# IMPORTANT:
# At priority filter (0), source NAT has not yet run.
# Source-address matching therefore sees the pre-SNAT address
# when SNAT is configured.
#
# Do not indiscriminately block ICMPv6. IPv6 depends on ICMPv6
# for Neighbor Discovery, Router Discovery, and Path MTU Discovery.
#
# Examples of uses for ip6 / filter / postrouting include:
# - Egress filtering:
#     Restrict traffic leaving specific network interfaces.
# - Source validation:
#     Restrict outgoing traffic to authorized IPv6 source prefixes.
# - Connection-state enforcement:
#     Reject invalid traffic before transmission.
# - ICMPv6 handling:
#     Permit essential error messages and Neighbor Discovery.
# - Network segregation:
#     Enforce egress policy between routed network segments.
#
# The routing decision has already selected the outgoing interface.
# Use oifname for outgoing-interface matching.
#
# Both locally generated and forwarded packets traverse this hook.
#

table ip6 ip6_filter {
    chain ip6_filter_postrouting {
        type filter hook postrouting priority filter; policy drop;

        # Invalid connection state
        ct state invalid drop

        # Established and related connections
        ct state established,related accept

        # Essential ICMPv6 errors
        icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem } accept

        # Neighbor Discovery
        icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert } ip6 hoplimit 255 accept

        # Router Advertisement (router deployments)
        # icmpv6 type nd-router-advert ip6 hoplimit 255 accept

        # Router Solicitation (SLAAC clients)
        # icmpv6 type nd-router-solicit ip6 hoplimit 255 accept

        # DHCPv6 client requests
        # udp sport 546 udp dport 547 accept

        # DHCPv6 server responses
        # udp sport 547 udp dport 546 accept

        # Explicitly authorized locally generated traffic
        # oifname "wan0" udp dport 53 accept
        # oifname "wan0" tcp dport { 53, 80, 443 } accept
        # oifname "wan0" udp dport 123 accept

        # Explicitly authorized forwarded traffic
        # iifname "lan0" oifname "wan0" ip6 saddr fd00:1234::/64 ct state new accept

        # Rate-limited logging
        limit rate 5/second burst 10 packets log prefix "DROP ip6-filter-postrouting: "

        # Default drop
        drop
    }
}