#!/usr/bin/env nft -f
#
# File:        ip6-nat-postrouting.nft
# Path:        /etc/nftables/ip6
# Family:      ip6
# Table:       ip6_nat
# Chain:       ip6_nat_postrouting
# Type:        nat
# Hook:        postrouting
# Priority:    srcnat (100)
# Policy:      ACCEPT
# Description: IPv6 source NAT for outgoing traffic
#
# The postrouting hook sees IPv6 packets after the routing
# decision, immediately before transmission.
#
# Priority srcnat (numeric 100) is the conventional source-NAT
# priority, after the conventional filter priority (0).
#
# NAT chains process only the first packet of each connection.
# Connection tracking maintains the resulting NAT binding for
# subsequent packets.
#
# Examples of uses for ip6 / nat / postrouting include:
# - Static source NAT:
#     Translate outgoing source addresses to a designated IPv6 address.
# - Source address translation:
#     Apply source translation to selected outgoing connections.
# - Source port translation:
#     Translate source ports when required.
# - Network address sharing:
#     Apply source translation to traffic leaving a designated interface.
#
# IMPORTANT:
# NAT chains are not packet-filtering chains.
# Use ip6/filter/output and ip6/filter/forward to enforce egress policy.
#
# NAT chain policies should remain ACCEPT. Do not use policy DROP
# as a substitute for a filtering chain.
#
# SNAT and masquerade are supported at the postrouting hook.
#

table ip6 ip6_nat {

    chain ip6_nat_postrouting {

        type nat hook postrouting priority srcnat; policy accept;

        # Apply static source NAT to outgoing traffic.
        # oifname "wan0" ip6 saddr fd00:1234::/64 snat to 2001:db8::1

        # Apply masquerading to outgoing traffic.
        # oifname "wan0" ip6 saddr fd00:1234::/64 masquerade

        counter comment "ip6-nat-postrouting"
    }
}