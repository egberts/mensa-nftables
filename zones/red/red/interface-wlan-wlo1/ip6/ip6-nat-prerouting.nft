#!/usr/bin/env nft -f
#
# File:        ip6-nat-prerouting.nft
# Path:        /etc/nftables/ip6
# Family:      ip6
# Table:       ip6_nat
# Chain:       ip6_nat_prerouting
# Type:        nat
# Hook:        prerouting
# Priority:    dstnat (-100)
# Policy:      ACCEPT
# Description: IPv6 destination NAT for incoming traffic
#
# The prerouting hook sees incoming IPv6 packets before the
# routing decision determines whether they are locally delivered
# or forwarded.
#
# Priority dstnat (numeric -100) is the conventional destination-NAT
# priority, after connection tracking.
#
# NAT chains process only the first packet of each connection.
# Connection tracking maintains the resulting NAT binding for
# subsequent packets.
#
# Examples of uses for ip6 / nat / prerouting include:
# - Port forwarding:
#     Translate incoming service ports to internal IPv6 servers.
# - Destination translation:
#     Translate incoming destination addresses.
# - Service redirection:
#     Redirect incoming connections to alternate service endpoints.
# - Transparent DNS redirection:
#     Redirect incoming DNS requests to an authorized resolver.
#
# IMPORTANT:
# NAT chains are not packet-filtering chains.
# Use ip6/filter/input and ip6/filter/forward to enforce traffic policy.
#
# NAT chain policies should remain ACCEPT. Do not use policy DROP
# as a substitute for a filtering chain.
#
# DNAT and redirect are supported at the prerouting hook.
#

table ip6 ip6_nat {

    chain ip6_nat_prerouting {

        type nat hook prerouting priority dstnat; policy accept;

        # Forward an incoming service connection to an internal server.
        # iifname "wan0" tcp dport 443 dnat to [2001:db8::10]:443

        # Redirect incoming DNS queries to an internal resolver.
        # iifname "lan0" udp dport 53 dnat to 2001:db8::53

        counter comment "ip6-nat-prerouting"
    }
}