#!/usr/bin/env nft -f
#
# File:        inet-filter-prerouting.nft
# Path:        /etc/nftables/inet
# Family:      inet
# Table:       inet_filter
# Chain:       inet_filter_prerouting
# Type:        filter
# Hook:        prerouting
# Priority:    filter (0)
# Policy:      DROP
# Description: Early inbound packet enforcement
#
# not a replacement for your input and forward chains.
#
# For inet / filter / prerouting, the chain controls
# incoming packets before the routing decision.
#
# Unlike input, which handles packets destined for the
# local system, prerouting sees both locally destined
# packets and packets that may be forwarded.
#
# Priority: filter (numeric 0) is the conventional choice.
#
# At priority filter (0), connection tracking and
# destination NAT have already run. Destination-address
# rules therefore see the translated destination when
# DNAT applies.
#
# Control                         Security purpose
# Invalid state rejection         Rejects invalid connection-tracking traffic
# Loopback acceptance             Preserves loopback traffic
# Established/related             Permits tracked return and related traffic
# Explicit ingress authorization  Restricts incoming interfaces and destinations
# ICMP/ICMPv6                     Supports necessary network control traffic
# DHCP responses                  Permits DHCP client responses
# Logging and counters            Provides an audit trail
#
# IMPORTANT:
# This chain sees both locally destined and forwarded packets.
# Rules must account for both traffic paths.
#
# Filtering at priority filter (0) occurs after destination
# NAT at priority dstnat (-100).
#
# This is a hardening baseline, not a Common Criteria certification.
#
# For example:
# - Transparent HTTP proxy: intercept TCP port 80 and
#        deliver it to a local proxy.
# - Transparent HTTPS proxy: intercept TCP port 443
#        for TLS inspection, subject to certificate trust and
#        client configuration.
# - TLS MitM inspection: a proxy such as mitmproxy can
#        terminate the client TLS connection and establish a
#        separate upstream TLS connection. This requires
#        clients to trust the proxy's CA certificate;
#        interception alone does not decrypt TLS.
# - Transparent content filtering: route selected web
#        traffic through a local filtering proxy.
# - Transparent application-layer inspection: direct
#        selected traffic to a proxy or inspection service
#        without requiring client proxy configuration.


table inet inet_filter {

    chain inet_filter_prerouting {

        type filter hook prerouting priority filter; policy drop;

        # Reject invalid connection states.
        ct state invalid counter drop

        # Accept loopback traffic.
        iifname "lo" counter accept

        # Accept established and related traffic.
        ct state { established, related } counter accept

        # Explicitly authorized NEW inbound and forwarded traffic goes here.
        # Examples must be adapted to the actual host/network.
        # Use iifname to restrict the ingress interface.
        # Account for DNAT when matching destination addresses.

        # mDNS locally
        ip6 saddr $LAN_INTF_LOCALNET udp sport 5353 udp dport 5353 accept

        # Permit IPv4 ICMP error messages.
        ip protocol icmp icmp type { destination-unreachable, time-exceeded, parameter-problem } counter accept

        # Permit IPv6 ICMP error messages.
        icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem } counter accept

        # Permit IPv6 Neighbor Discovery and Router Advertisements.
        icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert } ip6 hoplimit 255 counter accept

        # Permit DHCPv4 client responses (if DHCP client).
        udp sport 67 udp dport 68 counter accept

        # Permit DHCPv6 client responses (if DHCPv6 client).
        udp sport 547 udp dport 546 counter accept

        # Log and count denied traffic.
        limit rate 5/second log prefix "DROP inet-filter-prerouting: "
        counter drop comment "inet-filter-prerouting DROP"
    }
}