#!/usr/bin/env nft -f
#
# File:        inet-nat-output.nft
# Path:        /etc/nftables/inet
# Family:      inet
# Table:       inet_nat
# Chain:       inet_nat_output
# Type:        nat
# Hook:        output
# Priority:    -100 (destination NAT)
# Policy:      ACCEPT
# Description: Destination NAT for locally generated packets
#
# The output hook sees packets generated by local processes.
#
# Unlike prerouting, output does not see packets arriving
# from network interfaces.
#
# NAT chains process only the first packet of a connection.
# Subsequent packets use the established NAT binding.
#
# Priority -100 places this chain after connection tracking
# (-200) and before the conventional filter priority (0).
#
# Destination NAT in output can change the destination address
# or port of locally generated connections. The routing decision
# is updated to account for the translated destination.
#
# Control                 Security purpose
# Destination NAT         Translates destinations of locally generated traffic
# Local redirection       Redirects locally generated connections to local services
# Service remapping       Changes destination ports or addresses
# Counters                Counts connections initiating NAT translation
#
# This chain performs NAT, not packet filtering.
# Use inet/filter/output for outbound packet enforcement.
#
# NAT chains are for address translation, not packet filtering.
# Only the first packet of a connection traverses a NAT chain;
# subsequent packets use the established NAT binding.
#
# NAT chains should not implement a default-deny filtering policy.
#
# OPERATIONAL CONSEQUENCE: Because this chain runs at priority
# -100, a conventional output filter chain at priority 0
# evaluates packets after destination translation.
#
# Examples of uses for inet / nat / output include:
# - Local DNS redirection:
#     Redirect locally generated DNS requests to a designated
#     local DNS resolver or alternate DNS service.
# - Transparent proxy redirection:
#     Redirect locally generated HTTP connections to a local
#     proxy listening on a different port.
# - Service endpoint remapping:
#     Translate a locally requested destination address or port
#     to an alternate service endpoint.
# - Local development and testing:
#     Redirect connections intended for a remote service to
#     a local test instance.
# - Alternate service routing:
#     Redirect selected locally generated connections to an
#     alternate server or service address.
#

table inet inet_nat {

    chain inet_nat_output {

        type nat hook output priority -100; policy accept;

        # Add applicable DNAT or redirect rules here.

        counter comment "inet-nat-output (per connection)"
    }
}