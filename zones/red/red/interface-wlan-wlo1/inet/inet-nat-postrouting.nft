#!/usr/bin/env nft -f
#
# File:        inet-nat-postrouting.nft
# Path:        /etc/nftables/inet
# Family:      inet
# Table:       inet_nat
# Chain:       inet_nat_postrouting
# Type:        nat
# Hook:        postrouting
# Priority:    srcnat (100)
# Policy:      ACCEPT
# Description: Source NAT for outgoing packets
#
# The postrouting hook sees packets after the routing decision,
# immediately before they leave the local system.
#
# Unlike output, postrouting sees both locally generated
# packets and forwarded packets.
#
# NAT chains process only the first packet of a connection.
# Subsequent packets use the established NAT binding.
#
# Priority srcnat (100) places this chain after the conventional
# filter priority (0).
#
# Source NAT changes the source address or port of outgoing
# packets before transmission.
#
# Control                 Security purpose
# Source NAT              Translates outgoing source addresses
# Masquerading            Uses the outgoing interface address for translation
# Port translation        Changes source transport-layer ports
# Counters                Counts connections initiating NAT translation
#
# This chain performs NAT, not packet filtering.
# Use inet/filter/output and inet/filter/forward for packet enforcement.
#
# NAT chains are for address translation, not packet filtering.
# Only the first packet of a connection traverses a NAT chain;
# subsequent packets use the established NAT binding.
#
# NAT chains should not implement a default-deny filtering policy.
#
# OPERATIONAL CONSEQUENCE: Because this chain runs at
# priority srcnat (100), conventional output and forward
# filter chains at priority 0 evaluate packets before
# source address translation occurs.
#
# Examples of uses for inet / nat / postrouting include:
# - Internet connection sharing:
#     Masquerade private-network addresses using the outgoing
#     interface address.
# - Static source NAT:
#     Translate an internal source address to a designated
#     public or external address.
# - Source address pooling:
#     Distribute outgoing connections across a configured
#     range of source addresses.
# - Source port translation:
#     Translate source transport-layer ports when required
#     to avoid port conflicts or accommodate network mappings.
# - Multi-network NAT:
#     Apply different source translations according to the
#     originating subnet and outgoing interface.
#

table inet inet_nat {

    chain inet_nat_postrouting {

        type nat hook postrouting priority srcnat; policy accept;

        # Add applicable SNAT or masquerade rules here.

        counter comment "inet-nat-postrouting (per connection)"
    }
}