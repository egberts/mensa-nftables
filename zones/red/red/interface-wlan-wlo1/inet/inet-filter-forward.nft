#!/usr/bin/env nft -f
#
# File:        inet-filter-forward.nft
# Path:        /etc/nftables/inet
# Family: inet
# Table: inet_filter
# Chain: inet_filter_forward
# Type:  filter
# Hook:  forward
# Priority: filter(0)
# Policy: DROP
# Description:
#

table inet inet_filter {

    chain inet_filter_forward {

        type filter hook forward priority filter; policy drop

        # Reject invalid connection states.
        ct state invalid counter drop

        # Permit established and related traffic.
        ct state { established, related } counter accept

        # Permit new connections initiated from the trusted LAN.
        iifname "lan0" oifname "wan0" ip saddr 192.168.1.0/24 ct state new counter accept

        # Permit IPv6 connections initiated from the trusted LAN.
        iifname "lan0" oifname "wan0" ip6 saddr 2001:db8:1::/64 ct state new counter accept

        # Log remaining denied forwarding traffic.
        limit rate 5/second log prefix "DROP inet-filter-forward: " counter
    }
}
