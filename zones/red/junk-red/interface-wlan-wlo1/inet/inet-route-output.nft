#!/usr/bin/env nft -f
#
# File:        ip-route-output.nft
# Path:        /etc/nftables/ip
# Family:      ip
# Table:       ip_route
# Chain:       ip_route_output
# Type:        route
# Hook:        output
# Priority:    mangle (-150)
# Policy:      ACCEPT
# Description: Routing policy enforcement for locally generated packets
#
# The output hook sees packets generated by local processes.
#
# Route chains allow changes to routing-relevant packet fields
# to trigger a new route lookup.
#
# Unlike nat chains, route chains process packets throughout
# their traversal rather than only the first packet of a connection.
#
# Priority mangle (-150) is a conventional choice for packet
# modifications before the final route lookup.
#
# Control                 Security purpose
# Packet marking          Assigns marks for policy-based routing
# Routing classification Selects alternate routing paths
# VPN routing             Directs selected traffic through a VPN
# Multi-WAN routing       Selects an alternate network gateway
# Counters                Tracks packets subject to routing policies
#
# This chain performs routing-related packet modifications,
# not NAT or packet filtering.
# Use filter chains for packet enforcement.
#
# Examples of uses for ip / route / output include:
# - Policy-based routing:
#     Mark locally generated packets to select an alternate
#     routing table through ip rule and ip route.
# - VPN split tunneling:
#     Mark selected destinations to route traffic through
#     a VPN interface or gateway.
# - Multi-WAN routing:
#     Assign packet marks to select between multiple
#     Internet connections.
# - Traffic segregation:
#     Direct selected applications or destination networks
#     through dedicated routing tables.
# - Alternate gateway selection:
#     Mark traffic to use a designated gateway rather
#     than the default routing path.
#
# IMPORTANT:
# Packet marks alone do not configure routing.
# Corresponding policy-routing rules and routing-table
# entries must also be configured using ip rule and ip route.
#

table ip ip_route {

    chain ip_route_output {

        type route hook output priority mangle; policy accept;

        # Add applicable packet-marking rules here.

        counter comment "ip-route-output"
    }
}