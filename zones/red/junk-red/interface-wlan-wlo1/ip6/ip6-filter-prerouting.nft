#!/usr/bin/env nft -f
#
# File:        ip6-filter-prerouting.nft
# Path:        /etc/nftables/ip6
# Family:      ip6
# Table:       ip6_filter
# Chain:       ip6_filter_prerouting
# Type:        filter
# Hook:        prerouting
# Priority:    filter (0)
# Policy:      DROP
# Description: Stateful IPv6 ingress packet firewall
#
# The prerouting hook sees incoming IPv6 packets before the
# routing decision determines whether they are locally delivered
# or forwarded.
#
# Priority filter (numeric 0) is the conventional choice.
#
# Control                         Security purpose
# Invalid state rejection         Rejects invalid connection-tracking traffic
# Established/related             Permits tracked return and related traffic
# ICMPv6 error handling            Supports IPv6 network diagnostics and PMTU
# Neighbor Discovery              Supports IPv6 address resolution
# Router Advertisements           Supports IPv6 autoconfiguration
# DHCPv6 responses                Permits DHCPv6 client responses
# Logging and counters             Provides an audit trail
#
# This chain enforces IPv6 ingress traffic before the routing
# decision. Use ip6/filter/input for locally delivered traffic
# and ip6/filter/forward for routed traffic.
#
# IMPORTANT:
# At priority filter (0), conntrack and destination NAT have
# already run. Destination matching therefore sees translated
# addresses when DNAT is configured.
#
# Do not indiscriminately block ICMPv6. IPv6 depends on ICMPv6
# for Neighbor Discovery, Router Discovery, and Path MTU Discovery.
#
# Examples of uses for ip6 / filter / prerouting include:
# - Ingress filtering:
#     Reject unwanted traffic arriving on specific interfaces.
# - Source validation:
#     Restrict incoming traffic to authorized IPv6 source prefixes.
# - Connection-state enforcement:
#     Reject invalid traffic before the routing decision.
# - ICMPv6 handling:
#     Permit essential error messages and Neighbor Discovery.
# - Destination filtering:
#     Restrict access to translated or untranslated destination addresses.
#
# This hook does not yet have an outgoing-interface routing decision.
# Use iifname for incoming-interface matching.
#

table ip6 ip6_filter {

    chain ip6_filter_prerouting {

        type filter hook prerouting priority filter; policy drop;

        # Invalid connection state
        ct state invalid drop

        # Established and related connections
        ct state established,related accept

        # Essential ICMPv6 errors
        icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem } accept

        # Neighbor Discovery
        icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert } ip6 hoplimit 255 accept

        # Router Advertisement (SLAAC networks)
        # icmpv6 type nd-router-advert ip6 hoplimit 255 accept

        # Router Solicitation (router deployments)
        # icmpv6 type nd-router-solicit ip6 hoplimit 255 accept

        # DHCPv6 client responses
        udp sport 547 udp dport 546 accept

        # Explicitly authorized new inbound traffic
        iifname "wan0" ip6 daddr 2001:db8::10 tcp dport 443 ct state new accept

        # Explicitly authorized forwarded traffic
        iifname "lan0" ip6 saddr fd00:1234::/64 ct state new accept

        # Rate-limited logging
        limit rate 5/second burst 10 packets log prefix "DROP ip6-filter-prerouting: "

        # Default drop
        drop
    }
}