#!/usr/bin/env nft -f
#
# File:        ip6-filter-forward.nft
# Path:        /etc/nftables/ip6
# Family:      ip6
# Table:       ip6_filter
# Chain:       ip6_filter_forward
# Type:        filter
# Hook:        forward
# Priority:    filter (0)
# Policy:      DROP
# Description: Stateful IPv6 forwarding enforcement
#
# The forward hook sees IPv6 packets routed through the
# local system toward another network interface.
#
# Unlike input, forward handles packets not destined for
# the local system.
#
# Priority filter (numeric 0) is the conventional choice.
# Connection tracking has already processed the packets.
#
# Control                         Security purpose
# Invalid state rejection         Rejects invalid connection-tracking traffic
# Established/related             Permits tracked return and related traffic
# Explicit forwarding authorization Restricts permitted forwarding paths
# ICMPv6 error handling            Supports IPv6 network diagnostics and PMTU
# Logging and counters             Provides an audit trail
#
# This chain enforces IPv6 forwarding policy.
# Use ip6/filter/input for traffic destined for the host.
#
# IMPORTANT:
# Forwarding requires IPv6 forwarding to be enabled in
# the kernel (net.ipv6.conf.all.forwarding).
#
# Neighbor Discovery traffic is link-local and is not
# normally forwarded between interfaces.
#
# Examples of uses for ip6 / filter / forward include:
# - LAN-to-WAN forwarding:
#     Permit authorized internal IPv6 networks to access
#     external IPv6 destinations.
# - Inter-VLAN routing:
#     Restrict IPv6 traffic forwarded between VLANs.
# - Network segmentation:
#     Prevent unauthorized communication between
#     separate internal IPv6 networks.
# - VPN forwarding:
#     Permit selected IPv6 traffic between VPN and LAN
#     interfaces.
# - ICMPv6 error handling:
#     Permit essential destination-unreachable,
#     packet-too-big, time-exceeded, and parameter-problem
#     messages.
# - Egress restrictions:
#     Restrict forwarded IPv6 traffic by source network,
#     destination network, protocol, and service port.
#
# Operational notes:
# - The example forwarding rules are commented out
#        intentionally. Replace the example interfaces and
#        prefixes with actual network values before enabling them.
# - IPv6 forwarding must be enabled separately; the firewall
#        chain does not enable routing.
# - Do not add Neighbor Solicitation or Neighbor
#        Advertisement acceptance here as a general rule.
#        Those messages are handled on their respective links,
#        not routed through the forwarding hook.
#
# New forwarding connections must be explicitly authorized.
#

table ip6 ip6_filter {

    chain ip6_filter_forward {

        type filter hook forward priority filter; policy drop;

        # Reject invalid connection states.
        ct state invalid counter drop

        # Accept established and related connections.
        ct state { established, related } counter accept

        # Permit essential IPv6 ICMP error messages.
        icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem } counter accept

        # Explicitly authorized NEW forwarding traffic goes here.
        # Example: LAN-to-WAN forwarding (adapt interfaces and prefix).
        # iifname "lan0" oifname "wan0" ip6 saddr fd00:1234::/64 ct state new counter accept

        # Example: authorized forwarding between internal networks.
        # iifname "lan0" oifname "dmz0" ip6 daddr 2001:db8:100::/64 ct state new counter accept

        # Log and count denied traffic.
        limit rate 4/second log prefix "DROP ip6-filter-forward: "
        counter comment "ip6-filter-forward DROP"; drop
    }
}