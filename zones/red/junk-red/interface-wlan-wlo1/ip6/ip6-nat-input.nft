#!/usr/bin/env nft -f
#
# File:        ip6-nat-input.nft
# Path:        /etc/nftables/ip6
# Family:      ip6
# Table:       ip6_nat
# Chain:       ip6_nat_input
# Type:        nat
# Hook:        input
# Priority:    -100
# Policy:      ACCEPT
# Description: IPv6 destination NAT for locally delivered traffic
#
# The input hook sees IPv6 packets that have been routed to the
# local system.
#
# Priority -100 places destination NAT processing at the
# conventional destination-NAT priority.
#
# NAT chains process only the first packet of each connection.
# Connection tracking maintains the resulting NAT binding for
# subsequent packets.
#
# Examples of uses for ip6 / nat / input include:
# - Local service redirection:
#     Redirect an incoming local service port to another local port.
# - Local port remapping:
#     Translate a locally destined service port.
# - Destination translation:
#     Translate the destination address of locally delivered traffic.
#
# IMPORTANT:
# NAT chains are not packet-filtering chains.
# Use ip6/filter/input to enforce inbound host access policy.
#
# NAT chain policies should remain ACCEPT. Do not use policy DROP
# as a substitute for a filtering chain.
#
# DNAT and redirect are supported at the input hook.
#

table ip6 ip6_nat {

    chain ip6_nat_input {

        type nat hook input priority -100; policy accept;

        # Redirect a locally delivered service to another local port.
        # tcp dport 8080 redirect to :8443

        # Translate a locally delivered destination address and port.
        # tcp dport 8080 dnat to [2001:db8::10]:8443

        counter comment "ip6-nat-input"
    }
}