#!/usr/bin/env nft -f
#
# File:        ip6-nat-output.nft
# Path:        /etc/nftables/ip6
# Family:      ip6
# Table:       ip6_nat
# Chain:       ip6_nat_output
# Type:        nat
# Hook:        output
# Priority:    -100
# Policy:      ACCEPT
# Description: IPv6 destination NAT for locally generated traffic
#
# The output hook sees IPv6 packets generated by local processes.
#
# Priority -100 places destination NAT processing before the
# conventional filter priority (0).
#
# NAT chains process only the first packet of each connection.
# Connection tracking maintains the resulting NAT binding for
# subsequent packets.
#
# Examples of uses for ip6 / nat / output include:
# - Local service remapping:
#     Redirect locally generated connections to alternate service ports.
# - DNS redirection:
#     Translate locally generated DNS connections to an approved resolver.
# - Service endpoint translation:
#     Translate a destination address to an alternate IPv6 endpoint.
# - Development and testing:
#     Redirect locally generated connections to test services.
#
# IMPORTANT:
# NAT chains are not packet-filtering chains.
# Use ip6/filter/output to enforce outbound host access policy.
#
# NAT chain policies should remain ACCEPT. Do not use policy DROP
# as a substitute for a filtering chain.
#
# DNAT is supported at the output hook.
#

table ip6 ip6_nat {

    chain ip6_nat_output {

        type nat hook output priority -100; policy accept;

        # Redirect locally generated DNS queries to an alternate resolver.
        # ip6 daddr 2001:db8::53 udp dport 53 dnat to 2001:db8::54

        # Translate a locally generated connection to another endpoint.
        # ip6 daddr 2001:db8::10 tcp dport 443 dnat to 2001:db8::20:8443

        counter comment "ip6-nat-output"
    }
}