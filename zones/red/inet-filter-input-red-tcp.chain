# File:     inet-filter-input-red-tcp.chain
# Path:     zones/red/
# Title:    Regular chain for red zone inet-family TCP packets in input hook
# Family:   inet
# Table:    *
# Chain:    inet_filter_input_red_tcp
# Type:     filter
# Hook:     input
# Priority: filter(0)
# Policy:   DROP
# Zone:     red
# Description:
#

    # Register a protocol-to-firewall dispatch registry
    map map_dispatch_inet_filter_input_red_protocol {
        type inet_proto : verdict;
        elements = {
            tcp : goto inet_filter_input_red_tcp,
        }
    }

    chain inet_filter_input_red_tcp {

        counter

        tcp sport 443 counter accept
        tcp sport 80 counter accept
        tcp sport 53 counter accept
        tcp dport 53 counter accept
        tcp dport 22 counter accept
        tcp dport 922 counter accept
        tcp dport { 139, 445} counter drop comment "silently drop NetBios"

        #  ip protocol tcp tcp dport
        #         { $TORRENT_PORT_LAN, $TORRENT_PORT_WAN,
        #                 $TRACKER_TORRENT_PORT_WAN } ct state new counter accept;
        #  ip protocol udp udp dport
        #         { $TORRENT_PORT_LAN, $TORRENT_PORT_WAN,
        #                 $TRACKER_TORRENT_PORT_WAN } ct state new counter accept;

        ip protocol tcp ct state new counter accept

        log prefix "DROP inet/filter/input/red/tcp " counter drop
    }

