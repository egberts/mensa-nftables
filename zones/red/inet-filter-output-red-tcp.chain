# File:     inet-filter-output-red-tcp.chain
# Path:     zones/red/
# Title:    Rules for ICMP packets in red zone with type filter and hook output
# Family:   inet
# Table:    *
# Chain:    inet_filter_output_red_tcp
# Type:     filter
# Hook:     output
# Priority: filter(0)
# Policy:   DROP
# Zone:     red
# Called by: zones/zone-inet-filter-output-red.chain
# Description:
#

    # Register a protocol-to-firewall dispatch registry
    map map_dispatch_inet_filter_output_red_protocol {
        type inet_proto : verdict;
        elements = {
            tcp : goto inet_filter_output_red_tcp,
        }
    }

    chain inet_filter_output_red_tcp {

        include "rules/zone-red-inet-filter-output-tcp/*.rule"

        log prefix "DROP inet/filter/output/red/tcp: " counter drop comment "Log and drop all remaining TCP packets reaching this chain"

    }