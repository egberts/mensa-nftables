# File:     ip6-filter-input-red-udp.chain
# Path:     zones/red/
# Title:
# Family:   ip6
# Table:    *
# Chain:    ip6_filter_input_red_udp
# Type:     filter
# Hook:     input
# Priority: filter(0)
# Policy:   DROP
# Zone:     red
# Called by: zones/zone-ip6-filter-input-red.chain
# Description:
#

    # Register a protocol-to-firewall dispatch registry
    map map_dispatch_ip6_filter_input_red_protocol {
        type inet_proto : verdict;
        elements = {
            udp : goto ip6_filter_input_red_udp,
        }
    }

    chain ip6_filter_input_red_udp {

        include "rules/zone-red-ip6-filter-input-udp/*.rule"        directory wildcard

        log prefix "DROP ip6/filter/input/red/udp " counter drop
    }
