# File:     ip6-filter-input-red-icmp.chain
# Path:     zones/red/
# Title:    Rules for ICMP packets in red zone with type filter and hook input
# Family:   ip6
# Table:    *
# Chain:    ip6_filter_input_red_icmpv4
# Type:     filter
# Hook:     input
# Priority: filter(0)
# Policy:   DROP
# Zone:     red
# Called by: zones/zone-ip6-filter-input-red.chain
# Description:
#

    # Register a protocol-to-firewall dispatch registry
    map map_dispatch_ip6_filter_input_red_protocol {
        type inet_proto : verdict;
        elements = {
            icmp : goto ip6_filter_input_red_icmpv4,
        }
    }

    chain ip6_filter_input_red_icmpv4 {

        counter


        ip6 daddr ::1/128 counter drop

        log prefix "DROP filter/input/red input_red_icmp "counter drop
