# File:     inet-filter-input-red-udp.chain
# Path:     zones/red/
# Title:
# Family:   inet
# Table:    *
# Chain:    inet_filter_input_red_udp
# Type:     filter
# Hook:     input
# Priority: filter(0)
# Policy:   DROP
# Zone:     red
# Description:
#

    # Register a protocol-to-firewall dispatch registry
    map map_dispatch_inet_filter_input_red_protocol {
        type inet_proto : verdict;
        elements = {
            udp : goto inet_filter_input_red_udp,
        }
    }

    chain inet_filter_input_red_udp {
        counter

        # Accept established and related connections.
        ct state { established, related } counter accept  # silent accept
        counter

        ip protocol udp ct state invalid counter drop
        counter

        # it is presumed to be a NEW state at this point

        # Permit DHCPv6 client responses.
        #
        # Selector	Purpose	Example
        # meta nfproto	Network-layer protocol family	meta nfproto ipv6
        # meta l4proto	Transport-layer protocol	meta l4proto udp
        # ip6	IPv6 header fields	ip6 saddr, ip6 daddr
        #
        meta nfproto ipv6 udp sport 547 udp dport 546 counter accept

        # Permit DHCPv4 client responses (if DHCP client).
        udp sport 67 udp dport 68 counter accept  # from DHCP server

        udp dport 53 counter accept  # inbound DNS (local DNS server here)
        udp sport 53 counter accept  # outbound DNS (remote DNS server there)

        udp sport 123 udp dport 123 counter accept

        ip daddr 224.0.0.251 udp dport 1900 counter drop  # uPnP
        ip daddr 224.0.0.251 udp dport 5353 counter drop  # mdns/iOS Bonjour/Avahi 5353/udp

        udp dport { 137, 138} counter drop comment "silently drop NetBios"

        log prefix "DROP filter/input/red/udp: " counter drop

    }