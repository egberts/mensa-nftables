# File:     zone-inet-filter-input-dmz.chain
# Path:     *
# Family:   inet
# Table:    *
# Chain:    inet_filter_input_dmz
# Type:     filter
# Hook:     input
# Priority: filter(0)
# Policy:   DROP
# Zone:     dmz
# Description:
#
#

    # Register a DeviceInterface-to-firewall dispatch registry
    map map_dispatch_inet_filter_input_interface {
        typeof iif : verdict
        elements = {
            # use goto, this is the final descendance
            $LAN_INTF_DEV : goto inet_filter_input_dmz,
        }
    }

    # no layer-7 protocol-specific dispatcher needed in ARP family
    chain inet_filter_input_dmz {

        counter comment "inet/filter/input/dmz"
    }

    include "./zones/dmz/inet-filter-input-dmz.chain"  # no wildcard

    chain inet_filter_input_dmz {

        # Log and count denied traffic.
        counter log prefix "DROP inet/filter/input/dmz unknown ARP in dmz zone: " drop
    }
