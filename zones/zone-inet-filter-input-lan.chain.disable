# File:     zone-inet-filter-input-lan.chain
# Path:     *
# Family:   inet
# Table:    *
# Chain:    inet_filter_input_lan
# Type:     filter
# Hook:     input
# Priority: filter(0)
# Policy:   DROP
# Zone:     lan
# Description:
#
#

    # Register a DeviceInterface-to-firewall dispatch registry
    map map_dispatch_inet_filter_input_interface {
        typeof iif : verdict
        elements = {
            # use goto, this is the final descendance
            $LAN_INTF_DEV : goto inet_filter_input_lan,
        }
    }

    # no layer-7 protocol-specific dispatcher needed in ARP family
    chain inet_filter_input_lan {

        counter comment "inet/filter/input/lan"
    }

    include "./zones/lan/inet-filter-input-lan.chain"  # no wildcard

    chain inet_filter_input_lan {

        # Log and count denied traffic.
        counter log prefix "DROP inet/filter/input/lan unknown ARP in lan zone: " drop
    }
