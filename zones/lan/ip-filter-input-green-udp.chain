# File:     filter-input-green-udp.nft
# Path:     zones/red/
# Title:    Rules for UDP packets in red zone with type filter and hook input
# Family:   ip
# Table:    *
# Chain:    ip_filter_input_red_udp
# Type:     filter
# Hook:     input
# Priority: filter(0)
# Policy:   DROP
# Zone:     lan
# Called by: none
# Description:
#

    chain ip_filter_input_green_udp {

         counter

         meta iif $LAN_INTF_DEV ip daddr != $LAN_INTF_LOCALNET ip daddr != 255.255.255.255/32 counter log prefix "DROP filter/input/green input_green_udp__wrong_subnet " drop

         udp sport 68 udp dport 67 counter accept
        #  udp dport 53 counter accept
        #  udp sport 53 counter accept
         udp sport 123 udp dport 123 counter accept
         counter jump input_all_udp

         counter log prefix "DROP ip/filter/input/green/udp " drop
    }
