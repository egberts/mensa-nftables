#!/usr/sbin/nft -f
#
# File:     filter-inet.nft
# Path:     type-filter/
# Title:
# Family:   inet
# Table:    inet_filter
# Chain:    *
# Type:     filter
# Hook:     *
# Priority: N/A
# Policy:   *
# Called by: nftables.nft
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

table inet inet_filter {

    include "zones/testzone/type-filter-hook-*/pre-rules/*.chain";

    include "zones/testzone/type-filter-hook-input/rules/rules.chain"

    include "zones/testzone/type-filter-hook-*/post-rules/*.chain";

}
