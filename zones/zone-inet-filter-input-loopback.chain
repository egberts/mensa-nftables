# File:     zone-inet-filter-input-loopback.chain
# Path:     *
# Family:   inet
# Table:    *
# Chain:    inet_filter_input_loopback
# Type:     filter
# Hook:     input
# Priority: filter(0)
# Policy:   DROP
# Zone:     loopback
# Called by: hooks/hook-input/base-inet-filter-input.chain
# Description:
#
#

    # Register a DeviceInterface-to-firewall dispatch registry
    map map_dispatch_inet_filter_input_interface {
        typeof iif : verdict
        elements = {
            # use goto, this is the final descendance
            $LOOPBACK_INTF_DEV : goto inet_filter_input_loopback,
        }
    }

    # no layer-7 protocol-specific dispatcher needed in ARP family
    chain inet_filter_input_loopback {

        counter comment "inet/filter/input/loopback"
    }

    include "./zones/loopback/inet-filter-input-loopback.chain"  # no wildcard

    chain inet_filter_input_loopback {

       # Log and count denied traffic.
        counter log prefix "DROP inet/filter/input/loopback unknown ARP in loopback zone: " drop
    }
