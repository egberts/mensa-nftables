# File:     inet-filter-output-red-icmp.chain
# Path:     zones/red/
# Title:    Rules for ICMPv4 packets in red zone with type filter and hook output
# Family:   inet
# Table:    *
# Chain:    inet_filter_output_red_icmpv4
# Type:     filter
# Hook:     output
# Priority: filter(0)
# Policy:   DROP
# Zone:     red
# Called by: zones/zone-inet-filter-output-red.chain
# Description:
#

    # Register a protocol-to-firewall dispatch registry
    map map_dispatch_inet_filter_output_red_protocol {
        type inet_proto : verdict;
        elements = {
            icmp : goto inet_filter_output_red_icmpv4,
        }
    }

    chain inet_filter_output_red_icmpv4 {

        include "rules/zone-red-inet-filter-output-icmp/*.rule"

        log prefix "DROP filter/output/red/icmp : " counter drop
    }
