#!/usr/sbin/nft -f
#
# File:     nat-inet.nft
# Path:     type-nat/
# Title:    Valid hooks for inet family and NAT chain-type
# Family:   inet
# Table:    inet_nat
# Chain:    *
# Type:     nat
# Hook:     *
# Priority: N/A
# Policy:   *
# Called by: nftables.nft
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

table inet inet_nat {

    include "./hooks/hook-prerouting/base-inet-nat-prerouting*.chain";
    include "./hooks/hook-input/base-inet-nat-input*.chain";
    include "./hooks/hook-output/base-inet-nat-output*.chain";
    include "./hooks/hook-postrouting/base-inet-nat-postrouting*.chain";
}

