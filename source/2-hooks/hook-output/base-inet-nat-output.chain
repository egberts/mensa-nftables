# File:     base-inet-nat-output.chain
# Path:     hooks/hook-output/
# Title:    Base chain for the output hook (inet family, nat type)
# Family:   inet
# Table:    *
# Chain:    inet_nat_output
# Type:     nat
# Hook:     output
# Priority: 10 (over Libvirt/Docker filter(0) and ip/ip6 filter+1)
# Policy:   ACCEPT
# Called by: types/type-nat/nat-inet.nft
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

    # Declare an interface-to-chain dispatcher for output hook
    map map_dispatch_inet_nat_output_interface {
        typeof oif : verdict
    }
    chain inet_nat_output {
        type nat hook output priority 10; policy accept;

        counter

        # dispatch map built by including/excluding chain-inet-nat-*.nft files
        oif vmap @map_dispatch_inet_nat_output_interface
    }

    # registers with 'map_dispatch_inet_nat_output_interface' dispatch mapper)
    include "./zones/zone-inet-nat-output-*.chain";

    # Post-interface input process
    chain inet_nat_input {
        counter
    }
