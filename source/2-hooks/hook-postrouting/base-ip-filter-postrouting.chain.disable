# File:     base-ip-filter-postrouting.chain
# Path:     hooks/hook-postrouting/
# Title:    Base chain for the postrouting hook (ip family, filter type)
# Family:   ip
# Table:    *
# Chain:    ip_filter_postrouting
# Type:     filter
# Hook:     postrouting
# Priority: security(50)
# Policy:   accept
# Called by: types/type-filter/filter-ip.nft
# Description:
#

    chain ip_filter_postrouting {
        type filter hook postrouting priority 50;
        policy accept;

    }