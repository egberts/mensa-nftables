# File:        base-netdev-nat-egress.nft
# Path:
# Title:       Base chain for netdev/nat/egress hook
# Family:      netdev
# Table:       *
# Chain:       netdev_nat_egress
# Type:        nat
# Hook:        egress
# Device:      eno1
# Priority:    310 (srcnat(300)+10)
# Policy:      ACCEPT
# Description: Late egress packet enforcement
#
# The egress hook sees packets leaving the specified
# network interface.
#
# It runs after Layer 3 protocol processing and before
# the tc egress hook.
#
# Unlike inet output, netdev egress sees both locally
# generated packets and forwarded packets leaving the
# specified interface.
#
# Priority filter (numeric 0) is the conventional choice.
#
# Control                         Security purpose
# Ethernet protocol validation    Restricts permitted EtherTypes
# Destination MAC validation      Restricts destination hardware addresses
# IP destination validation        Restricts outbound IP destinations
# ARP validation                   Restricts outgoing ARP traffic
# IPv6 control traffic             Preserves required Neighbor Discovery
# Logging and counters             Provides an audit trail
#
# This chain performs late packet filtering.
# It is not a replacement for inet/filter/output,
# inet/filter/forward, or inet/filter/postrouting.
#
# IMPORTANT:
# This chain sees packets leaving the specified interface,
# including locally generated and forwarded traffic.
#
# The device name must identify an existing network interface.
#
# Requires Linux kernel 5.16 or later for netdev egress.
#

    chain netdev_nat_egress {

        type nat hook egress device $LAN_INTF_DEV priority 310; policy drop;

        # Add applicable egress filtering rules here.

        # Permit ARP only if required on this interface.
        ether type arp counter accept

        # Permit IPv4 traffic.
        ether type ip counter accept

        # Permit IPv6 traffic.
        ether type ip6 counter accept

        # Log and count denied traffic.
        limit rate 5/second log prefix "DROP netdev/nat/egress: "
        counter drop comment "netdev-nat-egress DROP"
    }