# File:        base-netdev-filter-egress.nft
# Path:        hooks/hook-egress
# Title:       Base chain for the egress hook (netdev family, filter type)
# Family:      netdev
# Table:       *
# Chain:       netdev_filter_egress
# Type:        filter
# Hook:        egress
# Device:      eno1
# Priority:    310 (srcnat(300)+10)
# Policy:      DROP
# Called by:   types/type-filter/filter-netdev.nft
# Description: Late egress packet enforcement
#
# The egress hook sees packets leaving the specified
# network interface.
#
# It runs after Layer 3 protocol processing and before
# the tc egress hook.
#
# Unlike inet output, netdev egress sees both locally
# generated packets and forwarded packets leaving the
# specified interface.
#
# Priority filter (numeric 0) is the conventional choice.
#
# Control                         Security purpose
# Ethernet protocol validation    Restricts permitted EtherTypes
# Destination MAC validation      Restricts destination hardware addresses
# IP destination validation        Restricts outbound IP destinations
# ARP validation                   Restricts outgoing ARP traffic
# IPv6 control traffic             Preserves required Neighbor Discovery
# Logging and counters             Provides an audit trail
#
# This chain performs late packet filtering.
# It is not a replacement for inet/filter/output,
# inet/filter/forward, or inet/filter/postrouting.
#
# IMPORTANT:
# This chain sees packets leaving the specified interface,
# including locally generated and forwarded traffic.
#
# Examples of uses for netdev / filter / egress include:
# - Outbound destination validation:
#     Restrict packets to authorized IPv4 and IPv6 destinations.
# - MAC address filtering:
#     Restrict outgoing Ethernet frames to authorized
#     destination hardware addresses.
# - EtherType filtering:
#     Restrict permitted Ethernet protocols.
# - Broadcast and multicast control:
#     Restrict unwanted outgoing broadcast or multicast traffic.
# - Data leakage prevention:
#     Block packets leaving an interface for prohibited
#     destinations or networks.
# - Interface-specific enforcement:
#     Apply a final packet policy to traffic leaving a
#     particular physical or virtual network interface.
#
# The device name must identify an existing network interface.
#
# 'netdev' is no longer automatically necessary just because
# early ingress filtering is available in 'inet' family.
# 'netdev' remains useful for interface-specific processing, egress
# processing and non-IP Ethernet traffic.
#
# Requires Linux kernel 5.16 or later for netdev egress.
#

    chain netdev_filter_egress {
        type filter hook egress device $LAN_INTF_DEV priority 310; policy drop;

        # Add applicable egress filtering rules here.

        # Permit ARP only if required on this interface.
        ether type arp counter accept

        # Permit IPv4 traffic.
        ether type ip counter accept

        # Permit IPv6 traffic.
        ether type ip6 counter accept

        # Log and count denied traffic.
        limit rate 5/second log prefix "DROP netdev-filter-egress: "
        counter drop comment "netdev-filter-egress DROP"
    }