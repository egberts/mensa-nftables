# File:     base-ip-filter-input.chain
# Path:     hook-input/
# Title:    Base chain for ip/filter/input
# Family:   ip
# Table:    *
# Chain:    ip_filter_input
# Type:     filter
# Hook:     input
# Priority: -1 (before Libvirt(0) and Docker(0))
# Policy:   DROP
# Description:
#

    # Initialize an interface-to-chain dispatcher for input hook
    map map_dispatch_ip_filter_input_interface {
        typeof iif : verdict
    }
    chain ip_filter_input {
        type filter hook input priority -1; policy drop;

        # Reject invalid connection states.
        ct state invalid counter log prefix "DROP ip/filter/input/invalid: " drop

        # blackholes goes here
        # push daddr 255.255.255.255/32 to zone-specific ruleset(s)
        #   ip daddr 255.255.255.255/32 counter drop comment "really drop unsolicited IPv4 broadcast"

        # Accept established and related connections.
        ct state { established, related } counter accept  # silent accept
    }

    # Selectively load our input protocol regular chains
    # registers with 'map_dispatch_ip_filter_input_interface' dispatch mapper)
    include "./zones/zone-ip-filter-input-*.chain";

    # Post-interface input process
    chain ip_filter_input {
        # A cool lookup to jump into a protocol-specific regular chain
        # dispatch map built by including/excluding chain-ip-filter-*.nft files
        iif vmap @map_dispatch_ip_filter_input_interface

        counter log prefix "DROP ip/filter/input: " drop comment "unidentified interface filter input"
    }
