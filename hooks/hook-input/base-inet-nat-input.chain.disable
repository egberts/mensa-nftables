# File:     base-inet-nat-input.chain
# Path:     hooks/hook-input/
# Title:    Base chain for the input hook (inet family, nat type)
# Family:   inet
# Table:    *
# Chain:    inet_nat_input
# Type:     nat
# Hook:     input
# Priority: -10 (filter(0) - 10, before ip-input(-5) and ip6-input(-5))
# Policy:   accept
# Called by: types/type-nat/nat-inet.nft
# Description:
#
# NOTE: Using inet for NAT is not useful, better to relegate to ip or ip6 family.
#

    # Declare an interface-to-chain dispatcher for input hook
    map map_dispatch_inet_nat_input_interface {
        typeof iif : verdict
    }
    chain inet_nat_input {
        type nat hook input priority -10; policy accept;

        # Reject invalid connection states.
        # ct state invalid counter log prefix "DROP: inet/nat/input/invalid " drop


        # A cool lookup to jump into a protocol-specific regular chain
        # dispatch map built by including/excluding chain-inet-nat-*.nft files
        iif vmap @map_dispatch_inet_nat_input_interface
    }


    # Selectively load our input protocol regular chains
    # registers with 'map_dispatch_inet_nat_input_interface' dispatch mapper)
    include "./zones/zone-inet-nat-input-*.chain";

    # Post-interface input process
    chain inet_nat_input {
        counter log prefix "DROP inet/nat/input: " drop comment "unidentified interface nat input"
    }
