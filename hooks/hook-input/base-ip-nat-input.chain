# File:     base-ip-nat-input.chain
# Path:     hook-input/
# Title:    Base chain for ip/nat/input
# Family:   ip
# Table:    *
# Chain:    ip_nat_input
# Type:     nat
# Hook:     input
# Priority: various
# Policy:   DROP
# Description:
#

    # Initialize an interface-to-chain dispatcher for input hook
    map map_dispatch_ip_nat_input_interface {
        typeof iif : verdict
    }
    chain ip_nat_input {
        type nat hook input priority -1; policy drop;

        # Reject invalid connection states.
        ct state invalid counter log prefix "DROP: ip/nat/input/invalid " drop

        # blackholes goes here
        # push daddr 255.255.255.255/32 to zone-specific ruleset(s)
        #   ip daddr 255.255.255.255/32 counter drop comment "really drop unsolicited IPv4 broadcast"

        # Accept established and related connections.
        ct state { established, related } counter accept  # silent accept

        # A cool lookup to jump into a protocol-specific regular chain
        # dispatch map built by including/excluding chain-ip-nat-*.nft files
        iif vmap @map_dispatch_ip_nat_input_interface
    }

    # Selectively load our input protocol regular chains
    # registers with 'map_dispatch_ip_nat_input_interface' dispatch mapper)
    include "./zones/zone-ip-nat-input-*.chain";

    # Post-interface input process
    chain ip_nat_input {
        counter log prefix "DROP ip/nat/input: " drop comment "unidentified interface nat input"
    }
