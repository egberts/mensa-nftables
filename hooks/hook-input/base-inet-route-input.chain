# File:     base-inet-route-input.chain
# Path:     hook-input/
# Title:    Base chain for inet/route/input
# Family:   inet
# Table:    *
# Chain:    inet_route_input
# Type:     route
# Hook:     input
# Priority: various
# Policy:   DROP
# Description:
#

    # Initialize an interface-to-chain dispatcher for input hook
    map map_dispatch_inet_route_input_interface {
        typeof iif : verdict
    }
    chain inet_route_input {
        type route hook input priority -1; policy drop;

        # Reject invalid connection states.
        ct state invalid counter log prefix "DROP: inet/route/input/invalid " drop

        # blackholes goes here
        # push daddr 255.255.255.255/32 to zone-specific ruleset(s)
        #   inet daddr 255.255.255.255/32 counter drop comment "really drop unsolicited IPv4 broadcast"

        # Accept established and related connections.
        ct state { established, related } counter accept  # silent accept

        # A cool lookup to jump into a protocol-specific regular chain
        # dispatch map built by including/excluding chain-inet-route-*.nft files
        iif vmap @map_dispatch_inet_route_input_interface
    }

    # Selectively load our input protocol regular chains
    # registers with 'map_dispatch_inet_route_input_interface' dispatch mapper)
    include "./zones/zone-inet-route-input-*.chain";

    # Post-interface input process
    chain inet_route_input {
        counter log prefix "DROP inet/route/input: " drop comment "unidentified interface route input"
    }
