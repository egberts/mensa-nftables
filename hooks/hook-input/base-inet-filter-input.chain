# File:     base-inet-filter-input.chain
# Path:     hook-input/
# Title:    Base chain for inet/filter/input
# Family:   inet
# Table:    *
# Chain:    inet_filter_input
# Type:     filter
# Hook:     input
# Priority: filter(0)
# Policy:   DROP
# Description:
#

    # Initialize an interface-to-chain dispatcher for input hook
    map map_dispatch_inet_filter_input_interface {
        typeof iif : verdict
    }
    chain inet_filter_input {
        type filter hook input priority -1; policy drop;

        # Reject invalid connection states.
        ct state invalid counter log prefix "DROP: inet/filter/input/invalid " drop

        # blackholes goes here
        # push daddr 255.255.255.255/32 to zone-specific ruleset(s)
        #   ip daddr 255.255.255.255/32 counter drop comment "really drop unsolicited IPv4 broadcast"

        # Accept established and related connections.
        ct state { established, related } counter accept  # silent accept

        # A cool lookup to jump into a protocol-specific regular chain
        # dispatch map built by including/excluding chain-inet-filter-*.nft files
        iif vmap @map_dispatch_inet_filter_input_interface
    }


    # Selectively load our input protocol regular chains
    # registers with 'map_dispatch_inet_filter_input_interface' dispatch mapper)
    include "./zones/zone-inet-filter-input-*.chain";

    # Post-interface input process
    chain inet_filter_input {
        counter log prefix "DROP inet/filter/input: " drop comment "unidentified interface filter input"
    }
