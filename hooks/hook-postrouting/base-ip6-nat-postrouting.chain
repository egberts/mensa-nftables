# File:     base-ip6-nat-postrouting.chain
# Path:     hook-postrouting/
# Title:
# Family:   ip6
# Table:    *
# Chain:    ip6_nat_postrouting_security
# Type:     nat
# Hook:     postrouting
# Priority: various
# Policy: accept
# Description:
#

    # ip6/nat/postrouting cannot use priority less than or equal to -200

    chain ip6_nat_postrouting_mangle {
        type nat hook postrouting priority -150;
        policy accept;

    }

    chain ip6_nat_postrouting_dstnat {
        type nat hook postrouting priority -100;
        policy accept;

    }
