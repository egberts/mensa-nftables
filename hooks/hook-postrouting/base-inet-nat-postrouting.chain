# File:     base-inet-nat-postrouting.chain
# Path:     hook-postrouting/
# Title:
# Family:   inet
# Table:    *
# Chain:    inet_nat_postrouting_security
# Type:     nat
# Hook:     postrouting
# Priority: various
# Policy: accept
# Description:
#

    chain inet_nat_postrouting_raw {
        type nat hook postrouting priority -300;
        policy accept;

    }

    chain inet_nat_postrouting_mangle {
        type nat hook postrouting priority -150;
        policy accept;

    }

    chain inet_nat_postrouting_dstnat {
        type nat hook postrouting priority -100;
        policy accept;

    }
