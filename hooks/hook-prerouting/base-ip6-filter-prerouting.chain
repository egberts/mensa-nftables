# File:     base-ip6-filter-prerouting-dstnat.chain
# Path:
# Title:    Base chain for ip6/filter/prerouting hook at various priority
# Family:   ip6
# Table:    *
# Chain:    ip6_filter_prerouting_*
# Type:     filter
# Hook:     prerouting
# Priority: various
# Policy:   accept
# Description:
#

    chain ip6_filter_prerouting_dstnat {
        type filter hook prerouting priority -100;
        policy accept;

    }

    chain ip6_filter_prerouting_mangle {
        type filter hook prerouting priority -150;
        policy accept;

    }

    chain ip6_filter_prerouting_raw {
        type filter hook prerouting priority -300;
        policy accept;

    }
