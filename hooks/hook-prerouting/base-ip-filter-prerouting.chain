# File:     base-ip-filter-prerouting-dstnat.chain
# Path:
# Title:    Base chain for ip/filter/prerouting hook at various priority
# Family:   ip
# Table:    *
# Chain:    ip_filter_prerouting_*
# Type:     filter
# Hook:     prerouting
# Priority: various
# Policy:   accept
# Description:
#

    chain ip_filter_prerouting_dstnat {
        type filter hook prerouting priority -100;
        policy accept;

    }

    chain ip_filter_prerouting_mangle {
        type filter hook prerouting priority -150;
        policy accept;

    }

    chain ip_filter_prerouting_raw {
        type filter hook prerouting priority -300;
        policy accept;

    }
