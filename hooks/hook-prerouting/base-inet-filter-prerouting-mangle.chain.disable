# File:     base-inet-filter-prerouting-mangle.chain
# Path:
# Title:    Base chain for inet/filter/prerouting hook at mangle priority
# Family:   inet
# Table:    *
# Chain:    inet_filter_prerouting_mangle
# Type:     filter
# Hook:     prerouting
# Priority: mangle(-150)
# Policy:   accept
# Description: is used for non-inet as pseudo-ingress (ip, ip6, bridge, arp)

    chain inet_filter_prerouting_mangle {
        type filter hook prerouting priority -150;
        policy accept;

    }
