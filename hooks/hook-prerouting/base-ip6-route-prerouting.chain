# File:     base-ip6-route-prerouting-dstnat.chain
# Path:
# Title:    Base chain for ip6/route/prerouting hook at various priority
# Family:   ip6
# Table:    *
# Chain:    ip6_route_prerouting_*
# Type:     route
# Hook:     prerouting
# Priority: various
# Policy:   accept
# Description:
#

    chain ip6_route_prerouting_dstnat {
        type route hook prerouting priority -100;
        policy accept;

    }

    chain ip6_route_prerouting_mangle {
        type route hook prerouting priority -150;
        policy accept;

    }

    chain ip6_route_prerouting_raw {
        type route hook prerouting priority -300;
        policy accept;

    }
