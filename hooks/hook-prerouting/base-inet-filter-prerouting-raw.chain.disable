# File:     base-inet-filter-prerouting-raw.chain
# Path:     hooks/hook-prerouting/
# Title:    Base chain for the prerouting hook (inet family, filter type) at RAW priority
# Family:   inet
# Table:    *
# Chain:    inet_filter_prerouting_raw
# Type:     filter
# Hook:     prerouting
# Priority: raw(-300)
# Policy:   accept
# Called by: types/type-filter/filter-inet.nft
# Description:
#     filter_prerouting_raw is used for non-inet as pseudo-ingress (ip, ip6, bridge, arp)

    chain inet_filter_prerouting_raw {
        type filter hook prerouting priority -300;
        policy accept;

        include "zones/red/"

    }

### XXXXX

# File:     base-ip-filter-prerouting_raw.chain
# Path:     hooks/hook-prerouting_raw/
# Title:    Base chain for the prerouting hook (ip family, filter type) for raw(-300) priority
# Family:   ip
# Table:    *
# Chain:    ip_filter_prerouting_raw
# Type:     filter
# Hook:     prerouting
# Priority: raw(-300) - 10
# Policy:   accept
# Called by: types/type-filter/filter-ip.nft
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

    # Declare an interface-to-chain dispatcher for prerouting hook at raw(-300) priority
    map map_dispatch_inet_filter_prerouting_raw_interface_stable {
        typeof oif : verdict
    }
    chain ip_filter_prerouting_raw {
        type filter hook prerouting priority -310; policy accept;
        oifname "lo" accept

        counter
    }
    # Selectively load our protocol regular chains
    # registers with 'map_dispatch_inet_filter_prerouting_raw_interface_stable' dispatch mapper)
    # include "./zones/zone-ip-filter-prerouting_raw-*.chain";

    # Post-interface prerouting_raw process
    chain ip_filter_prerouting_raw {
        # A cool lookup to jump into a protocol-specific regular chain
        # dispatch map built by including/excluding chain-ip-filter-prerouting_raw-*.nft files
        oif vmap @map_dispatch_inet_filter_prerouting_raw_interface_stable

        counter log prefix "DROP ip/filter/prerouting_raw: " drop
    }
