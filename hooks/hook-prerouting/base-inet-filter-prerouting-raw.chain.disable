# File:     base-inet-filter-prerouting-raw.chain
# Path:     hooks/hook-prerouting/
# Title:    Base chain for the prerouting hook (inet family, filter type) at RAW priority
# Family:   inet
# Table:    *
# Chain:    inet_filter_prerouting_raw
# Type:     filter
# Hook:     prerouting
# Priority: raw(-300)
# Policy:   accept
# Called by: types/type-filter/filter-inet.nft
# Description:
#     filter_prerouting_raw is used for non-inet as pseudo-ingress (ip, ip6, bridge, arp)

    chain inet_filter_prerouting_raw {
        type filter hook prerouting priority -300;
        policy accept;

    }