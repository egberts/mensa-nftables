#
# File:     base-inet-filter-output.chain
# Path:     hook-output/
# Title:
# Family:   inet
# Table:    *
# Chain:    inet_filter_output
# Type:     filter
# Hook:     output
# Priority: 10 (over Libvirt/Docker filter(0) and ip/ip6 filter+1)
# Policy:   DROP
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

    # Initialize an interface-to-chain dispatcher for output hook
    map map_dispatch_inet_filter_output_interface {
        typeof oif : verdict
    }
    chain inet_filter_output {
        type filter hook output priority 10; policy drop;
        oifname "lo" accept

        counter
    }

    # Selectively load our protocol regular chains
    # registers with 'map_dispatch_inet_filter_output_interface' dispatch mapper)
    include "./zones/zone-inet-filter-output-*.chain";

    # Post-interface output process
    chain inet_filter_output {
        # A cool lookup to jump into a protocol-specific regular chain
        # dispatch map built by including/excluding chain-inet-filter-*.nft files
        oif vmap @map_dispatch_inet_filter_output_interface

        counter log prefix "DROP inet/filter/output: " drop
    }
