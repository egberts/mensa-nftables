#
# File:     base-ip-filter-output.chain
# Path:     hook-output/
# Title:
# Family:   ip
# Table:    *
# Chain:    ip_filter_output
# Type:     filter
# Hook:     output
# Priority: filter(0)
# Policy:   DROP
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

    # Initialize an interface-to-chain dispatcher for output hook
    map map_dispatch_ip_filter_output_interface {
        typeof oif : verdict
    }
    chain ip_filter_output {
        type filter hook output priority 1; policy drop;
        oifname "lo" accept

        counter
    }

    # Selectively load our protocol regular chains
    # registers with 'map_dispatch_ip_filter_output_interface' dispatch mapper)
    include "./zones/zone-ip-filter-output-*.chain";

    # Post-interface input process
    chain ip_filter_output {
        # A cool lookup to jump into a protocol-specific regular chain
        # dispatch map built by including/excluding chain-ip-filter-*.nft files
        oif vmap @map_dispatch_ip_filter_output_interface

        counter log prefix "DROP ip/filter/output: " drop
    }
