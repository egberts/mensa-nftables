# File:      base-ip6-filter-output.chain
# Path:      hooks/hook-output/
# Title:     Base chain for the output hook (ip6 family, filter type)
# Family:    ip6
# Table:     *
# Chain:     ip6_filter_output
# Type:      filter
# Hook:      output
# Priority:  5 (filter(0)+5, over Libvirt/Docker filter(0))
# Policy:    DROP
# Called by: types/type-filter/filter-ip6.nft
# Description:
#    Stateful IPv6 outbound host firewall
#
# The output hook sees IPv6 packets generated by local processes.
#
# Unlike forward, output handles locally generated packets
# rather than packets routed through the host.
#
# Priority filter (numeric 5) is the conventional override to Docker/Libvirt
#
# Control                         Security purpose
# Invalid state rejection         Rejects invalid connection-tracking traffic
# Loopback acceptance             Preserves local loopback traffic
# Established/related             Permits tracked return and related traffic
# ICMPv6 error handling            Supports IPv6 network diagnostics and PMTU
# Neighbor Discovery              Supports IPv6 address resolution
# Router Solicitation             Supports IPv6 Router Discovery
# DHCPv6 requests                 Permits DHCPv6 client requests
# Explicit egress authorization   Restricts outbound destinations and services
# Logging and counters             Provides an audit trail
#
# This chain enforces outbound IPv6 host traffic.
# Use ip6/filter/forward for traffic routed through the host.
#
# IMPORTANT:
# A default-drop output policy requires explicit authorization
# for new outbound connections.
#
# Do not indiscriminately block ICMPv6. IPv6 depends on ICMPv6
# for Neighbor Discovery, Router Discovery, and Path MTU Discovery.
#
# Examples of uses for ip6 / filter / output include:
# - DNS access:
#     Permit DNS queries to approved IPv6 resolvers.
# - NTP access:
#     Permit time synchronization with approved NTP servers.
# - Web access:
#     Permit HTTP and HTTPS connections to authorized destinations.
# - ICMPv6 handling:
#     Permit essential error messages and optionally echo requests.
# - Neighbor Discovery:
#     Permit Neighbor Solicitation and Neighbor Advertisement.
# - Router Discovery:
#     Permit Router Solicitations when using SLAAC.
# - DHCPv6:
#     Permit DHCPv6 client requests when obtaining network configuration.
# - Egress restrictions:
#     Restrict outbound IPv6 destinations, protocols, and services.
#

    chain ip6_filter_output {
        type filter hook output priority 5; policy drop;

        # Reject invalid connection states.
        ct state invalid counter drop

        # Accept loopback traffic.
        oifname "lo" counter accept

        # Accept established and related connections.
        ct state { established, related } counter accept

        # Permit essential IPv6 ICMP error messages.
        icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem } counter accept

        # Permit IPv6 Neighbor Discovery.
        icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert } ip6 hoplimit 255 counter accept

        # Permit Router Solicitations (if using SLAAC).
        icmpv6 type nd-router-solicit ip6 hoplimit 255 counter accept

        # Permit Router Advertisements (if acting as an IPv6 router).
        icmpv6 type nd-router-advert ip6 hoplimit 255 counter accept

        # Permit DHCPv6 client requests.
        udp sport 546 udp dport 547 counter accept

        # Optional: permit outgoing IPv6 echo requests.
        # icmpv6 type echo-request counter accept

        # Explicitly authorized NEW outbound traffic goes here.

        # Example: DNS to approved IPv6 resolvers.
        # ip6 daddr 2001:db8::53 udp dport 53 ct state new counter accept
        # ip6 daddr 2001:db8::53 tcp dport 53 ct state new counter accept

        # Example: NTP to an approved IPv6 server.
        # ip6 daddr 2001:db8::123 udp dport 123 ct state new counter accept

        # Example: HTTPS outbound.
        # tcp dport 443 ct state new counter accept
    }

    # Selectively load our output protocol regular chains
    # registers with 'map_dispatch_ip6_filter_output_interface' dispatch mapper)
    include "./zones/zone-ip6-filter-output-*.chain";

    # Post-interface output process
    chain ip6_filter_output {
        # A cool lookup to jump into a protocol-specific regular chain
        # dispatch map built by including/excluding chain-inet-route-*.nft files
        oif vmap @map_dispatch_ip6_filter_output_interface

        counter

        # Log and count denied traffic.
        limit rate 5/second log prefix "DROP ip6/filter/output: "
    }
