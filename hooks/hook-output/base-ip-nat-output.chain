# File:     base-ip-nat-output.chain
# Path:     hook-output/
# Title:
# Family:   ip
# Table:    *
# Chain:    ip_nat_output
# Type:     nat
# Hook:     output
# Priority: nat(0)
# Policy:   ACCEPT
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#


    # Initialize an interface-to-chain dispatcher for output hook
    map map_dispatch_ip_nat_output_interface {
        typeof oif : verdict
    }
    chain ip_nat_output {
        type nat hook output priority 1; policy accept;
        oifname "lo" accept

        counter
    }

    # Selectively load our protocol regular chains
    # registers with 'map_dispatch_ip_nat_output_interface' dispatch mapper)
    include "./zones/zone-ip-nat-output-*.chain";

    # Post-interface output process
    chain ip_nat_output {
        # A cool lookup to jump into a protocol-specific regular chain
        # dispatch map built by including/excluding chain-ip-nat-*.nft files
        oif vmap @map_dispatch_ip_nat_output_interface

        counter
    }
