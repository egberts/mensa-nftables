# File:     base-inet-route-output.chain
# Path:     hooks/hook-output/
# Title:
# Family:   inet
# Table:    *
# Chain:    inet_route_output
# Type:     route
# Hook:     output
# Priority: 10 (over Libvirt/Docker filter(0) and ip/ip6 filter+1)
# Policy:   ACCEPT
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#


    # Initialize an interface-to-chain dispatcher for output hook
    map map_dispatch_inet_route_output_interface {
        typeof oif : verdict
    }
    chain inet_route_output {
        type route hook output priority 10; policy accept;
        oifname "lo" accept
        counter
    }

    # Selectively load our protocol regular chains
    # registers with 'map_dispatch_inet_route_output_interface' dispatch mapper)
    include "./zones/zone-inet-route-output-*.chain";

    # Post-interface output process
    chain inet_route_output {
        # A cool lookup to jump into a protocol-specific regular chain
        # dispatch map built by including/excluding chain-inet-route-*.nft files
        oif vmap @map_dispatch_inet_route_output_interface

        counter
    }
