# File:        base-netdev-nat-ingress.chain
# Path:
# Title:       Base chain for netdev/nat/ingress hook
# Family:      netdev
# Table:       *
# Chain:       netdev_filter_ingress
# Type:        nat
# Hook:        ingress
# Device:      eno1
# Priority:    filter (0)
# Policy:      DROP
# Description: Early ingress packet enforcement
#

    chain netdev_nat_ingress {

        type nat hook ingress device $LAN_INTF_DEV priority filter; policy drop;

        # Add applicable ingress nat rules here.

        # Permit ARP only if required on this interface.
        ether type arp counter accept

        # Permit IPv4 traffic.
        ether type ip counter accept

        # Permit IPv6 traffic.
        ether type ip6 counter accept

        # Log and count denied traffic.
        log prefix "DROP netdev-nat-ingress: " limit rate 5/second
        counter drop comment "netdev-nat-ingress DROP"
    }