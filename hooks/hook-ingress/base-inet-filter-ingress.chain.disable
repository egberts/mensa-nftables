# File:     base-inet-filter-ingress.nft
# Path:     hook-ingress/
# Title:
# Family:   inet
# Table:    *
# Chain:    inet_filter_ingress
# Type:     filter
# Hook:     ingress
# Priority: -310 (filter (0) - 310 (after inet/filter/ingress))
# Policy:   ACCEPT
# Description:
#
# NOTE: If no rule specified, comment out the entire chain
#
# VERSION: Stateful NAT available in inet family since Linux 5.2+
#

    chain admin_inet_filter_ingress {
        type filter hook ingress priority -310;
        policy accept;

    }

