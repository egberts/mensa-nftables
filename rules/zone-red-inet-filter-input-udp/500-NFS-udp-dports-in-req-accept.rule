#
# File: 500-NFS-udp-sports-in-request-accept.rule
# Policy: Allow remote DNS client request to local NFS server
# Called by: zones/red/inet-filter-input-red-udp.chain

udp sport 111 counter accept comment "remote-to-local NFSportmapper/UDP/111 request"
udp sport 2049 counter accept comment "remote-to-local NFS/UDP/2049 request"
udp sport 20048 counter accept comment "remote-to-local NFSmountd/UDP/20048 request"
