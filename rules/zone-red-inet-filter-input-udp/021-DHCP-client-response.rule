# Policy: Local DHCPv4 client receiving server responses
# Description:
#   Permits DHCPv4 responses sent by a remote DHCP server
#   to the local DHCP client.
#
# Local role: Client
# Exchange: Server-to-client
# IP version: IPv4
# Service: DHCP
# Protocol: UDP
# Source port: 67
# Destination port: 68

meta nfproto ipv4 udp sport 67 udp dport 68 counter accept \
    comment "inbound remote DHCP server response"



udp sport 67 udp dport 68 notrack counter accept comment "remote DHCPv4 server reply to local DHCPv4 client"
