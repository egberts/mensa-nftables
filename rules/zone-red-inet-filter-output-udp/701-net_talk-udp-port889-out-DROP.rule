#
# File: 701-net_talk-udp-port889-out-DROP.rule
# Policy: DENY outbound net_talk broadcast
# Called by: zones/red/inet-filter-output-red-udp.chain
# Description:
#  Used by GIGABYTE cFosSpeed LAN statistics broadcast
#  Last seen by MAC: 10:FF:E0:36:DE:81
#      Destination: 192.168.1.255
#      TTL: 1
#  Purpose: Traffic-shaping statistics exchange
#

udp sport 889 udp dport 889 drop comment "local-to-remote net_talk/UDP/889 broadcast"
