#
# File: 100-ARP-operation-reply-out-accept.rule
# Policy: Allow local ARP server operation reply to remote ARP client (ping in)
# Called by: zones/loopback/arp-filter-output-loopback.chain

arp operation 2 arp ptype 0x0800 arp daddr ip { $WAN_INTF_ADDR, $GATEWAY_ROUTE_DEFAULT } counter accept comment "local-to-remote ARP reply"

