#!/usr/sbin/nft -f
## ignored if included directly by 'nft -f'
# File: nftables.nft
# Title: Rules for all packets in all zones with all types and all hooks
# Description:
#   A multi-config file approach for a complete default-deny firewall using
#   nftables.  Covers all:
#     * zone names
#     * base chain types and 
#     * all base chain hooks.
#

# site-specific settings, contains 'nft defines'
include "./nft-common.nft"

# ensures that table exist, no matter what, so we can flush them, always
table netdev netdev_filter
table inet inet_filter
table ip ip_filter
table ip6 ip6_filter
table arp arp_filter
table bridge bridge_filter
table inet inet_nat
table ip ip_nat
table ip6 ip6_nat
table inet inet_route
table ip ip_route
table ip6 ip6_route

# flush them all
flush table netdev netdev_filter
flush table inet inet_filter
flush table ip ip_filter
flush table ip6 ip6_filter
flush table arp arp_filter
flush table bridge bridge_filter
flush table inet inet_nat
flush table ip ip_nat
flush table ip6 ip6_nat
flush table inet inet_route
flush table ip ip_route
flush table ip6 ip6_route

# include "types/filter-netdev.nft"
include "types/filter-inet.nft"
# include "types/filter-ip.nft"
# include "types/filter-ip6.nft"
# include "types/filter-bridge.nft"
include "types/filter-arp.nft"

include "types/nat-inet.nft"
# include "types/nat-ip.nft"
# include "types/nat-ip6.nft"

# include "types/route-inet.nft"
# include "types/route-ip.nft"
# include "types/route-ip6.nft"
