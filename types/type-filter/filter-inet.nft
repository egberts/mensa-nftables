#!/usr/sbin/nft -f
#
# File:     filter-inet.nft
# Path:     type-filter/
# Title:
# Family:   inet
# Table:    inet_filter
# Chain:    *
# Type:     filter
# Hook:     *
# Priority: N/A
# Policy:   *
# Called by: nftables.nft
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

table inet inet_filter {

    include "./hooks/hook-ingress/base-inet-filter-ingress*.chain";

    include "./hooks/hook-prerouting/base-inet-filter-prerouting*.chain";

    include "./hooks/hook-input/base-inet-filter-input*.chain";

    include "./hooks/hook-forward/base-inet-filter-forward*.chain";

    include "./hooks/hook-output/base-inet-filter-output*.chain";

    include "./hooks/hook-postrouting/base-inet-filter-postrouting*.chain";

}
