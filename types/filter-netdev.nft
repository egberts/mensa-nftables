#!/usr/sbin/nft -f
#
# File:     filter-netdev.nft
# Path:     type-filter/
# Title:
# Family:   netdev
# Table:    netdev_filter
# Chain:    *
# Type:     filter
# Hook:     *
# Priority: N/A
# Policy:   *
# Called by: nftables.nft
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

table netdev netdev_filter {

    # netdev/nat/ingress not supported
    # netdev/nat/egress not supported

    include "./hooks/hook-ingress/base-netdev-filter-ingress*.chain"

    include "./hooks/hook-egress/base-netdev-filter-egress*.chain"

}
