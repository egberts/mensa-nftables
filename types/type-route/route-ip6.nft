#!/usr/sbin/nft -f
#
# File:     route-ip6.nft
# Path:     type-route/
# Title:
# Family:   ip6
# Table:    ip6_route
# Chain:    *
# Type:     route
# Hook:     *
# Priority: N/A
# Policy:   *
# Called by: nftables.nft
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

table ip6 ip6_route {

    # ip6/route/prerouting not supported

    # ip6/route/input not supported

    include "./hooks/hook-output/base-ip6-route-output*.chain";

    include "./hooks/hook-postrouting/base-ip6-route-postrouting*.chain";

}
