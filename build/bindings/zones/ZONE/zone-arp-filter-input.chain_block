    } # closed arp_filter_input (pop-up to chain declaration level)

    # add a new regular chain (this is OUR zone-specific registry, no dispatcher available)
    chain arp_filter_input_ZONE {
        # preload regular chains in all zones having arp/filter/input
        include "bindings/zones/ZONE/rules/arp-filter-input/*.rule"
    }

    # resume arp_filter_input base chain
    chain arp_filter_input {

        # there is no decision to selectively go to a specific zone (waste a jump/stack; most inelegant method).
        jump arp_filter_input_zones

    # chain delimiter intentionally left open (still in arp_filter_input chain; part of binding strategy)
