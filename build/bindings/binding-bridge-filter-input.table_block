    error "I got here for ARP retest"

    include "bindings/devices/devices-bridge-filter-input*.table_block"

    # Declare an interface-to-chain dispatcher for input hook, bridge family, filter chain-type.
    map map_dispatch_bridge_filter_input_interface {
        typeof iif : verdict
    }

    chain bridge_filter_input {

