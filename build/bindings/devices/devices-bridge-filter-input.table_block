#
# File:     devices-bridge-filter-input.table_block
# Path:     bindings/devices/
# Title:    Register all devices having bridge/filter/input
# Family:   bridge
# Table:    bridge_filter
# Chain:    bridge_filter_input
# Type:     filter
# Hook:     input
# Priority: -210 (filter(-200) - 10)
# Policy:   DROP
# Called by: hooks/hook-input/base-bridge-filter-input.base_chain
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

    # Pre-declare an interface-to-chain dispatcher for input hook, bridge family, filter chain-type.
    map map_dispatch_bridge_filter_input_devices {
        typeof iif : verdict
    }

    # Insert the jump lookup
    chain bridge_filter_input {
        counter comment "device inbound bridge/filter/input"
        iif vmap @map_dispatch_bridge_filter_input_devices
        counter comment "device inbound bridge/filter/input, post dispatch"
    }

    # Register all bridge_filter_input devices
    include "bindings/devices/*/binding-device-bridge-filter-input.table_block"

