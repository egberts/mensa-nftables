# File:     bindings-device-ip-route-output.table_block
# Path:     bindings/devices/LIBVIRT/
# Title:    Create regular chain and register with dispatcher of devices for ip/route/output base chain
# Family:   ip
# Type:     route
# Hook:     output
# Device:   LIBVIRT
# Priority: +10 (filter(0)+10)
# Policy:   accept
# Table:    route_ip
# Chain:    route_ip_output
# Called by: binding/devices/LIBVIRT/device-ip-route-output.table_block
# Description:
#

    # Add/register a Device Interface-to-firewall dispatch registry
    map map_dispatch_ip_route_output_devices {
        typeof oif : verdict
        elements = {
            # use goto, this is the final descendance
            $LIBVIRT_INTF_DEV : goto ip_route_output_LIBVIRT,
        }
    }

    chain ip_route_output_LIBVIRT {
        counter comment "BEGIN outbound LIBVIRT ip/route/output"

        # LIBVIRT: Include rules strictly for all sub-zones/sub-devices having ip/route/output regular chain
        include "bindings/devices/LIBVIRT/rules/ip-route-output/*.rule"
    }
    # Split the chain so that other chains can be created (ie., dispatcher regular chain)


    # LIBVIRT/ZONE: Include all zones having this device ip/route/output regular chain
    include "bindings/devices/LIBVIRT/zones/subzones-ip-route-output.table_block"

    # ZONE: Include all zones having this device ip/route/output regular chain
    # include "bindings/zones/zones-ip-route-output.table_block"

    # (TODO: can we symbolically link to the parent zones/ZONE here, instead of include a duplicate ZONE?)

    # No need for LIBVIRT/LIBVIRT/ZONE; simply do a subdevice as LIBVIRT/ZONE

    chain ip_route_output_LIBVIRT {
        counter comment "End outbound LIBVIRT ip/route/output"
    }

