#
# File:     bindings-device-ip-filter-postrouting_srcnat.table_block
# Path:     bindings/devices/LIBVIRT/
# Title:    Regular chain with dispatcher for ip/filter/postrouting for srcnat(100) priority
# Family:   ip
# Type:     filter
# Hook:     postrouting
# Device:   LIBVIRT
# Priority: +110 (srcnat(100)+10)
# Policy:   accept
# Table:    filter_ip
# Chain:    filter_ip_postrouting_srcnat
# Called by: binding/devices/LIBVIRT/device-ip-filter-postrouting_srcnat.chain_block
# Description:
#

    # Add/register a Device Interface-to-firewall dispatch registry
    map map_dispatch_ip_filter_postrouting_srcnat_devices {
        typeof oif : verdict
        elements = {
            # use goto, this is the final descendance
            $LIBVIRT_INTF_DEV : goto ip_filter_postrouting_srcnat_LIBVIRT,
        }
    }

    chain ip_filter_postrouting_srcnat_LIBVIRT {
        counter comment "BEGIN outbound LIBVIRT ip/filter/postrouting_srcnat"

        # LIBVIRT: Include rules strictly for all sub-zones/sub-devices having ip/filter/postrouting regular chain
        include "bindings/devices/LIBVIRT/rules/ip-filter-postrouting_srcnat*/*.rule"
    }
    # Split the chain so that other chains can be created (ie., dispatcher regular chain)


    # LIBVIRT/ZONE: Include all zones having this device ip/filter/postrouting regular chain
    include "bindings/devices/LIBVIRT/zones/subzones-ip-filter-postrouting_srcnat.table_block"

    # ZONE: Include all zones having this device ip/filter/postrouting regular chain
    # include "bindings/zones/zones-ip-filter-postrouting_srcnat.table_block"

    # (TODO: can we symbolically link to the parent zones/ZONE here, instead of include a duplicate ZONE?)

    # No need for LIBVIRT/LIBVIRT/ZONE; simply do a subdevice as LIBVIRT/ZONE

    chain ip_filter_postrouting_srcnat_LIBVIRT {
        counter comment "End outbound LIBVIRT ip/filter/postrouting_srcnat"
    }

