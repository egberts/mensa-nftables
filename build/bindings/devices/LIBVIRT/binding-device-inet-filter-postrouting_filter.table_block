#
# File:     bindings-device-inet-filter-postrouting_filter.table_block
# Path:     bindings/devices/LIBVIRT/
# Title:    Regular chain with dispatcher for inet/filter/postrouting for filter(0) priority
# Family:   inet
# Type:     filter
# Hook:     postrouting
# Device:   LIBVIRT
# Priority: +10 (filter(0)+10)
# Policy:   accept
# Table:    filter_inet
# Chain:    filter_inet_postrouting_filter
# Called by: binding/devices/LIBVIRT/device-inet-filter-postrouting_filter.chain_block
# Description:
#

    # Add/register a Device Interface-to-firewall dispatch registry
    map map_dispatch_inet_filter_postrouting_filter_devices {
        typeof oif : verdict
        elements = {
            # use goto, this is the final descendance
            $LIBVIRT_INTF_DEV : goto inet_filter_postrouting_filter_LIBVIRT,
        }
    }

    chain inet_filter_postrouting_filter_LIBVIRT {
        counter comment "BEGIN outbound LIBVIRT inet/filter/postrouting_filter"

        # LIBVIRT: Include rules strictly for all sub-zones/sub-devices having inet/filter/postrouting regular chain
        include "bindings/devices/LIBVIRT/rules/inet-filter-postrouting_filter*/*.rule"
    }
    # Split the chain so that other chains can be created (ie., dispatcher regular chain)


    # LIBVIRT/ZONE: Include all zones having this device inet/filter/postrouting regular chain
    include "bindings/devices/LIBVIRT/zones/subzones-inet-filter-postrouting_filter.table_block"

    # ZONE: Include all zones having this device inet/filter/postrouting regular chain
    # include "bindings/zones/zones-inet-filter-postrouting_filter.table_block"

    # (TODO: can we symbolically link to the parent zones/ZONE here, instead of include a duplicate ZONE?)

    # No need for LIBVIRT/LIBVIRT/ZONE; simply do a subdevice as LIBVIRT/ZONE

    chain inet_filter_postrouting_filter_LIBVIRT {
        counter comment "End outbound LIBVIRT inet/filter/postrouting_filter"
    }

