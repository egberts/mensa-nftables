#
# File: subzones-inet-filter-output_raw.table_block
# Path: bindings/devices/LIBVIRT/zones/
# Title: Include all subzones associated with this device for inet/filter/output
# Family: inet
# Type: filter
# Hook: output
# Device: LIBVIRT
# Priority: +310 ((+300)+10)
# Table: filter_inet
# Chain: inet_filter_output_raw_LIBVIRT
# Called by: bindings/devices/LIBVIRT/binding-device-inet-filter-output_raw.table_block
#

    # going to need a registry table just for LIBVIRT-ZONE
    chain dispatcher_inet_filter_output_raw_LIBVIRT_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/LIBVIRT/zones/*/zone-inet-filter-output_raw.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain inet_filter_output_raw_LIBVIRT {
        jump dispatcher_inet_filter_output_raw_LIBVIRT_ZONE
    }
