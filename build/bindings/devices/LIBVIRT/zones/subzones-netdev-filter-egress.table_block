#
# File: subzones-netdev-filter-egress.table_block
# Path: bindings/devices/LIBVIRT/zones/
# Title: Include all subzones associated with this device for netdev/filter/egress
# Family: netdev
# Type: filter
# Hook: egress
# Device: LIBVIRT
# Priority: -10
# Policy: accept
# Table: filter_netdev
# Chain: netdev_filter_egress_LIBVIRT
# Called by: bindings/devices/LIBVIRT/binding-device-bridge-filter-egress.table_block
#

    # going to need a registry table just for LIBVIRT-ZONE
    chain dispatcher_netdev_filter_egress_LIBVIRT_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/LIBVIRT/zones/*/zone-netdev-filter-egress.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain netdev_filter_egress_LIBVIRT {
        jump dispatcher_netdev_filter_egress_LIBVIRT_ZONE
    }
