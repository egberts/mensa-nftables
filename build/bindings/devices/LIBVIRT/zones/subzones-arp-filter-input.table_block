#
# File: subzones-arp-filter-input.table_block
# Path: bindings/devices/LIBVIRT/zones/
# Title: Include all subzones associated with this device for arp/filter/input
# Family: arp
# Table: filter_arp
# Chain: arp_filter_input_LIBVIRT
# Type: filter
# Hook: input
# Device: LIBVIRT
# Priority: -10
# Called by: bindings/devices/LIBVIRT/binding-device-bridge-filter-input.table_block
#

    # going to need a registry table just for LIBVIRT-ZONE
    chain dispatcher_arp_filter_input_LIBVIRT_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/LIBVIRT/zones/*/zone-arp-filter-input.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain arp_filter_input_LIBVIRT {
        jump dispatcher_arp_filter_input_LIBVIRT_ZONE
    }
