#
# File: subzones-inet-route-output.table_block
# Path: bindings/devices/LIBVIRT/zones/
# Title: Include all subzones associated with this device for inet/route/output
# Family: inet
# Type: route
# Hook: output
# Device: LIBVIRT
# Priority: +10 (filter(0)+10)
# Policy: accept
# Table: route_inet
# Chain: inet_route_output_LIBVIRT
# Called by: bindings/devices/LIBVIRT/binding-device-inet-route-output.table_block
#

    # going to need a registry table just for LIBVIRT-ZONE
    chain dispatcher_inet_route_output_LIBVIRT_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/LIBVIRT/zones/*/zone-inet-route-output.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain inet_route_output_LIBVIRT {
        jump dispatcher_inet_route_output_LIBVIRT_ZONE
    }
