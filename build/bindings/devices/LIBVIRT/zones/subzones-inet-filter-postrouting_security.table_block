#
# File: subzones-inet-filter-postrouting_security.table_block
# Path: bindings/devices/LIBVIRT/zones/
# Title: Include all subzones associated with this device for inet/filter/postrouting
# Family: inet
# Type: filter
# Hook: postrouting
# Device: LIBVIRT
# Priority: +110 (srcnat(100)+10)
# Table: filter_inet
# Chain: inet_filter_postrouting_security_LIBVIRT
# Called by: bindings/devices/LIBVIRT/binding-device-inet-filter-postrouting_security.table_block
#

    # going to need a registry table just for LIBVIRT-ZONE
    chain dispatcher_inet_filter_postrouting_security_LIBVIRT_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/LIBVIRT/zones/*/zone-inet-filter-postrouting_security.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain inet_filter_postrouting_security_LIBVIRT {
        jump dispatcher_inet_filter_postrouting_security_LIBVIRT_ZONE
    }
