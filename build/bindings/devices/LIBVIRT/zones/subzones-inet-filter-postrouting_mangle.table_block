#
# File: subzones-inet-filter-postrouting_mangle.table_block
# Path: bindings/devices/LIBVIRT/zones/
# Title: Include all subzones associated with this device for inet/filter/postrouting
# Family: inet
# Type: filter
# Hook: postrouting
# Device: LIBVIRT
# Priority: -160 (mangle(-150)-10)
# Table: filter_inet
# Chain: inet_filter_postrouting_mangle_LIBVIRT
# Called by: bindings/devices/LIBVIRT/binding-device-inet-filter-postrouting_mangle.table_block
#

    # going to need a registry table just for LIBVIRT-ZONE
    chain dispatcher_inet_filter_postrouting_mangle_LIBVIRT_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/LIBVIRT/zones/*/zone-inet-filter-postrouting_mangle.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain inet_filter_postrouting_mangle_LIBVIRT {
        jump dispatcher_inet_filter_postrouting_mangle_LIBVIRT_ZONE
    }
