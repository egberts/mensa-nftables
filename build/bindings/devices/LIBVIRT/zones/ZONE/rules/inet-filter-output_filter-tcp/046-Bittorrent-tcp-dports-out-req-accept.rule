#
# File: 046-Bittorrent-tcp-dport123-out-req-accept.rule
# Title: Allow local Bittorrent client request to remote Bittorrent client

# BitTorrent services (optional).
tcp dport { $TORRENT_PORT_LAN, $TORRENT_PORT_WAN, $TRACKER_TORRENT_PORT_WAN } ct state new counter accept comment "local-to-remote BitTorrent/TCP/various request"
