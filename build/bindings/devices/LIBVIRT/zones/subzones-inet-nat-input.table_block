#
# File: subzones-inet-nat-input.table_block
# Path: bindings/devices/LIBVIRT/zones/
# Title: Include all subzones associated with this device for inet/nat/input
# Family: inet
# Type: nat
# Hook: input
# Device: LIBVIRT
# Priority: -10 (nat(0)-10)
# Table: nat_inet
# Chain: inet_nat_input_LIBVIRT
# Called by: bindings/devices/LIBVIRT/binding-device-inet-nat-input.table_block
#

    # going to need a registry table just for LIBVIRT-ZONE
    chain dispatcher_inet_nat_input_LIBVIRT_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/LIBVIRT/zones/*/zone-inet-nat-input.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain inet_nat_input_LIBVIRT {
        jump dispatcher_inet_nat_input_LIBVIRT_ZONE
    }
