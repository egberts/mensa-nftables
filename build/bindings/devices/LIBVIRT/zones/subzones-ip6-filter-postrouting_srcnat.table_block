#
# File: subzones-ip6-filter-postrouting_srcnat.table_block
# Path: bindings/devices/LIBVIRT/zones/
# Title: Include all subzones associated with this device for ip6/filter/postrouting
# Family: ip6
# Type: filter
# Hook: postrouting
# Device: LIBVIRT
# Priority: +110 (srcnat(100)+10)
# Table: filter_ip6
# Chain: ip6_filter_postrouting_srcnat_LIBVIRT
# Called by: bindings/devices/LIBVIRT/binding-device-ip6-filter-postrouting_srcnat.table_block
#

    # going to need a registry table just for LIBVIRT-ZONE
    chain dispatcher_ip6_filter_postrouting_srcnat_LIBVIRT_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/LIBVIRT/zones/*/zone-ip6-filter-postrouting_srcnat.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain ip6_filter_postrouting_srcnat_LIBVIRT {
        jump dispatcher_ip6_filter_postrouting_srcnat_LIBVIRT_ZONE
    }
