#
# File: subzones-inet-filter-prerouting_filter.table_block
# Path: bindings/devices/LIBVIRT/zones/
# Title: Include all subzones associated with this device for inet/filter/prerouting
# Family: inet
# Type: filter
# Hook: prerouting
# Device: LIBVIRT
# Priority: -10 (filter(0)-10)
# Table: filter_inet
# Chain: inet_filter_prerouting_filter_LIBVIRT
# Called by: bindings/devices/LIBVIRT/binding-device-inet-filter-prerouting_filter.table_block
#

    # going to need a registry table just for LIBVIRT-ZONE
    chain dispatcher_inet_filter_prerouting_filter_LIBVIRT_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/LIBVIRT/zones/*/zone-inet-filter-prerouting_filter.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain inet_filter_prerouting_filter_LIBVIRT {
        jump dispatcher_inet_filter_prerouting_filter_LIBVIRT_ZONE
    }
