#
# File: subzones-bridge-filter-forward.table_block
# Path: bindings/devices/LIBVIRT/zones/
# Title: Include all subzones associated with this device for bridge/filter/forward
# Family: bridge
# Table: filter_bridge
# Chain: bridge_filter_forward_LIBVIRT
# Type: filter
# Hook: forward
# Device: LIBVIRT
# Priority: -10 (brnf(0)-10)
# Called by: bindings/devices/LIBVIRT/binding-device-bridge-filter-forward.table_block
#

    # going to need a registry table just for LIBVIRT-ZONE
    chain dispatcher_bridge_filter_forward_LIBVIRT_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/LIBVIRT/zones/*/zone-bridge-filter-forward.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain bridge_filter_forward_LIBVIRT {
        jump dispatcher_bridge_filter_forward_LIBVIRT_ZONE
    }
