#
# File: subzones-ip-filter-input.table_block
# Path: bindings/devices/LIBVIRT/zones/
# Title: Include all subzones associated with this device for ip/filter/input
# Family: ip
# Type: filter
# Hook: input
# Device: LIBVIRT
# Priority: -10 (filter(0)-10)
# Table: filter_ip
# Chain: ip_filter_input_LIBVIRT
# Called by: bindings/devices/LIBVIRT/binding-device-ip-filter-input.table_block
#

    # going to need a registry table just for LIBVIRT-ZONE
    chain dispatcher_ip_filter_input_LIBVIRT_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/LIBVIRT/zones/*/zone-ip-filter-input.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain ip_filter_input_LIBVIRT {

        jump dispatcher_ip_filter_input_LIBVIRT_ZONE
    }

