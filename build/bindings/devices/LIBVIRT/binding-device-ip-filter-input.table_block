# File:     bindings-device-ip-filter-input.table_block
# Path:     bindings/devices/LIBVIRT/
# Title:    Create regular chain and register with dispatcher of devices for ip/filter/input base chain
# Family:   ip
# Table:    filter_ip
# Chain:    filter_ip_input
# Type:     filter
# Hook:     input
# Device:   LIBVIRT
# Priority: -110 (dstnat(-100)-10)
# Policy:   DROP
# Called by: binding/devices/LIBVIRT/device-ip-filter-input.chain_block
# Description:
#

    # Add/register a Device Interface-to-firewall dispatch registry
    map map_dispatch_ip_filter_input_devices {
        typeof iif : verdict
        elements = {
            # use goto, this is the final descendance
            $LIBVIRT_INTF_DEV : goto ip_filter_input_LIBVIRT,
        }
    }

    chain ip_filter_input_LIBVIRT {
        counter comment "BEGIN inbound LIBVIRT ip/filter/input"

        # LIBVIRT: Include rules strictly for all sub-zones/sub-devices having ip/filter/input regular chain
        include "bindings/devices/LIBVIRT/rules/ip-filter-input/*.rule"
    }
    # Split the chain so that other chains can be created (ie., dispatcher regular chain)


    # LIBVIRT/ZONE: Include all zones having this device ip/filter/input regular chain
    include "bindings/devices/LIBVIRT/zones/subzones-ip-filter-input.table_block"

    # ZONE: Include all zones having this device ip/filter/input regular chain
    # include "bindings/zones/zones-ip-filter-input.table_block"

    # (TODO: can we symbolically link to the parent zones/ZONE here, instead of include a duplicate ZONE?)

    # No need for LIBVIRT/LIBVIRT/ZONE; simply do a subdevice as LIBVIRT/ZONE

    chain ip_filter_input_LIBVIRT {
        counter comment "End inbound LIBVIRT ip/filter/input"
    }

