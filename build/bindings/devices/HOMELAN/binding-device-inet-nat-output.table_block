# File:     bindings-device-inet-nat-output.table_block
# Path:     bindings/devices/HOMELAN/
# Title:    Create regular chain and register with dispatcher of devices for inet/nat/output base chain
# Family:   inet
# Type:     nat
# Hook:     output
# Device:   HOMELAN
# Priority: +10 (nat(0)+10)
# Policy:   DROP
# Table:    nat_inet
# Chain:    nat_inet_output
# Called by: binding/devices/HOMELAN/device-inet-nat-output.chain_block
# Description:
#

    # Add/register a Device Interface-to-firewall dispatch registry
    map map_dispatch_inet_nat_output_devices {
        typeof oif : verdict
        elements = {
            # use goto, this is the final descendance
            $HOMELAN_INTF_DEV : goto inet_nat_output_HOMELAN,
        }
    }

    chain inet_nat_output_HOMELAN {
        counter comment "BEGIN inbound HOMELAN inet/nat/output"

        # HOMELAN: Include rules strictly for all sub-zones/sub-devices having inet/nat/output regular chain
        include "bindings/devices/HOMELAN/rules/inet-nat-output/*.rule"
    }
    # Split the chain so that other chains can be created (ie., dispatcher regular chain)


    # HOMELAN/ZONE: Include all zones having this device inet/nat/output regular chain
    include "bindings/devices/HOMELAN/zones/subzones-inet-nat-output.table_block"

    # ZONE: Include all zones having this device inet/nat/output regular chain
    # include "bindings/zones/zones-inet-nat-output.table_block"

    # (TODO: can we symbolically link to the parent zones/ZONE here, instead of include a duplicate ZONE?)

    # No need for HOMELAN/HOMELAN/ZONE; simply do a subdevice as HOMELAN/ZONE

    chain inet_nat_output_HOMELAN {
        counter comment "End inbound HOMELAN inet/nat/output"
    }

