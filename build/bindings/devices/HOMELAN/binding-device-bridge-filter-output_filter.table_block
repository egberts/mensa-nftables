# File:     bindings-device-bridge-filter-output_filter.table_block
# Path:     bindings/devices/HOMELAN/
# Title:    Regular chain with dispatcher for bridge/filter/output for bridge filter(100) priority
# Family:   bridge
# Type:     filter
# Hook:     output
# Device:   HOMELAN
# Priority: 110 (out(100)+10)
# Policy:   *
# Table:    filter_bridge
# Chain:    filter_bridge_output_filter
# Called by: binding/devices/HOMELAN/device-bridge-filter-output_filter.chain_block
# Description:
#

    # Add/register a Device Interface-to-firewall dispatch registry
    map map_dispatch_bridge_filter_output_filter_devices {
        typeof oif : verdict
        elements = {
            # use goto, this is the final descendance
            $HOMELAN_INTF_DEV : goto bridge_filter_output_filter_HOMELAN,
        }
    }

    chain bridge_filter_output_filter_HOMELAN {
        counter comment "BEGIN inbound HOMELAN bridge/filter/output_filter"

        # HOMELAN: Include rules strictly for all sub-zones/sub-devices having bridge/filter/output regular chain
        include "bindings/devices/HOMELAN/rules/bridge-filter-output_filter*/*.rule"
    }
    # Split the chain so that other chains can be created (ie., dispatcher regular chain)


    # HOMELAN/ZONE: Include all zones having this device bridge/filter/output regular chain
    include "bindings/devices/HOMELAN/zones/subzones-bridge-filter-output_filter.table_block"

    # ZONE: Include all zones having this device bridge/filter/output regular chain
    # include "bindings/zones/zones-bridge-filter-output_filter.table_block"

    # (TODO: can we symbolically link to the parent zones/ZONE here, instead of include a duplicate ZONE?)

    # No need for HOMELAN/HOMELAN/ZONE; simply do a subdevice as HOMELAN/ZONE

    chain bridge_filter_output_filter_HOMELAN {
        counter comment "End inbound HOMELAN bridge/filter/output_filter"
    }

