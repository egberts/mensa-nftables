# File:     bindings-device-ip-filter-prerouting_filter.table_block
# Path:     bindings/devices/HOMELAN/
# Title:    Create regular chain and register with dispatcher of devices for ip/filter/prerouting base chain
# Family:   ip
# Type:     filter
# Hook:     prerouting
# Device:   HOMELAN
# Priority: -10 (filter(0) - 10)
# Policy:   *
# Table:    filter_ip
# Chain:    filter_ip_prerouting_filter
# Called by: binding/devices/HOMELAN/device-ip-filter-prerouting_filter.chain_block
# Description:
#

    # Add/register a Device Interface-to-firewall dispatch registry
    map map_dispatch_ip_filter_prerouting_filter_devices {
        typeof iif : verdict
        elements = {
            # use goto, this is the final descendance
            $HOMELAN_INTF_DEV : goto ip_filter_prerouting_filter_HOMELAN,
        }
    }

    chain ip_filter_prerouting_filter_HOMELAN {
        counter comment "BEGIN inbound HOMELAN ip/filter/prerouting_filter"

        # HOMELAN: Include rules strictly for all sub-zones/sub-devices having ip/filter/prerouting regular chain
        include "bindings/devices/HOMELAN/rules/ip-filter-prerouting_filter/*.rule"
    }
    # Split the chain so that other chains can be created (ie., dispatcher regular chain)


    # HOMELAN/ZONE: Include all zones having this device ip/filter/prerouting regular chain
    include "bindings/devices/HOMELAN/zones/subzones-ip-filter-prerouting_filter.table_block"

    # ZONE: Include all zones having this device ip/filter/prerouting regular chain
    # include "bindings/zones/zones-ip-filter-prerouting_filter.table_block"

    # (TODO: can we symbolically link to the parent zones/ZONE here, instead of include a duplicate ZONE?)

    # No need for HOMELAN/HOMELAN/ZONE; simply do a subdevice as HOMELAN/ZONE

    chain ip_filter_prerouting_filter_HOMELAN {
        counter comment "End inbound HOMELAN ip/filter/prerouting_filter"
    }

