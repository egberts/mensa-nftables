#
# File: subzones-ip-filter-output_raw.table_block
# Path: bindings/devices/HOMELAN/zones/
# Title: Include all subzones associated with this device for ip/filter/output
# Family: ip
# Type: filter
# Hook: output
# Device: HOMELAN
# Priority: +310 ((+300)+10)
# Table: filter_ip
# Chain: ip_filter_output_raw_HOMELAN
# Called by: bindings/devices/HOMELAN/binding-device-ip-filter-output_raw.table_block
#

    # going to need a registry table just for HOMELAN-ZONE
    chain dispatcher_ip_filter_output_raw_HOMELAN_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/HOMELAN/zones/*/zone-ip-filter-output_raw.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain ip_filter_output_raw_HOMELAN {
        jump dispatcher_ip_filter_output_raw_HOMELAN_ZONE
    }
