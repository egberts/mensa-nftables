#
# File: subzones-bridge-filter-prerouting_dstnat.table_block
# Path: bindings/devices/HOMELAN/zones/
# Title: Include all subzones associated with this device for bridge/filter/prerouting
# Family: bridge
# Type: filter
# Hook: prerouting
# Device: HOMELAN
# Priority: -310 (dstnat(300)-10)
# Table: filter_bridge
# Chain: bridge_filter_prerouting_dstnat_HOMELAN
# Called by: bindings/devices/HOMELAN/binding-device-bridge-filter-prerouting_dstnat.table_block
#

    # going to need a registry table just for HOMELAN-ZONE
    chain dispatcher_bridge_filter_prerouting_dstnat_HOMELAN_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/HOMELAN/zones/*/zone-bridge-filter-prerouting_dstnat.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain bridge_filter_prerouting_dstnat_HOMELAN {
        jump dispatcher_bridge_filter_prerouting_dstnat_HOMELAN_ZONE
    }
