#
# File: subzones-ip6-filter-prerouting_dstnat.table_block
# Path: bindings/devices/HOMELAN/zones/
# Title: Include all subzones associated with this device for ip6/filter/prerouting
# Family: ip6
# Type: filter
# Hook: prerouting
# Device: HOMELAN
# Priority: -110 (dstnat(-100)-10)
# Table: filter_ip6
# Chain: ip6_filter_prerouting_dstnat_HOMELAN
# Called by: bindings/devices/HOMELAN/binding-device-ip6-filter-prerouting_dstnat.table_block
#

    # going to need a registry table just for HOMELAN-ZONE
    chain dispatcher_ip6_filter_prerouting_dstnat_HOMELAN_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/HOMELAN/zones/*/zone-ip6-filter-prerouting_dstnat.chain_block"
    }

    # poor-mans dispatcher, sequential hooking
    chain ip6_filter_prerouting_dstnat_HOMELAN {

        jump dispatcher_ip6_filter_prerouting_dstnat_HOMELAN_ZONE
    }

