#
# File: subzones-inet-filter-ingress.table_block
# Path: bindings/devices/HOMELAN/zones/
# Title: Include all subzones associated with this device for inet/filter/ingress
# Family: inet
# Type: filter
# Hook: ingress
# Device: HOMELAN
# Priority: -10
# Policy: accept
# Table: filter_inet
# Chain: inet_filter_ingress_HOMELAN
# Called by: bindings/devices/HOMELAN/binding-device-bridge-filter-ingress.table_block
#

    # going to need a registry table just for HOMELAN-ZONE
    chain dispatcher_inet_filter_ingress_HOMELAN_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/HOMELAN/zones/*/zone-inet-filter-ingress.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain inet_filter_ingress_HOMELAN {
        jump dispatcher_inet_filter_ingress_HOMELAN_ZONE
    }
