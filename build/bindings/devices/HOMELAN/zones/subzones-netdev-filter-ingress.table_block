#
# File: subzones-netdev-filter-ingress.table_block
# Path: bindings/devices/HOMELAN/zones/
# Title: Include all subzones associated with this device for netdev/filter/ingress
# Family: netdev
# Type: filter
# Hook: ingress
# Device: HOMELAN
# Priority: -10
# Policy: accept
# Table: filter_netdev
# Chain: netdev_filter_ingress_HOMELAN
# Called by: bindings/devices/HOMELAN/binding-device-bridge-filter-ingress.table_block
#

    # going to need a registry table just for HOMELAN-ZONE
    chain dispatcher_netdev_filter_ingress_HOMELAN_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/HOMELAN/zones/*/zone-netdev-filter-ingress.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain netdev_filter_ingress_HOMELAN {
        jump dispatcher_netdev_filter_ingress_HOMELAN_ZONE
    }
