#
# File: subzones-ip6-route-output.table_block
# Path: bindings/devices/HOMELAN/zones/
# Title: Include all subzones associated with this device for ip6/route/output
# Family: ip6
# Type: route
# Hook: output
# Device: HOMELAN
# Priority: +10 (filter(0)+10)
# Policy: accept
# Table: route_ip6
# Chain: ip6_route_output_HOMELAN
# Called by: bindings/devices/HOMELAN/binding-device-ip6-route-output.table_block
#

    # going to need a registry table just for HOMELAN-ZONE
    chain dispatcher_ip6_route_output_HOMELAN_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/HOMELAN/zones/*/zone-ip6-route-output.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain ip6_route_output_HOMELAN {
        jump dispatcher_ip6_route_output_HOMELAN_ZONE
    }
