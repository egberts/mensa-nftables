#
# File: subzones-inet-filter-forward.table_block
# Path: bindings/devices/HOMELAN/zones/
# Title: Include all subzones associated with this device for inet/filter/forward
# Family: inet
# Type: filter
# Hook: forward
# Device: HOMELAN
# Priority: -10 (filter(0)-10)
# Table: filter_inet
# Chain: inet_filter_forward_HOMELAN
# Called by: bindings/devices/HOMELAN/binding-device-inet-filter-forward.table_block
#

    # going to need a registry table just for HOMELAN-ZONE
    chain dispatcher_inet_filter_forward_HOMELAN_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/HOMELAN/zones/*/zone-inet-filter-forward.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain inet_filter_forward_HOMELAN {
        jump dispatcher_inet_filter_forward_HOMELAN_ZONE
    }
