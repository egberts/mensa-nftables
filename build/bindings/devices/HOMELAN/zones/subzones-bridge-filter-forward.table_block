#
# File: subzones-bridge-filter-forward.table_block
# Path: bindings/devices/HOMELAN/zones/
# Title: Include all subzones associated with this device for bridge/filter/forward
# Family: bridge
# Table: filter_bridge
# Chain: bridge_filter_forward_HOMELAN
# Type: filter
# Hook: forward
# Device: HOMELAN
# Priority: -10 (brnf(0)-10)
# Called by: bindings/devices/HOMELAN/binding-device-bridge-filter-forward.table_block
#

    # going to need a registry table just for HOMELAN-ZONE
    chain dispatcher_bridge_filter_forward_HOMELAN_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/HOMELAN/zones/*/zone-bridge-filter-forward.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain bridge_filter_forward_HOMELAN {
        jump dispatcher_bridge_filter_forward_HOMELAN_ZONE
    }
