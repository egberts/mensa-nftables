#
# File: subzones-bridge-filter-input.table_block
# Path: bindings/devices/HOMELAN/zones/
# Title: Include all subzones associated with this device for bridge/filter/input
# Family: bridge
# Table: filter_bridge
# Chain: bridge_filter_input_HOMELAN
# Type: filter
# Hook: input
# Device: HOMELAN
# Priority: -210 (filter(-200)-10)
# Called by: bindings/devices/HOMELAN/binding-device-bridge-filter-input.table_block
#

    # going to need a registry table just for HOMELAN-ZONE
    chain dispatcher_bridge_filter_input_HOMELAN_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/HOMELAN/zones/*/zone-bridge-filter-input.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain bridge_filter_input_HOMELAN {
        jump dispatcher_bridge_filter_input_HOMELAN_ZONE
    }
