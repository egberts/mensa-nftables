#
# File: subzones-arp-filter-input.table_block
# Path: bindings/devices/HOMELAN/zones/
# Title: Include all subzones associated with this device for arp/filter/input
# Family: arp
# Table: filter_arp
# Chain: arp_filter_input_HOMELAN
# Type: filter
# Hook: input
# Device: HOMELAN
# Priority: -10
# Called by: bindings/devices/HOMELAN/binding-device-bridge-filter-input.table_block
#

    # going to need a registry table just for HOMELAN-ZONE
    chain dispatcher_arp_filter_input_HOMELAN_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/HOMELAN/zones/*/zone-arp-filter-input.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain arp_filter_input_HOMELAN {
        jump dispatcher_arp_filter_input_HOMELAN_ZONE
    }
