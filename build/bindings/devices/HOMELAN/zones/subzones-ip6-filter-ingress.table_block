#
# File: subzones-ip6-filter-ingress.table_block
# Path: bindings/devices/HOMELAN/zones/
# Title: Include all subzones associated with this device for ip6/filter/ingress
# Family: ip6
# Type: filter
# Hook: ingress
# Device: HOMELAN
# Priority: -10
# Policy: accept
# Table: filter_ip6
# Chain: ip6_filter_ingress_HOMELAN
# Called by: bindings/devices/HOMELAN/binding-device-bridge-filter-ingress.table_block
#

    # going to need a registry table just for HOMELAN-ZONE
    chain dispatcher_ip6_filter_ingress_HOMELAN_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/HOMELAN/zones/*/zone-ip6-filter-ingress.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain ip6_filter_ingress_HOMELAN {

        jump dispatcher_ip6_filter_ingress_HOMELAN_ZONE
    }

