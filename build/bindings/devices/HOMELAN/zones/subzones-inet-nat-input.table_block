#
# File: subzones-inet-nat-input.table_block
# Path: bindings/devices/HOMELAN/zones/
# Title: Include all subzones associated with this device for inet/nat/input
# Family: inet
# Type: nat
# Hook: input
# Device: HOMELAN
# Priority: -10 (nat(0)-10)
# Table: nat_inet
# Chain: inet_nat_input_HOMELAN
# Called by: bindings/devices/HOMELAN/binding-device-inet-nat-input.table_block
#

    # going to need a registry table just for HOMELAN-ZONE
    chain dispatcher_inet_nat_input_HOMELAN_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/HOMELAN/zones/*/zone-inet-nat-input.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain inet_nat_input_HOMELAN {
        jump dispatcher_inet_nat_input_HOMELAN_ZONE
    }
