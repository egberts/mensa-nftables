#
# File:     bindings-device-inet-filter-postrouting_mangle.table_block
# Path:     bindings/devices/HOMELAN/
# Title:    Regular chain with dispatcher for inet/filter/postrouting for mangle(-150) priority
# Family:   inet
# Type:     filter
# Hook:     postrouting
# Device:   HOMELAN
# Priority: -160 (mangle(-150)-10)
# Policy:   accept
# Table:    filter_inet
# Chain:    filter_inet_postrouting_mangle
# Called by: binding/devices/HOMELAN/device-inet-filter-postrouting_mangle.chain_block
# Description:
#

    # Add/register a Device Interface-to-firewall dispatch registry
    map map_dispatch_inet_filter_postrouting_mangle_devices {
        typeof oif : verdict
        elements = {
            # use goto, this is the final descendance
            $HOMELAN_INTF_DEV : goto inet_filter_postrouting_mangle_HOMELAN,
        }
    }

    chain inet_filter_postrouting_mangle_HOMELAN {
        counter comment "BEGIN outbound HOMELAN inet/filter/postrouting_mangle"

        # HOMELAN: Include rules strictly for all sub-zones/sub-devices having inet/filter/postrouting regular chain
        include "bindings/devices/HOMELAN/rules/inet-filter-postrouting_mangle*/*.rule"
    }
    # Split the chain so that other chains can be created (ie., dispatcher regular chain)


    # HOMELAN/ZONE: Include all zones having this device inet/filter/postrouting regular chain
    include "bindings/devices/HOMELAN/zones/subzones-inet-filter-postrouting_mangle.table_block"

    # ZONE: Include all zones having this device inet/filter/postrouting regular chain
    # include "bindings/zones/zones-inet-filter-postrouting_mangle.table_block"

    # (TODO: can we symbolically link to the parent zones/ZONE here, instead of include a duplicate ZONE?)

    # No need for HOMELAN/HOMELAN/ZONE; simply do a subdevice as HOMELAN/ZONE

    chain inet_filter_postrouting_mangle_HOMELAN {
        counter comment "End outbound HOMELAN inet/filter/postrouting_mangle"
    }

