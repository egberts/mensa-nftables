# File:     bindings-device-arp-filter-input.table_block
# Path:     bindings/devices/HOMELAN/
# Title:    Create regular chain and register with dispatcher of devices for arp/filter/input base chain
# Family:   arp
# Table:    filter_arp
# Chain:    filter_arp_input
# Type:     filter
# Hook:     input
# Device:   HOMELAN
# Priority: *
# Policy:   *
# Called by: binding/devices/HOMELAN/device-arp-filter-input.chain_block
# Description:
#

    # Add/register a Device Interface-to-firewall dispatch registry
    map map_dispatch_arp_filter_input_devices {
        typeof iif : verdict
        elements = {
            # use goto, this is the final descendance
            $HOMELAN_INTF_DEV : goto arp_filter_input_HOMELAN,
        }
    }

    chain arp_filter_input_HOMELAN {
        counter comment "BEGIN inbound HOMELAN arp/filter/input"

        # HOMELAN: Include rules strictly for all sub-zones/sub-devices having arp/filter/input regular chain
        include "bindings/devices/HOMELAN/rules/arp-filter-input/*.rule"
    }
    # Split the chain so that other chains can be created (ie., dispatcher regular chain)


    # HOMELAN/ZONE: Include all zones having this device arp/filter/input regular chain
    include "bindings/devices/HOMELAN/zones/subzones-arp-filter-input.table_block"

    # ZONE: Include all zones having this device arp/filter/input regular chain
    # include "bindings/zones/zones-arp-filter-input.table_block"

    # (TODO: can we symbolically link to the parent zones/ZONE here, instead of include a duplicate ZONE?)

    # No need for HOMELAN/HOMELAN/ZONE; simply do a subdevice as HOMELAN/ZONE

    chain arp_filter_input_HOMELAN {
        counter comment "End inbound HOMELAN arp/filter/input"
    }

