# File:     bindings-device-ip-filter-input.table_block
# Path:     bindings/devices/HOMELAN/
# Title:    Create regular chain and register with dispatcher of devices for ip/filter/input base chain
# Family:   ip
# Table:    filter_ip
# Chain:    filter_ip_input
# Type:     filter
# Hook:     input
# Device:   HOMELAN
# Priority: -110 (dstnat(-100)-10)
# Policy:   DROP
# Called by: binding/devices/HOMELAN/device-ip-filter-input.chain_block
# Description:
#

    # Add/register a Device Interface-to-firewall dispatch registry
    map map_dispatch_ip_filter_input_devices {
        typeof iif : verdict
        elements = {
            # use goto, this is the final descendance
            $HOMELAN_INTF_DEV : goto ip_filter_input_HOMELAN,
        }
    }

    chain ip_filter_input_HOMELAN {
        counter comment "BEGIN inbound HOMELAN ip/filter/input"

        # HOMELAN: Include rules strictly for all sub-zones/sub-devices having ip/filter/input regular chain
        include "bindings/devices/HOMELAN/rules/ip-filter-input/*.rule"
    }
    # Split the chain so that other chains can be created (ie., dispatcher regular chain)


    # HOMELAN/ZONE: Include all zones having this device ip/filter/input regular chain
    include "bindings/devices/HOMELAN/zones/subzones-ip-filter-input.table_block"

    # ZONE: Include all zones having this device ip/filter/input regular chain
    # include "bindings/zones/zones-ip-filter-input.table_block"

    # (TODO: can we symbolically link to the parent zones/ZONE here, instead of include a duplicate ZONE?)

    # No need for HOMELAN/HOMELAN/ZONE; simply do a subdevice as HOMELAN/ZONE

    chain ip_filter_input_HOMELAN {
        counter comment "End inbound HOMELAN ip/filter/input"
    }

