
# File: 021-DHCP-udp-dport67-out-req-accept.rule
# Policy: Allow local DHCPv4 client request to remote DHCPv4 server


meta nfproto ipv4 udp sport 68 udp dport 67 counter accept \
    comment "local-to-remote DHCP/UDP/67 request"

udp dport 67 udp sport 68 notrack counter accept comment "local-to-remote DHCP/UDP/67 request"
