# File:     bindings-device-arp-filter-output.table_block
# Path:     bindings/devices/LOOPBACK/
# Title:    Create regular chain and register with dispatcher of devices for arp/filter/output base chain
# Family:   arp
# Table:    filter_arp
# Chain:    filter_arp_output
# Type:     filter
# Hook:     output
# Device:   LOOPBACK
# Priority: *
# Policy:   *
# Called by: binding/devices/LOOPBACK/device-arp-filter-output.chain_block
# Description:
#

    # Add/register a Device Interface-to-firewall dispatch registry
    map map_dispatch_arp_filter_output_devices {
        typeof oif : verdict
        elements = {
            # use goto, this is the final descendance
            $LOOPBACK_INTF_DEV : goto arp_filter_output_LOOPBACK,
        }
    }

    chain arp_filter_output_LOOPBACK {
        counter comment "BEGIN inbound LOOPBACK arp/filter/output"

        # LOOPBACK: Include rules strictly for all sub-zones/sub-devices having arp/filter/output regular chain
        include "bindings/devices/LOOPBACK/rules/arp-filter-output/*.rule"
    }
    # Split the chain so that other chains can be created (ie., dispatcher regular chain)


    # LOOPBACK/ZONE: Include all zones having this device arp/filter/output regular chain
    include "bindings/devices/LOOPBACK/zones/subzones-arp-filter-output.table_block"

    # ZONE: Include all zones having this device arp/filter/output regular chain
    # include "bindings/zones/zones-arp-filter-output.table_block"

    # (TODO: can we symbolically link to the parent zones/ZONE here, instead of include a duplicate ZONE?)

    # No need for LOOPBACK/LOOPBACK/ZONE; simply do a subdevice as LOOPBACK/ZONE

    chain arp_filter_output_LOOPBACK {
        counter comment "End inbound LOOPBACK arp/filter/output"
    }

