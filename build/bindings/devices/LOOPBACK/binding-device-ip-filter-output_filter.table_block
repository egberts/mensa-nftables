# File:     bindings-device-ip-filter-output_filter.table_block
# Path:     bindings/devices/LOOPBACK/
# Title:    regular dispatcher for ip/filter/output base with for filter(0) priority
# Family:   ip
# Type:     filter
# Hook:     output
# Device:   LOOPBACK
# Priority: +10 (filter(0)+10)
# Policy:   DROP
# Table:    filter_ip
# Chain:    filter_ip_output_filter
# Called by: binding/devices/LOOPBACK/device-ip-filter-output_filter.chain_block
# Description:
#

    # Add/register a Device Interface-to-firewall dispatch registry
    map map_dispatch_ip_filter_output_filter_devices {
        typeof oif : verdict
        elements = {
            # use goto, this is the final descendance
            $LOOPBACK_INTF_DEV : goto ip_filter_output_filter_LOOPBACK,
        }
    }

    chain ip_filter_output_filter_LOOPBACK {
        counter comment "BEGIN inbound LOOPBACK ip/filter/output_filter"

        # LOOPBACK: Include rules strictly for all sub-zones/sub-devices having ip/filter/output regular chain
        include "bindings/devices/LOOPBACK/rules/ip-filter-output_filter*/*.rule"
    }
    # Split the chain so that other chains can be created (ie., dispatcher regular chain)


    # LOOPBACK/ZONE: Include all zones having this device ip/filter/output regular chain
    include "bindings/devices/LOOPBACK/zones/subzones-ip-filter-output_filter.table_block"

    # ZONE: Include all zones having this device ip/filter/output regular chain
    # include "bindings/zones/zones-ip-filter-output_filter.table_block"

    # (TODO: can we symbolically link to the parent zones/ZONE here, instead of include a duplicate ZONE?)

    # No need for LOOPBACK/LOOPBACK/ZONE; simply do a subdevice as LOOPBACK/ZONE

    chain ip_filter_output_filter_LOOPBACK {
        counter comment "End inbound LOOPBACK ip/filter/output_filter"
    }

