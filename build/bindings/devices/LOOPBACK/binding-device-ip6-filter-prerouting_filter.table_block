# File:     bindings-device-ip6-filter-prerouting_filter.table_block
# Path:     bindings/devices/LOOPBACK/
# Title:    Create regular chain and register with dispatcher of devices for ip6/filter/prerouting base chain
# Family:   ip6
# Type:     filter
# Hook:     prerouting
# Device:   LOOPBACK
# Priority: -10 (filter(0) - 10)
# Policy:   *
# Table:    filter_ip6
# Chain:    filter_ip6_prerouting_filter
# Called by: binding/devices/LOOPBACK/device-ip6-filter-prerouting_filter.chain_block
# Description:
#

    # Add/register a Device Interface-to-firewall dispatch registry
    map map_dispatch_ip6_filter_prerouting_filter_devices {
        typeof iif : verdict
        elements = {
            # use goto, this is the final descendance
            $LOOPBACK_INTF_DEV : goto ip6_filter_prerouting_filter_LOOPBACK,
        }
    }

    chain ip6_filter_prerouting_filter_LOOPBACK {
        counter comment "BEGIN inbound LOOPBACK ip6/filter/prerouting_filter"

        # LOOPBACK: Include rules strictly for all sub-zones/sub-devices having ip6/filter/prerouting regular chain
        include "bindings/devices/LOOPBACK/rules/ip6-filter-prerouting_filter/*.rule"
    }
    # Split the chain so that other chains can be created (ie., dispatcher regular chain)


    # LOOPBACK/ZONE: Include all zones having this device ip6/filter/prerouting regular chain
    include "bindings/devices/LOOPBACK/zones/subzones-ip6-filter-prerouting_filter.table_block"

    # ZONE: Include all zones having this device ip6/filter/prerouting regular chain
    # include "bindings/zones/zones-ip6-filter-prerouting_filter.table_block"

    # (TODO: can we symbolically link to the parent zones/ZONE here, instead of include a duplicate ZONE?)

    # No need for LOOPBACK/LOOPBACK/ZONE; simply do a subdevice as LOOPBACK/ZONE

    chain ip6_filter_prerouting_filter_LOOPBACK {
        counter comment "End inbound LOOPBACK ip6/filter/prerouting_filter"
    }

