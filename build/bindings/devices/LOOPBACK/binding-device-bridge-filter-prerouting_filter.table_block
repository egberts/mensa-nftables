# File:     bindings-device-bridge-filter-prerouting_filter.table_block
# Path:     bindings/devices/LOOPBACK/
# Title:    Regular chain with dispatcher for bridge/filter/prerouting for filter(0) priority
# Family:   bridge
# Type:     filter
# Hook:     prerouting
# Device:   LOOPBACK
# Priority: -10 (filter(0)-10)
# Policy:   *
# Table:    filter_bridge
# Chain:    filter_bridge_prerouting_filter
# Called by: binding/devices/LOOPBACK/device-bridge-filter-prerouting_filter.chain_block
# Description:
#

    # Add/register a Device Interface-to-firewall dispatch registry
    map map_dispatch_bridge_filter_prerouting_filter_devices {
        typeof iif : verdict
        elements = {
            # use goto, this is the final descendance
            $LOOPBACK_INTF_DEV : goto bridge_filter_prerouting_filter_LOOPBACK,
        }
    }

    chain bridge_filter_prerouting_filter_LOOPBACK {
        counter comment "BEGIN inbound LOOPBACK bridge/filter/prerouting_filter"

        # LOOPBACK: Include rules strictly for all sub-zones/sub-devices having bridge/filter/prerouting regular chain
        include "bindings/devices/LOOPBACK/rules/bridge-filter-prerouting_filter*/*.rule"
    }
    # Split the chain so that other chains can be created (ie., dispatcher regular chain)


    # LOOPBACK/ZONE: Include all zones having this device bridge/filter/prerouting regular chain
    include "bindings/devices/LOOPBACK/zones/subzones-bridge-filter-prerouting_filter.table_block"

    # ZONE: Include all zones having this device bridge/filter/prerouting regular chain
    # include "bindings/zones/zones-bridge-filter-prerouting_filter.table_block"

    # (TODO: can we symbolically link to the parent zones/ZONE here, instead of include a duplicate ZONE?)

    # No need for LOOPBACK/LOOPBACK/ZONE; simply do a subdevice as LOOPBACK/ZONE

    chain bridge_filter_prerouting_filter_LOOPBACK {
        counter comment "End inbound LOOPBACK bridge/filter/prerouting_filter"
    }

