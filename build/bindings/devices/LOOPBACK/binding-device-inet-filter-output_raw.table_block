# File:     bindings-device-inet-filter-output_raw.table_block
# Path:     bindings/devices/LOOPBACK/
# Title:    Regular chain with dispatcher for inet/filter/output with raw(300) priority
# Family:   inet
# Type:     filter
# Hook:     output
# Device:   LOOPBACK
# Priority: +310 ((300)+10)
# Policy:   DROP
# Table:    filter_inet
# Chain:    filter_inet_output_raw
# Called by: binding/devices/LOOPBACK/device-inet-filter-output_raw.chain_block
# Description:
#

    # Add/register a Device Interface-to-firewall dispatch registry
    map map_dispatch_inet_filter_output_raw_devices {
        typeof oif : verdict
        elements = {
            # use goto, this is the final descendance
            $LOOPBACK_INTF_DEV : goto inet_filter_output_raw_LOOPBACK,
        }
    }

    chain inet_filter_output_raw_LOOPBACK {
        counter comment "BEGIN inbound LOOPBACK inet/filter/output_raw"

        # LOOPBACK: Include rules strictly for all sub-zones/sub-devices having inet/filter/output regular chain
        include "bindings/devices/LOOPBACK/rules/inet-filter-output_raw*/*.rule"
    }
    # Split the chain so that other chains can be created (ie., dispatcher regular chain)


    # LOOPBACK/ZONE: Include all zones having this device inet/filter/output regular chain
    include "bindings/devices/LOOPBACK/zones/subzones-inet-filter-output_raw.table_block"

    # ZONE: Include all zones having this device inet/filter/output regular chain
    # include "bindings/zones/zones-inet-filter-output_raw.table_block"

    # (TODO: can we symbolically link to the parent zones/ZONE here, instead of include a duplicate ZONE?)

    # No need for LOOPBACK/LOOPBACK/ZONE; simply do a subdevice as LOOPBACK/ZONE

    chain inet_filter_output_raw_LOOPBACK {
        counter comment "End inbound LOOPBACK inet/filter/output_raw"
    }

