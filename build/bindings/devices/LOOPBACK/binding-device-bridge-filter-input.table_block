# File:     bindings-device-bridge-filter-input.table_block
# Path:     bindings/devices/LOOPBACK/
# Title:    Create regular chain and register with dispatcher of devices for bridge/filter/input base chain
# Family:   bridge
# Table:    filter_bridge
# Chain:    filter_bridge_input
# Type:     filter
# Hook:     input
# Device:   LOOPBACK
# Priority: *
# Policy:   *
# Called by: binding/devices/LOOPBACK/device-bridge-filter-input.chain_block
# Description:
#

    # Add/register a Device Interface-to-firewall dispatch registry
    map map_dispatch_bridge_filter_input_devices {
        typeof iif : verdict
        elements = {
            # use goto, this is the final descendance
            $LOOPBACK_INTF_DEV : goto bridge_filter_input_LOOPBACK,
        }
    }

    chain bridge_filter_input_LOOPBACK {
        counter comment "BEGIN inbound LOOPBACK bridge/filter/input"

        # LOOPBACK: Include rules strictly for all sub-zones/sub-devices having bridge/filter/input regular chain
        include "bindings/devices/LOOPBACK/rules/bridge-filter-input/*.rule"
    }
    # Split the chain so that other chains can be created (ie., dispatcher regular chain)


    # LOOPBACK/ZONE: Include all zones having this device bridge/filter/input regular chain
    include "bindings/devices/LOOPBACK/zones/subzones-bridge-filter-input.table_block"

    # ZONE: Include all zones having this device bridge/filter/input regular chain
    # include "bindings/zones/zones-bridge-filter-input.table_block"

    # (TODO: can we symbolically link to the parent zones/ZONE here, instead of include a duplicate ZONE?)

    # No need for LOOPBACK/LOOPBACK/ZONE; simply do a subdevice as LOOPBACK/ZONE

    chain bridge_filter_input_LOOPBACK {
        counter comment "End inbound LOOPBACK bridge/filter/input"
    }

