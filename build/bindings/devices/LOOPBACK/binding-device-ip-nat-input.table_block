# File:     bindings-device-ip-nat-input.table_block
# Path:     bindings/devices/LOOPBACK/
# Title:    Create regular chain and register with dispatcher of devices for ip/nat/input base chain
# Family:   ip
# Type:     nat
# Hook:     input
# Device:   LOOPBACK
# Priority: -10 (filter(0)-10)
# Policy:   accept
# Table:    nat_ip
# Chain:    nat_ip_input
# Called by: binding/devices/LOOPBACK/device-ip-nat-input.chain_block
# Description:
#

    # Add/register a Device Interface-to-firewall dispatch registry
    map map_dispatch_ip_nat_input_devices {
        typeof iif : verdict
        elements = {
            # use goto, this is the final descendance
            $LOOPBACK_INTF_DEV : goto ip_nat_input_LOOPBACK,
        }
    }

    chain ip_nat_input_LOOPBACK {
        counter comment "BEGIN inbound LOOPBACK ip/nat/input"

        # LOOPBACK: Include rules strictly for all sub-zones/sub-devices having ip/nat/input regular chain
        include "bindings/devices/LOOPBACK/rules/ip-nat-input/*.rule"
    }
    # Split the chain so that other chains can be created (ie., dispatcher regular chain)


    # LOOPBACK/ZONE: Include all zones having this device ip/nat/input regular chain
    include "bindings/devices/LOOPBACK/zones/subzones-ip-nat-input.table_block"

    # ZONE: Include all zones having this device ip/nat/input regular chain
    # include "bindings/zones/zones-ip-nat-input.table_block"

    # (TODO: can we symbolically link to the parent zones/ZONE here, instead of include a duplicate ZONE?)

    # No need for LOOPBACK/LOOPBACK/ZONE; simply do a subdevice as LOOPBACK/ZONE

    chain ip_nat_input_LOOPBACK {
        counter comment "End inbound LOOPBACK ip/nat/input"
    }

