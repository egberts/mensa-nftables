# File:     bindings-device-ip6-filter-output_raw.table_block
# Path:     bindings/devices/LOOPBACK/
# Title:    Regular chain with dispatcher for ip6/filter/output with raw(300) priority
# Family:   ip6
# Type:     filter
# Hook:     output
# Device:   LOOPBACK
# Priority: +310 ((300)+10)
# Policy:   DROP
# Table:    filter_ip6
# Chain:    filter_ip6_output_raw
# Called by: binding/devices/LOOPBACK/device-ip6-filter-output_raw.chain_block
# Description:
#

    # Add/register a Device Interface-to-firewall dispatch registry
    map map_dispatch_ip6_filter_output_raw_devices {
        typeof oif : verdict
        elements = {
            # use goto, this is the final descendance
            $LOOPBACK_INTF_DEV : goto ip6_filter_output_raw_LOOPBACK,
        }
    }

    chain ip6_filter_output_raw_LOOPBACK {
        counter comment "BEGIN inbound LOOPBACK ip6/filter/output_raw"

        # LOOPBACK: Include rules strictly for all sub-zones/sub-devices having ip6/filter/output regular chain
        include "bindings/devices/LOOPBACK/rules/ip6-filter-output_raw*/*.rule"
    }
    # Split the chain so that other chains can be created (ie., dispatcher regular chain)


    # LOOPBACK/ZONE: Include all zones having this device ip6/filter/output regular chain
    include "bindings/devices/LOOPBACK/zones/subzones-ip6-filter-output_raw.table_block"

    # ZONE: Include all zones having this device ip6/filter/output regular chain
    # include "bindings/zones/zones-ip6-filter-output_raw.table_block"

    # (TODO: can we symbolically link to the parent zones/ZONE here, instead of include a duplicate ZONE?)

    # No need for LOOPBACK/LOOPBACK/ZONE; simply do a subdevice as LOOPBACK/ZONE

    chain ip6_filter_output_raw_LOOPBACK {
        counter comment "End inbound LOOPBACK ip6/filter/output_raw"
    }

