#
# File: subzones-ip-filter-postrouting_mangle.table_block
# Path: bindings/devices/LOOPBACK/zones/
# Title: Include all subzones associated with this device for ip/filter/postrouting
# Family: ip
# Type: filter
# Hook: postrouting
# Device: LOOPBACK
# Priority: -160 (mangle(-150)-10)
# Table: filter_ip
# Chain: ip_filter_postrouting_mangle_LOOPBACK
# Called by: bindings/devices/LOOPBACK/binding-device-ip-filter-postrouting_mangle.table_block
#

    # going to need a registry table just for LOOPBACK-ZONE
    chain dispatcher_ip_filter_postrouting_mangle_LOOPBACK_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/LOOPBACK/zones/*/zone-ip-filter-postrouting_mangle.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain ip_filter_postrouting_mangle_LOOPBACK {
        jump dispatcher_ip_filter_postrouting_mangle_LOOPBACK_ZONE
    }
