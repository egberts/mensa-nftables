#
# File: subzones-netdev-filter-ingress.table_block
# Path: bindings/devices/LOOPBACK/zones/
# Title: Include all subzones associated with this device for netdev/filter/ingress
# Family: netdev
# Type: filter
# Hook: ingress
# Device: LOOPBACK
# Priority: -10
# Policy: accept
# Table: filter_netdev
# Chain: netdev_filter_ingress_LOOPBACK
# Called by: bindings/devices/LOOPBACK/binding-device-bridge-filter-ingress.table_block
#

    # going to need a registry table just for LOOPBACK-ZONE
    chain dispatcher_netdev_filter_ingress_LOOPBACK_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/LOOPBACK/zones/*/zone-netdev-filter-ingress.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain netdev_filter_ingress_LOOPBACK {
        jump dispatcher_netdev_filter_ingress_LOOPBACK_ZONE
    }
