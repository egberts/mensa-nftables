#
# File: subzones-ip6-filter-postrouting_filter.table_block
# Path: bindings/devices/LOOPBACK/zones/
# Title: Include all subzones associated with this device for ip6/filter/postrouting
# Family: ip6
# Type: filter
# Hook: postrouting
# Device: LOOPBACK
# Priority: +10 (filter(0)+10)
# Table: filter_ip6
# Chain: ip6_filter_postrouting_filter_LOOPBACK
# Called by: bindings/devices/LOOPBACK/binding-device-ip6-filter-postrouting_filter.table_block
#

    # going to need a registry table just for LOOPBACK-ZONE
    chain dispatcher_ip6_filter_postrouting_filter_lo_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/LOOPBACK/zones/*/zone-ip6-filter-postrouting_filter.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain ip6_filter_postrouting_filter_LOOPBACK {
        jump dispatcher_ip6_filter_postrouting_filter_lo_ZONE
    }
