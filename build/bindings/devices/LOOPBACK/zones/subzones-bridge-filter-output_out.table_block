#
# File: subzones-bridge-filter-output_out.table_block
# Path: bindings/devices/LOOPBACK/zones/
# Title: Include all subzones associated with this device for bridge/filter/output
# Family: bridge
# Type: filter
# Hook: output
# Device: LOOPBACK
# Priority: +110 (out(100)+10)
# Table: filter_bridge
# Chain: bridge_filter_output_out_LOOPBACK
# Called by: bindings/devices/LOOPBACK/binding-device-bridge-filter-output_out.table_block
#

    # going to need a registry table just for LOOPBACK-ZONE
    chain dispatcher_bridge_filter_output_out_LOOPBACK_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/LOOPBACK/zones/*/zone-bridge-filter-output_out.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain bridge_filter_output_out_LOOPBACK {
        jump dispatcher_bridge_filter_output_out_LOOPBACK_ZONE
    }
