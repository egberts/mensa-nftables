#
# File: subzones-inet-route-output.table_block
# Path: bindings/devices/LOOPBACK/zones/
# Title: Include all subzones associated with this device for inet/route/output
# Family: inet
# Type: route
# Hook: output
# Device: LOOPBACK
# Priority: +10 (filter(0)+10)
# Policy: accept
# Table: route_inet
# Chain: inet_route_output_LOOPBACK
# Called by: bindings/devices/LOOPBACK/binding-device-inet-route-output.table_block
#

    # going to need a registry table just for LOOPBACK-ZONE
    chain dispatcher_inet_route_output_lo_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/LOOPBACK/zones/*/zone-inet-route-output.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain inet_route_output_LOOPBACK {
        jump dispatcher_inet_route_output_lo_ZONE
    }
