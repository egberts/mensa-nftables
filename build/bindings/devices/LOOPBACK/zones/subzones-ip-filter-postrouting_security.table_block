#
# File: subzones-ip-filter-postrouting_security.table_block
# Path: bindings/devices/LOOPBACK/zones/
# Title: Include all subzones associated with this device for ip/filter/postrouting
# Family: ip
# Type: filter
# Hook: postrouting
# Device: LOOPBACK
# Priority: +110 (srcnat(100)+10)
# Table: filter_ip
# Chain: ip_filter_postrouting_security_LOOPBACK
# Called by: bindings/devices/LOOPBACK/binding-device-ip-filter-postrouting_security.table_block
#

    # going to need a registry table just for LOOPBACK-ZONE
    chain dispatcher_ip_filter_postrouting_security_lo_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/LOOPBACK/zones/*/zone-ip-filter-postrouting_security.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain ip_filter_postrouting_security_LOOPBACK {
        jump dispatcher_ip_filter_postrouting_security_lo_ZONE
    }
