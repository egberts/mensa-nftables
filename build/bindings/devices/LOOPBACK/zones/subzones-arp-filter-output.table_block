#
# File: subzones-arp-filter-output.table_block
# Path: bindings/devices/LOOPBACK/zones/
# Title: Include all subzones associated with this device for arp/filter/output
#

    # going to need a registry table just for LOOPBACK-ZONE
    chain dispatcher_arp_filter_output_LOOPBACK_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/LOOPBACK/zones/*/zone-arp-filter-output.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain arp_filter_output_LOOPBACK {
        jump dispatcher_arp_filter_output_LOOPBACK_ZONE
    }
