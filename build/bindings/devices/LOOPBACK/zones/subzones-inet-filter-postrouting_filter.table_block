#
# File: subzones-inet-filter-postrouting_filter.table_block
# Path: bindings/devices/LOOPBACK/zones/
# Title: Include all subzones associated with this device for inet/filter/postrouting
# Family: inet
# Type: filter
# Hook: postrouting
# Device: LOOPBACK
# Priority: +10 (filter(0)+10)
# Table: filter_inet
# Chain: inet_filter_postrouting_filter_LOOPBACK
# Called by: bindings/devices/LOOPBACK/binding-device-inet-filter-postrouting_filter.table_block
#

    # going to need a registry table just for LOOPBACK-ZONE
    chain dispatcher_inet_filter_postrouting_filter_LOOPBACK_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/LOOPBACK/zones/*/zone-inet-filter-postrouting_filter.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain inet_filter_postrouting_filter_LOOPBACK {
        jump dispatcher_inet_filter_postrouting_filter_LOOPBACK_ZONE
    }
