#
# File: subzones-inet-filter-ingress.table_block
# Path: bindings/devices/LOOPBACK/zones/
# Title: Include all subzones associated with this device for inet/filter/ingress
# Family: inet
# Type: filter
# Hook: ingress
# Device: LOOPBACK
# Priority: -10
# Policy: accept
# Table: filter_inet
# Chain: inet_filter_ingress_LOOPBACK
# Called by: bindings/devices/LOOPBACK/binding-device-bridge-filter-ingress.table_block
#

    # going to need a registry table just for LOOPBACK-ZONE
    chain dispatcher_inet_filter_ingress_lo_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/LOOPBACK/zones/*/zone-inet-filter-ingress.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain inet_filter_ingress_LOOPBACK {
        jump dispatcher_inet_filter_ingress_lo_ZONE
    }
