#
# File: subzones-ip6-nat-input.table_block
# Path: bindings/devices/LOOPBACK/zones/
# Title: Include all subzones associated with this device for ip6/nat/input
# Family: ip6
# Type: nat
# Hook: input
# Device: LOOPBACK
# Priority: -10 (nat(0)-10)
# Table: nat_ip6
# Chain: ip6_nat_input_LOOPBACK
# Called by: bindings/devices/LOOPBACK/binding-device-ip6-nat-input.table_block
#

    # going to need a registry table just for LOOPBACK-ZONE
    chain dispatcher_ip6_nat_input_lo_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/LOOPBACK/zones/*/zone-ip6-nat-input.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain ip6_nat_input_LOOPBACK {
        jump dispatcher_ip6_nat_input_lo_ZONE
    }
