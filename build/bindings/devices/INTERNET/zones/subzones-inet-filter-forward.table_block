#
# File: subzones-inet-filter-forward.table_block
# Path: bindings/devices/INTERNET/zones/
# Title: Include all subzones associated with this device for inet/filter/forward
# Family: inet
# Type: filter
# Hook: forward
# Device: INTERNET
# Priority: -10 (filter(0)-10)
# Table: filter_inet
# Chain: inet_filter_forward_INTERNET
# Called by: bindings/devices/INTERNET/binding-device-inet-filter-forward.table_block
#

    # going to need a registry table just for INTERNET-ZONE
    chain dispatcher_inet_filter_forward_INTERNET_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/INTERNET/zones/*/zone-inet-filter-forward.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain inet_filter_forward_INTERNET {
        jump dispatcher_inet_filter_forward_INTERNET_ZONE
    }
