#
# File: subzones-inet-filter-ingress.table_block
# Path: bindings/devices/INTERNET/zones/
# Title: Include all subzones associated with this device for inet/filter/ingress
# Family: inet
# Type: filter
# Hook: ingress
# Device: INTERNET
# Priority: -10
# Policy: accept
# Table: filter_inet
# Chain: inet_filter_ingress_INTERNET
# Called by: bindings/devices/INTERNET/binding-device-bridge-filter-ingress.table_block
#

    # going to need a registry table just for INTERNET-ZONE
    chain dispatcher_inet_filter_ingress_INTERNET_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/INTERNET/zones/*/zone-inet-filter-ingress.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain inet_filter_ingress_INTERNET {
        jump dispatcher_inet_filter_ingress_INTERNET_ZONE
    }
