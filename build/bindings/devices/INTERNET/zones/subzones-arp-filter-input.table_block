#
# File: subzones-arp-filter-input.table_block
# Path: bindings/devices/INTERNET/zones/
# Title: Include all subzones associated with this device for arp/filter/input
# Family: arp
# Table: filter_arp
# Chain: arp_filter_input_INTERNET
# Type: filter
# Hook: input
# Device: INTERNET
# Priority: -10
# Called by: bindings/devices/INTERNET/binding-device-bridge-filter-input.table_block
#

    # going to need a registry table just for INTERNET-ZONE
    chain dispatcher_arp_filter_input_INTERNET_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/INTERNET/zones/*/zone-arp-filter-input.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain arp_filter_input_INTERNET {
        jump dispatcher_arp_filter_input_INTERNET_ZONE
    }
