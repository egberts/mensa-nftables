#
# File: subzones-inet-filter-postrouting_srcnat.table_block
# Path: bindings/devices/INTERNET/zones/
# Title: Include all subzones associated with this device for inet/filter/postrouting
# Family: inet
# Type: filter
# Hook: postrouting
# Device: INTERNET
# Priority: +110 (srcnat(100)+10)
# Table: filter_inet
# Chain: inet_filter_postrouting_srcnat_INTERNET
# Called by: bindings/devices/INTERNET/binding-device-inet-filter-postrouting_srcnat.table_block
#

    # going to need a registry table just for INTERNET-ZONE
    chain dispatcher_inet_filter_postrouting_srcnat_INTERNET_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/INTERNET/zones/*/zone-inet-filter-postrouting_srcnat.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain inet_filter_postrouting_srcnat_INTERNET {
        jump dispatcher_inet_filter_postrouting_srcnat_INTERNET_ZONE
    }
