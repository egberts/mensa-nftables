#
# File: subzones-inet-filter-output_raw.table_block
# Path: bindings/devices/INTERNET/zones/
# Title: Include all subzones associated with this device for inet/filter/output
# Family: inet
# Type: filter
# Hook: output
# Device: INTERNET
# Priority: +310 ((+300)+10)
# Table: filter_inet
# Chain: inet_filter_output_raw_INTERNET
# Called by: bindings/devices/INTERNET/binding-device-inet-filter-output_raw.table_block
#

    # going to need a registry table just for INTERNET-ZONE
    chain dispatcher_inet_filter_output_raw_INTERNET_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/INTERNET/zones/*/zone-inet-filter-output_raw.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain inet_filter_output_raw_INTERNET {
        jump dispatcher_inet_filter_output_raw_INTERNET_ZONE
    }
