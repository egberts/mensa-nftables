#
# File: subzones-ip-filter-prerouting_raw.table_block
# Path: bindings/devices/INTERNET/zones/
# Title: Include all subzones associated with this device for ip/filter/prerouting
# Family: ip
# Type: filter
# Hook: prerouting
# Device: INTERNET
# Priority: -310 (raw(-300)-10)
# Table: filter_ip
# Chain: ip_filter_prerouting_raw_INTERNET
# Called by: bindings/devices/INTERNET/binding-device-ip-filter-prerouting_raw.table_block
#

    # going to need a registry table just for INTERNET-ZONE
    chain dispatcher_ip_filter_prerouting_raw_INTERNET_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/INTERNET/zones/*/zone-ip-filter-prerouting_raw.chain_block"
    }

    # poor-mans dispatcher, sequential hooking
    chain ip_filter_prerouting_raw_INTERNET {

        jump dispatcher_ip_filter_prerouting_raw_INTERNET_ZONE
    }

