#
# File: subzones-inet-filter-input.table_block
# Path: bindings/devices/INTERNET/zones/
# Title: Include all subzones associated with this device for inet/filter/input
# Family: inet
# Type: filter
# Hook: input
# Device: INTERNET
# Priority: -10 (filter(0)-10)
# Table: filter_inet
# Chain: inet_filter_input_INTERNET
# Called by: bindings/devices/INTERNET/binding-device-inet-filter-input.table_block
#

    # going to need a registry table just for INTERNET-ZONE
    chain dispatcher_inet_filter_input_INTERNET_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/INTERNET/zones/*/zone-inet-filter-input.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain inet_filter_input_INTERNET {
        jump dispatcher_inet_filter_input_INTERNET_ZONE
    }
