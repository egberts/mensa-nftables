#
# File: subzones-netdev-filter-egress.table_block
# Path: bindings/devices/INTERNET/zones/
# Title: Include all subzones associated with this device for netdev/filter/egress
# Family: netdev
# Type: filter
# Hook: egress
# Device: INTERNET
# Priority: -10
# Policy: accept
# Table: filter_netdev
# Chain: netdev_filter_egress_INTERNET
# Called by: bindings/devices/INTERNET/binding-device-bridge-filter-egress.table_block
#

    # going to need a registry table just for INTERNET-ZONE
    chain dispatcher_netdev_filter_egress_INTERNET_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/INTERNET/zones/*/zone-netdev-filter-egress.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain netdev_filter_egress_INTERNET {
        jump dispatcher_netdev_filter_egress_INTERNET_ZONE
    }
