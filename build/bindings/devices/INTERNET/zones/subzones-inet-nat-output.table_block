#
# File: subzones-inet-nat-output.table_block
# Path: bindings/devices/INTERNET/zones/
# Title: Include all subzones associated with this device for inet/nat/output
# Family: inet
# Type: nat
# Hook: output
# Device: INTERNET
# Priority: +10 (filter(0)+10)
# Policy: accept
# Table: nat_inet
# Chain: inet_nat_output_INTERNET
# Called by: bindings/devices/INTERNET/binding-device-inet-nat-output.table_block
#

    # going to need a registry table just for INTERNET-ZONE
    chain dispatcher_inet_nat_output_INTERNET_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/INTERNET/zones/*/zone-inet-nat-output.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain inet_nat_output_INTERNET {
        jump dispatcher_inet_nat_output_INTERNET_ZONE
    }
