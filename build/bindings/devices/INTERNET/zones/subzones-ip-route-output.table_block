#
# File: subzones-ip-route-output.table_block
# Path: bindings/devices/INTERNET/zones/
# Title: Include all subzones associated with this device for ip/route/output
# Family: ip
# Type: route
# Hook: output
# Device: INTERNET
# Priority: +10 (filter(0)+10)
# Policy: accept
# Table: route_ip
# Chain: ip_route_output_INTERNET
# Called by: bindings/devices/INTERNET/binding-device-ip-route-output.table_block
#

    # going to need a registry table just for INTERNET-ZONE
    chain dispatcher_ip_route_output_INTERNET_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/INTERNET/zones/*/zone-ip-route-output.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain ip_route_output_INTERNET {
        jump dispatcher_ip_route_output_INTERNET_ZONE
    }
