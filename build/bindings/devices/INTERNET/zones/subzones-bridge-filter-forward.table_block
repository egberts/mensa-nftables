#
# File: subzones-bridge-filter-forward.table_block
# Path: bindings/devices/INTERNET/zones/
# Title: Include all subzones associated with this device for bridge/filter/forward
# Family: bridge
# Table: filter_bridge
# Chain: bridge_filter_forward_INTERNET
# Type: filter
# Hook: forward
# Device: INTERNET
# Priority: -10 (brnf(0)-10)
# Called by: bindings/devices/INTERNET/binding-device-bridge-filter-forward.table_block
#

    # going to need a registry table just for INTERNET-ZONE
    chain dispatcher_bridge_filter_forward_INTERNET_ZONE {

         # try for parent ZONE (instead of subdir ZONE)
         include "bindings/devices/INTERNET/zones/*/zone-bridge-filter-forward.chain_block"

    }

    # poor-mans dispatcher, sequential hooking
    chain bridge_filter_forward_INTERNET {
        jump dispatcher_bridge_filter_forward_INTERNET_ZONE
    }
