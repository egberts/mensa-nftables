# File:     bindings-device-inet-filter-prerouting_raw.table_block
# Path:     bindings/devices/INTERNET/
# Title:    Create regular chain and register with dispatcher of devices for inet/filter/prerouting base chain
# Family:   inet
# Type:     filter
# Hook:     prerouting
# Device:   INTERNET
# Priority: -310 (raw(-300) - 10)
# Policy:   *
# Table:    filter_inet
# Chain:    filter_inet_prerouting_raw
# Called by: binding/devices/INTERNET/device-inet-filter-prerouting_raw.chain_block
# Description:
#

    # Add/register a Device Interface-to-firewall dispatch registry
    map map_dispatch_inet_filter_prerouting_raw_devices {
        typeof iif : verdict
        elements = {
            # use goto, this is the final descendance
            $INTERNET_INTF_DEV : goto inet_filter_prerouting_raw_INTERNET,
        }
    }

    chain inet_filter_prerouting_raw_INTERNET {
        counter comment "BEGIN inbound INTERNET inet/filter/prerouting_raw"

        # INTERNET: Include rules strictly for all sub-zones/sub-devices having inet/filter/prerouting regular chain
        include "bindings/devices/INTERNET/rules/inet-filter-prerouting_raw/*.rule"
    }
    # Split the chain so that other chains can be created (ie., dispatcher regular chain)


    # INTERNET/ZONE: Include all zones having this device inet/filter/prerouting regular chain
    include "bindings/devices/INTERNET/zones/subzones-inet-filter-prerouting_raw.table_block"

    # ZONE: Include all zones having this device inet/filter/prerouting regular chain
    # include "bindings/zones/zones-inet-filter-prerouting_raw.table_block"

    # (TODO: can we symbolically link to the parent zones/ZONE here, instead of include a duplicate ZONE?)

    # No need for INTERNET/INTERNET/ZONE; simply do a subdevice as INTERNET/ZONE

    chain inet_filter_prerouting_raw_INTERNET {
        counter comment "End inbound INTERNET inet/filter/prerouting_raw"
    }

