# File:     bindings-device-ip-filter-input.table_block
# Path:     bindings/devices/INTERNET/
# Title:    Create regular chain and register with dispatcher of devices for ip/filter/input base chain
# Family:   ip
# Table:    filter_ip
# Chain:    filter_ip_input
# Type:     filter
# Hook:     input
# Device:   INTERNET
# Priority: -110 (dstnat(-100)-10)
# Policy:   DROP
# Called by: binding/devices/INTERNET/device-ip-filter-input.chain_block
# Description:
#

    # Add/register a Device Interface-to-firewall dispatch registry
    map map_dispatch_ip_filter_input_devices {
        typeof iif : verdict
        elements = {
            # use goto, this is the final descendance
            $INTERNET_INTF_DEV : goto ip_filter_input_INTERNET,
        }
    }

    chain ip_filter_input_INTERNET {
        counter comment "BEGIN inbound INTERNET ip/filter/input"

        # INTERNET: Include rules strictly for all sub-zones/sub-devices having ip/filter/input regular chain
        include "bindings/devices/INTERNET/rules/ip-filter-input/*.rule"
    }
    # Split the chain so that other chains can be created (ie., dispatcher regular chain)


    # INTERNET/ZONE: Include all zones having this device ip/filter/input regular chain
    include "bindings/devices/INTERNET/zones/subzones-ip-filter-input.table_block"

    # ZONE: Include all zones having this device ip/filter/input regular chain
    # include "bindings/zones/zones-ip-filter-input.table_block"

    # (TODO: can we symbolically link to the parent zones/ZONE here, instead of include a duplicate ZONE?)

    # No need for INTERNET/INTERNET/ZONE; simply do a subdevice as INTERNET/ZONE

    chain ip_filter_input_INTERNET {
        counter comment "End inbound INTERNET ip/filter/input"
    }

