# File:     bindings-device-bridge-filter-postrouting_srcnat.table_block
# Path:     bindings/devices/INTERNET/
# Title:    Regular chain with dispatcher for bridge/filter/postrouting for srcnat(300) priority
# Family:   bridge
# Type:     filter
# Hook:     postrouting
# Device:   INTERNET
# Priority: *
# Policy:   *
# Table:    filter_bridge
# Chain:    filter_bridge_postrouting_srcnat
# Called by: binding/devices/INTERNET/device-bridge-filter-postrouting_srcnat.chain_block
# Description:
#

    # Add/register a Device Interface-to-firewall dispatch registry
    map map_dispatch_bridge_filter_postrouting_srcnat_devices {
        typeof oif : verdict
        elements = {
            # use goto, this is the final descendance
            $INTERNET_INTF_DEV : goto bridge_filter_postrouting_srcnat_INTERNET,
        }
    }

    chain bridge_filter_postrouting_srcnat_INTERNET {
        counter comment "BEGIN outbound INTERNET bridge/filter/postrouting_srcnat"

        # INTERNET: Include rules strictly for all sub-zones/sub-devices having bridge/filter/postrouting regular chain
        include "bindings/devices/INTERNET/rules/bridge-filter-postrouting_srcnat*/*.rule"
    }
    # Split the chain so that other chains can be created (ie., dispatcher regular chain)


    # INTERNET/ZONE: Include all zones having this device bridge/filter/postrouting regular chain
    include "bindings/devices/INTERNET/zones/subzones-bridge-filter-postrouting_srcnat.table_block"

    # ZONE: Include all zones having this device bridge/filter/postrouting regular chain
    # include "bindings/zones/zones-bridge-filter-postrouting_srcnat.table_block"

    # (TODO: can we symbolically link to the parent zones/ZONE here, instead of include a duplicate ZONE?)

    # No need for INTERNET/INTERNET/ZONE; simply do a subdevice as INTERNET/ZONE

    chain bridge_filter_postrouting_srcnat_INTERNET {
        counter comment "End outbound INTERNET bridge/filter/postrouting_srcnat"
    }

