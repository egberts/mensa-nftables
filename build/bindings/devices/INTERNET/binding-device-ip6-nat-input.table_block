# File:     bindings-device-ip6-nat-input.table_block
# Path:     bindings/devices/INTERNET/
# Title:    Create regular chain and register with dispatcher of devices for ip6/nat/input base chain
# Family:   ip6
# Type:     nat
# Hook:     input
# Device:   INTERNET
# Priority: -10 (filter(0)-10)
# Policy:   accept
# Table:    nat_ip6
# Chain:    nat_ip6_input
# Called by: binding/devices/INTERNET/device-ip6-nat-input.chain_block
# Description:
#

    # Add/register a Device Interface-to-firewall dispatch registry
    map map_dispatch_ip6_nat_input_devices {
        typeof iif : verdict
        elements = {
            # use goto, this is the final descendance
            $INTERNET_INTF_DEV : goto ip6_nat_input_INTERNET,
        }
    }

    chain ip6_nat_input_INTERNET {
        counter comment "BEGIN inbound INTERNET ip6/nat/input"

        # INTERNET: Include rules strictly for all sub-zones/sub-devices having ip6/nat/input regular chain
        include "bindings/devices/INTERNET/rules/ip6-nat-input/*.rule"
    }
    # Split the chain so that other chains can be created (ie., dispatcher regular chain)


    # INTERNET/ZONE: Include all zones having this device ip6/nat/input regular chain
    include "bindings/devices/INTERNET/zones/subzones-ip6-nat-input.table_block"

    # ZONE: Include all zones having this device ip6/nat/input regular chain
    # include "bindings/zones/zones-ip6-nat-input.table_block"

    # (TODO: can we symbolically link to the parent zones/ZONE here, instead of include a duplicate ZONE?)

    # No need for INTERNET/INTERNET/ZONE; simply do a subdevice as INTERNET/ZONE

    chain ip6_nat_input_INTERNET {
        counter comment "End inbound INTERNET ip6/nat/input"
    }

