# File:     bindings-device-ip6-route-output.table_block
# Path:     bindings/devices/INTERNET/
# Title:    Create regular chain and register with dispatcher of devices for ip6/route/output base chain
# Family:   ip6
# Type:     route
# Hook:     output
# Device:   INTERNET
# Priority: +10 (filter(0)+10)
# Policy:   accept
# Table:    route_ip6
# Chain:    route_ip6_output
# Called by: binding/devices/INTERNET/device-ip6-route-output.table_block
# Description:
#

    # Add/register a Device Interface-to-firewall dispatch registry
    map map_dispatch_ip6_route_output_devices {
        typeof oif : verdict
        elements = {
            # use goto, this is the final descendance
            $INTERNET_INTF_DEV : goto ip6_route_output_INTERNET,
        }
    }

    chain ip6_route_output_INTERNET {
        counter comment "BEGIN outbound INTERNET ip6/route/output"

        # INTERNET: Include rules strictly for all sub-zones/sub-devices having ip6/route/output regular chain
        include "bindings/devices/INTERNET/rules/ip6-route-output/*.rule"
    }
    # Split the chain so that other chains can be created (ie., dispatcher regular chain)


    # INTERNET/ZONE: Include all zones having this device ip6/route/output regular chain
    include "bindings/devices/INTERNET/zones/subzones-ip6-route-output.table_block"

    # ZONE: Include all zones having this device ip6/route/output regular chain
    # include "bindings/zones/zones-ip6-route-output.table_block"

    # (TODO: can we symbolically link to the parent zones/ZONE here, instead of include a duplicate ZONE?)

    # No need for INTERNET/INTERNET/ZONE; simply do a subdevice as INTERNET/ZONE

    chain ip6_route_output_INTERNET {
        counter comment "End outbound INTERNET ip6/route/output"
    }

