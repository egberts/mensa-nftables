# File:     bindings-device-bridge-filter-prerouting_dstnat.table_block
# Path:     bindings/devices/INTERNET/
# Title:    Regular chain with dispatcher for bridge/filter/prerouting for dstnat(-300) priority
# Family:   bridge
# Type:     filter
# Hook:     prerouting
# Device:   INTERNET
# Priority: -310 (dstnat(-300)-10)
# Policy:   *
# Table:    filter_bridge
# Chain:    filter_bridge_prerouting_dstnat
# Called by: binding/devices/INTERNET/device-bridge-filter-prerouting_dstnat.chain_block
# Description:
#

    # Add/register a Device Interface-to-firewall dispatch registry
    map map_dispatch_bridge_filter_prerouting_dstnat_devices {
        typeof iif : verdict
        elements = {
            # use goto, this is the final descendance
            $INTERNET_INTF_DEV : goto bridge_filter_prerouting_dstnat_INTERNET,
        }
    }

    chain bridge_filter_prerouting_dstnat_INTERNET {
        counter comment "BEGIN inbound INTERNET bridge/filter/prerouting_dstnat"

        # INTERNET: Include rules strictly for all sub-zones/sub-devices having bridge/filter/prerouting regular chain
        include "bindings/devices/INTERNET/rules/bridge-filter-prerouting_dstnat*/*.rule"
    }
    # Split the chain so that other chains can be created (ie., dispatcher regular chain)


    # INTERNET/ZONE: Include all zones having this device bridge/filter/prerouting regular chain
    include "bindings/devices/INTERNET/zones/subzones-bridge-filter-prerouting_dstnat.table_block"

    # ZONE: Include all zones having this device bridge/filter/prerouting regular chain
    # include "bindings/zones/zones-bridge-filter-prerouting_dstnat.table_block"

    # (TODO: can we symbolically link to the parent zones/ZONE here, instead of include a duplicate ZONE?)

    # No need for INTERNET/INTERNET/ZONE; simply do a subdevice as INTERNET/ZONE

    chain bridge_filter_prerouting_dstnat_INTERNET {
        counter comment "End inbound INTERNET bridge/filter/prerouting_dstnat"
    }

