#
# File:     devices-ip-filter-prerouting_mangle.table_block
# Path:     bindings/devices/
# Title:    Register all devices having ip/filter/prerouting
# Family:   ip
# Type:     filter
# Hook:     prerouting
# Priority: -160 (mangle(-150) - 10)
# Policy:   accept
# Table:    ip_filter
# Chain:    ip_filter_prerouting_mangle
# Called by: hooks/hook-prerouting/base-ip-filter-prerouting_mangle.base_chain
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

    # Pre-declare an interface-to-chain dispatcher for prerouting hook, ip family, filter chain-type.
    map map_dispatch_ip_filter_prerouting_mangle_devices {
        typeof iif : verdict
    }

    # Insert the jump lookup
    chain ip_filter_prerouting_mangle {
        counter comment "device inbound ip/filter/prerouting_mangle"
        iif vmap @map_dispatch_ip_filter_prerouting_mangle_devices
        counter comment "device inbound ip/filter/prerouting_mangle, post dispatch"
    }

    # Register all ip_filter_prerouting_mangle devices
    include "bindings/devices/*/binding-device-ip-filter-prerouting_mangle.table_block"

