#
# File:     devices-inet-filter-postrouting_security.table_block
# Path:     bindings/devices/
# Title:    Register all devices having inet/filter/postrouting
# Family:   inet
# Type:     filter
# Hook:     postrouting
# Priority: +60 (security(50) + 10)
# Policy:   accept
# Table:    inet_filter
# Chain:    inet_filter_postrouting_security
# Called by: hooks/hook-postrouting/base-inet-filter-postrouting_security.base_chain
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

    # Pre-declare an interface-to-chain dispatcher for postrouting hook, inet family, filter chain-type.
    map map_dispatch_inet_filter_postrouting_security_devices {
        typeof oif : verdict
    }
    # Insert the jump lookup
    chain inet_filter_postrouting_security {

        counter comment "device outbound inet/filter/postrouting_security"
        oif vmap @map_dispatch_inet_filter_postrouting_security_devices
        counter comment "device outbound inet/filter/postrouting_security, post dispatch"
    }

    # Register all inet_filter_postrouting_security devices
    include "bindings/devices/*/binding-device-inet-filter-postrouting_security.table_block"

