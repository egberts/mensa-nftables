#
# File:     devices-ip-nat-output.table_block
# Path:     bindings/devices/
# Title:    Register all devices having ip/nat/output
# Family:   ip
# Type:     nat
# Hook:     output
# Priority: +10 (filter(0) + 10)
# Policy:   accept
# Table:    ip_nat
# Chain:    ip_nat_output
# Called by: hooks/hook-output/base-ip-nat-output.base_chain
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#
    # Pre-declare an interface-to-chain dispatcher for output hook, ip family, nat chain-type.
    map map_dispatch_ip_nat_output_devices {
        typeof oif : verdict
    }
    # Insert the jump lookup
    chain ip_nat_output {

        counter comment "device outbound ip/nat/output"
        oif vmap @map_dispatch_ip_nat_output_devices
        counter comment "device outbound ip/nat/output, post dispatch"
    }

    # Register all ip_nat_output devices
    include "bindings/devices/*/binding-device-ip-nat-output.table_block"

