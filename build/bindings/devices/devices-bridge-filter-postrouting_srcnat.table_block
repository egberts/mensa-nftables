#
# File:     devices-bridge-filter-postrouting_srcnat.table_block
# Path:     bindings/devices/
# Title:    Register all devices having bridge/filter/postrouting
# Family:   bridge
# Type:     filter
# Hook:     postrouting
# Priority: +310 (srcnat(+300) + 10)
# Policy:   accept
# Table:    bridge_filter
# Chain:    bridge_filter_postrouting_srcnat
# Called by: hooks/hook-postrouting/base-bridge-filter-postrouting_srcnat.base_chain
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

    # Pre-declare an interface-to-chain dispatcher for postrouting hook, bridge family, filter chain-type.
    map map_dispatch_bridge_filter_postrouting_srcnat_devices {
        typeof oif : verdict
    }
    # Insert the jump lookup
    chain bridge_filter_postrouting_srcnat {

        counter comment "device outbound bridge/filter/postrouting_srcnat"
        oif vmap @map_dispatch_bridge_filter_postrouting_srcnat_devices
        counter comment "device outbound bridge/filter/postrouting_srcnat, post dispatch"
    }

    # Register all bridge_filter_postrouting_srcnat devices
    include "bindings/devices/*/binding-device-bridge-filter-postrouting_srcnat.table_block"

