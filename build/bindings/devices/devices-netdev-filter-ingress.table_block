#
# File:     devices-netdev-filter-ingress.table_block
# Path:     bindings/devices/
# Title:    Register all devices having netdev/filter/ingress
# Family:   netdev
# Table:    netdev_filter
# Chain:    netdev_filter_ingress
# Type:     filter
# Hook:     ingress
# Priority: -10 (over Libvirt/Docker filter(0) and ip/ip6 filter-1)
# Policy:   DROP
# Called by: hooks/hook-ingress/base-netdev-filter-ingress.base_chain
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

    # Pre-declare an interface-to-chain dispatcher for ingress hook, netdev family, filter chain-type.
    map map_dispatch_netdev_filter_ingress_devices {
        typeof iif : verdict
    }

    # Insert the jump lookup
    chain netdev_filter_ingress {
        counter comment "device inbound netdev/filter/ingress"
        iif vmap @map_dispatch_netdev_filter_ingress_devices
        counter comment "device inbound netdev/filter/ingress, post dispatch"
    }

    # Register all netdev_filter_ingress devices
    include "bindings/devices/*/binding-device-netdev-filter-ingress.table_block"

