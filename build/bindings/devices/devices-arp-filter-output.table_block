#
# File:     devices-arp-filter-output.table_block
# Path:     bindings/devices/
# Title:    Register all devices having arp/filter/output
# Family:   arp
# Table:    arp_filter
# Chain:    arp_filter_output
# Type:     filter
# Hook:     output
# Priority: +10 (over Libvirt/Docker filter(0) and ip/ip6 filter-1)
# Policy:   DROP
# Called by: hooks/hook-output/base-arp-filter-output.base_chain
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

    # Pre-declare an interface-to-chain dispatcher for output hook, arp family, filter chain-type.
    map map_dispatch_arp_filter_output_devices {
        typeof oif : verdict
    }
    # Insert the jump lookup
    chain arp_filter_output {

        counter comment "device outbound arp/filter/output"
        oif vmap @map_dispatch_arp_filter_output_devices
        counter comment "device outbound arp/filter/output, post dispatch"
    }

    # Register all arp_filter_output devices
    include "bindings/devices/*/binding-device-arp-filter-output.table_block"

