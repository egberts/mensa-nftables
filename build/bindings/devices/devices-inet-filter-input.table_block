#
# File:     devices-inet-filter-input.table_block
# Path:     bindings/devices/
# Title:    Register all devices having inet/filter/input
# Family:   inet
# Type:     filter
# Hook:     input
# Priority: -10 (filter(0) - 10)
# Policy:   DROP
# Table:    inet_filter
# Chain:    inet_filter_input
# Called by: hooks/hook-input/base-inet-filter-input.base_chain
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

    # Pre-declare an interface-to-chain dispatcher for input hook, inet family, filter chain-type.
    map map_dispatch_inet_filter_input_devices {
        typeof iif : verdict
    }

    # Insert the jump lookup
    chain inet_filter_input {
        counter comment "device inbound inet/filter/input"
        iif vmap @map_dispatch_inet_filter_input_devices
        counter comment "device inbound inet/filter/input, post dispatch"
    }

    # Register all inet_filter_input devices
    include "bindings/devices/*/binding-device-inet-filter-input.table_block"

