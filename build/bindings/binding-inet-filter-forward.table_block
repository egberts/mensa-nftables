    error "I got here for ARP retest"

    include "bindings/devices/devices-inet-filter-forward*.table_block"

    # Declare an interface-to-chain dispatcher for forward hook, inet family, filter chain-type.
    map map_dispatch_inet_filter_forward_interface {
        typeof iif : verdict
    }

    chain inet_filter_forward {

