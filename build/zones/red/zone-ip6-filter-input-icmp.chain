# File:     zone-ip6-filter-input-icmp.chain
# Path:     zones/red/
# Title:    Rules for ICMP packets in red zone with type filter and hook input
# Family:   ip6
# Table:    *
# Chain:    ip6_filter_input_red_icmpv4
# Type:     filter
# Hook:     input
# Priority: filter(0)
# Policy:   DROP
# Zone:     red
# Called by: zones/zone-ip6-filter-input-red.chain
# Description:
#

    # Register a protocol-to-firewall dispatch registry
    map map_dispatch_ip6_filter_input_red_protocol {
        type ip6_proto : verdict;
        elements = {
            icmp : goto ip6_filter_input_red_icmpv4,
        }
    }

    chain ip6_filter_input_red_icmpv4 {

        counter

        include "zones/red/rules/ip6-filter-input-icmp/*.rule"

        ip daddr 127.0.0.0/8 counter log prefix "DROP invalid loopback: " drop

        # Catch-all
        log prefix "DROP red/ip6/filter/input/icmp: " counter drop
    }

