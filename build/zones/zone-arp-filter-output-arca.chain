# File:     zone-arp-filter-output-arca.chain
# Path:     *
# Title:    Regular chain?
# Family:   arp
# Table:    *
# Chain:    arp_filter_output_arca
# Type:     filter
# Hook:     output
# Priority: filter(0)+10
# Policy:   *
# Zone:     arca
# Called by: hooks/hook-output/base-arp-filter-output.chain
# Description: Stateful inbound host firewall
#

    chain arp_filter_output_arca {

        counter comment "arp/filter/output/arca"
    }

    include "build/zones/arca/arp-filter-output-arca.chain"  # no wildcard

    chain arp_filter_output_arca {

        # Log and count denied traffic.
        counter log prefix "DROP arp/filter/output/arca unknown in arca zone: " drop
    }
