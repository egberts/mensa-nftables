# File:     zone-arp-filter-input-loopback.chain
# Path:     *
# Title:    Regular chain?
# Family:   arp
# Table:    *
# Chain:    arp_filter_input_loopback
# Type:     filter
# Hook:     input
# Priority: filter(0)
# Policy:   *
# Zone:     loopback
# Called by: hooks/hook-input/base-arp-filter-input.chain
# Description: Stateful inbound host firewall
#

    # no layer-7 protocol-specific dispatcher needed in ARP family
    chain arp_filter_input_loopback {

        counter comment "arp/filter/input/loopback"
    }

    include "build/zones/loopback/arp-filter-input-loopback.chain"  # no wildcard

    chain arp_filter_input_loopback {
        # Log and count denied traffic.
        counter log prefix "DROP arp/filter/input/loopback unknown packet in loopback zone: " drop
    }
