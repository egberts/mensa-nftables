# File:     zone-arp-filter-input-red.chain
# Path:     *
# Title:    Regular chain?
# Family:   arp
# Table:    *
# Chain:    arp_filter_input_red
# Type:     filter
# Hook:     input
# Priority: filter(0)
# Policy:   *
# Zone:     red
# Called by: hooks/hook-input/base-arp-filter-input.chain
# Description: Stateful inbound host firewall
#

    # no layer-7 protocol-specific dispatcher needed in ARP family
    chain arp_filter_input_red {

        counter comment "arp/filter/input/red"
    }

    include "build/zones/red/arp-filter-input-red.chain"  # no wildcard

    chain arp_filter_input_red {
        # Log and count denied traffic.
        counter log prefix "DROP arp/filter/input/red unknown packet in red zone: " drop
    }
