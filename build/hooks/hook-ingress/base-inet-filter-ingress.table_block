# File:     base-inet-filter-ingress.table_block
# Path:     hooks/hook-ingress/
# Title:    ALL ingress hooks for inet family and filter chain-type
# Family:   inet
# Table:    filter_inet
# Chain:    *
# Type:     filter
# Hook:     ingress
# Priority: *
# Policy:   *
# Called by: types/filter-ingress.table
# Description:
#     Scanning across all zones, picking up ingress/egress chain candidates
#
# The device name must identify an existing network interface.
#
# Requires Linux kernel 5.16 or later for inet egress.
#
# No table here yet, (still have 'ingress' and 'egress' to go)
# No base chain here yet, that's zone-specific (by chain 'device' interface)
#

    # no declarative base chain here, chain devices are used in 'ingress' and done later

    # zone-in-device is done via 'devices/DEVICE/' subdirectories under this bindings/zones/ZONE/
    include "bindings/devices/*/binding-device-inet-filter-ingress.base_chain"  # wildcard is in device name

    # zones-in-zone are done via 'zones/ZONE/' subdirectories again under this bindings/zones/ZONE/
    # include "bindings/zones/*/binding-zone-inet-filter-ingress.chain"  # wildcard is in zone name

    # elsewhere,
    # devices-in-zone are done via 'zones/ZONE/' subdirectories under bindings/devices/DEVICE/
