# File:     base-ip-nat-postrouting.chain
# Path:     hooks/hook-prerouting/
# Title:    Base chain for the postrouting hook (ip family, nat type)
# Family:   ip
# Table:    *
# Chain:    ip_nat_postrouting_security
# Type:     nat
# Hook:     postrouting
# Priority: various
# Policy:   accept
# Called by: types/type-nat/nat-ip.nft
# Description:
#

    # ip/nat/postrouting cannot use priority less or equal to -300

    chain ip_nat_postrouting_mangle {
        type nat hook postrouting priority -150;
        policy accept;

    }

    chain ip_nat_postrouting_dstnat {
        type nat hook postrouting priority -100;
        policy accept;

    }
