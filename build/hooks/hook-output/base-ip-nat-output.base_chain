# File:     base-ip-nat-output.base_chain
# Path:     hooks/hook-output/
# Title:    Base chain for the output hook (ip family, nat type)
# Family:   ip
# Type:     nat
# Hook:     output
# Priority: -10 (filter(0)-10)
# Policy:   accept
# Table:    ip_nat
# Chain:    ip_nat_output
# Called by: types/nat-ip.table
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

    # Pre-declare table before map/vmap
    chain ip_nat_output {
        type filter hook output priority -10; policy accept;
        counter comment "inbound ip/nat/output"
    }

    # creates a registry for zone-based dispatcher (will touch ip_nat_output)
    #include "bindings/zones/zones-ip-nat-output*.table_block"

    # Declare an interface-to-chain dispatcher for output hook, ip family, filter chain-type. (will touch ip_nat_output)
    include "bindings/devices/devices-ip-nat-output*.table_block"


    chain ip_nat_output {
        counter comment "inbound ip/nat/output"
    }
