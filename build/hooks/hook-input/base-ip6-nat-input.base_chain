# File:     base-ip6-nat-input.base_chain
# Path:     hooks/hook-input/
# Title:    Base chain for the input hook (ip6 family, nat type)
# Family:   ip6
# Table:    ip6_nat
# Chain:    ip6_nat_input
# Type:     nat
# Hook:     input
# Priority: -10 (filter(0) - 10)
# Policy:   accept
# Called by: types/nat-ip6.table
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

    # Pre-declare table before map/vmap
    chain ip6_nat_input {
        type nat hook input priority -10; policy accept;

        counter comment "inbound ip6/nat/input"
    }

    # creates a registry for zone-based dispatcher (will touch ip6_nat_input)
    #include "bindings/zones/zones-ip6-nat-input*.table_block"

    # Declare an interface-to-chain dispatcher for input hook, ip6 family, nat chain-type. (will touch ip6_nat_input)
    include "bindings/devices/devices-ip6-nat-input*.table_block"

    chain ip6_nat_input {

        counter comment "inbound ip6/nat/input"
    }

