# File:     base-inet-filter-input.chain
# Path:     hooks/hook-input/
# Title:    Scan all zones for inet-filter-input chains
# Family:   inet
# Table:    *
# Chain:    inet_filter_input
# Type:     filter
# Hook:     input
# Priority: -10 (filter(0) - 10, before ip-input(-5) and ip6-input(-5))
# Policy:   DROP
# Called by: types/type-filter/filter-inet.nft
# Description:
#

    # Declare an interface-to-chain dispatcher for input hook
    map map_dispatch_inet_filter_input_interface {
        typeof iif : verdict
    }
    chain inet_filter_input {
        type filter hook input priority -10; policy drop;

        iif vmap @map_dispatch_inet_filter_input_interface
    }

    # Selectively load our input protocol regular chains
    # registers with 'map_dispatch_inet_filter_input_interface' dispatch mapper)
    include "build/zones/*/zone-inet-filter-input.chain";

    # Post-interface input process
    chain inet_filter_input {
        counter log prefix "DROP inet/filter/input: " drop comment "unidentified interface filter input"
    }
