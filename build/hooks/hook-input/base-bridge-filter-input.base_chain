# File:     base-bridge-filter-input.base_chain
# Path:     hooks/hook-input/
# Title:    Base chain for the input hook (bridge family, filter type)
# Family:   bridge
# Table:    *
# Chain:    bridge_filter_input
# Type:     filter
# Hook:     input
# Priority: -210 (filter(-200) - 10)
# Policy:   DROP
# Called by: types/filter-bridge.table
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

    # Pre-declare table before map/vmap
    chain bridge_filter_input {
        type filter hook input priority -210; policy accept;
        counter comment "inbound bridge/filter/input"
    }

    # creates a registry for zone-based dispatcher (will touch bridge_filter_input)
    #include "bindings/zones/zones-bridge-filter-input*.table_block"

    # Declare an interface-to-chain dispatcher for input hook, bridge family, filter chain-type. (will touch bridge_filter_input)
    include "bindings/devices/devices-bridge-filter-input*.table_block"


    chain bridge_filter_input {
        counter comment "inbound bridge/filter/input"
        # TODO Add 'limit 5/s' here
        # log prefix "DROP bridge/filter/input unknown ZONE: " drop
    }
