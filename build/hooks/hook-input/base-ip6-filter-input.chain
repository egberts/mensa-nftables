# File:     base-ip6-filter-input.chain
# Path:     hooks/hook-input/
# Title:    Base chain for the input hook (ip6 family, filter type)
# Family:   ip6
# Table:    *
# Chain:    ip6_filter_input
# Type:     filter
# Hook:     input
# Priority: -5 (filter(0) - 5, after inet-input(-10), same as ip-input(-5))
# Policy:   DROP
# Called by: types/type-filter/filter-ip6.nft
# Description: Stateful IPv6 inbound host firewall
#
# The input hook sees IPv6 packets destined for the local system.
#
# Unlike forward, input handles packets delivered to the host
# rather than packets routed through the host.
#
# Priority filter (numeric 0) is the conventional choice.
#
# Control                         Security purpose
# Loopback acceptance             Preserves local loopback traffic
# Invalid state rejection         Rejects invalid connection-tracking traffic
# Established/related             Permits tracked return and related traffic
# ICMPv6 error handling            Supports IPv6 network diagnostics and PMTU
# Neighbor Discovery              Supports IPv6 address resolution
# Router Advertisements           Supports IPv6 autoconfiguration
# DHCPv6 responses                Permits DHCPv6 client responses
# Logging and counters             Provides an audit trail
#
# This chain enforces inbound IPv6 host traffic.
# Use ip6/filter/forward for traffic routed through the host.
#
# IMPORTANT:
# Do not indiscriminately block ICMPv6. IPv6 depends on ICMPv6
# for Neighbor Discovery, Router Discovery, and Path MTU Discovery.
#
# Examples of uses for ip6 / filter / input include:
# - Host access control:
#     Restrict inbound connections to explicitly authorized services.
# - SSH access:
#     Permit TCP port 22 from authorized administration networks.
# - ICMPv6 handling:
#     Permit essential error messages and optionally echo requests.
# - Neighbor Discovery:
#     Permit Neighbor Solicitation and Neighbor Advertisement.
# - Router Discovery:
#     Permit Router Advertisements when using SLAAC.
# - DHCPv6:
#     Permit DHCPv6 responses when operating as a DHCPv6 client.
#


    # dispatch registry for interfaces to regular chain
    map map_dispatch_ip6_filter_input_interface {
        typeof iif : verdict
    }
    chain ip6_filter_input {
        type filter hook input priority -5; policy drop;

        # Reject invalid connection states.
        ct state invalid counter drop

        # Accept loopback traffic.
        iifname "lo" counter accept

        # Accept established and related connections.
        ct state { established, related } counter accept

        # Permit essential IPv6 ICMP error messages.
        icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem } counter accept

        # Permit IPv6 Neighbor Discovery.
        icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert } ip6 hoplimit 255 counter accept

        # Permit Router Advertisements (if using SLAAC).
        icmpv6 type nd-router-advert ip6 hoplimit 255 counter accept

        # Permit Router Solicitations (if acting as an IPv6 router).
        icmpv6 type nd-router-solicit ip6 hoplimit 255 counter accept

        # Permit DHCPv6 client responses.
        udp sport 547 udp dport 546 counter accept

        # Optional: permit inbound IPv6 echo requests.
        # icmpv6 type echo-request counter accept

        # Explicitly authorized inbound services go here.
        # Example: tcp dport 22 ct state new counter accept

        # A cool lookup to jump into a protocol-specific regular chain
        # dispatch map built by including/excluding chain-ip6-filter-*.nft files
        iif vmap @map_dispatch_ip6_filter_input_interface
    }

    # Selectively load our input protocol regular chains
    # registers with 'map_dispatch_ip6_filter_input_interface' dispatch mapper)
    include "build/zones/zone-ip6-filter-input-*.nft";

    chain ip6_filter_input {

        # Log and count denied traffic.
        limit rate 5/second log prefix "DROP ip6-filter-input: "
        counter drop comment "ip6-filter-input DROP"
    }
