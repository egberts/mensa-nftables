#!/usr/sbin/nft -f
#
# File:     filter-inet.nft
# Path:     types/
# Title:    Valid hook for inet family and filter chain-type
# Family:   inet
# Table:    inet_filter
# Chain:    *
# Type:     filter
# Hook:     *
# Priority: N/A
# Policy:   *
# Called by: nftables.nft
# Description:
#
# Single-indented for base-chain and regular-chain
# Double-indented for rules-only
#

table inet inet_filter {
    include "build/hooks/hook-ingress/base-inet-filter-ingress*.chain";
    include "build/hooks/hook-prerouting/base-inet-filter-prerouting*.chain";
    include "build/hooks/hook-input/base-inet-filter-input*.chain";
    include "build/hooks/hook-forward/base-inet-filter-forward*.chain";
    include "build/hooks/hook-output/base-inet-filter-output*.chain";
    include "build/hooks/hook-postrouting/base-inet-filter-postrouting*.chain";
}

